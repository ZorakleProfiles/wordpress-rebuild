<!-- Vertical portrait layout with safer text padding and non-colliding legend -->
<svg
  viewBox="0 0 520 390"
  class="w-full h-auto"
  role="img"
  aria-label="At each lifecycle stage, aligned decisions compound into greater franchise system value while disconnected decisions erode it"
>
  <defs>
    <linearGradient id="bar1" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#09cc9c"/><stop offset="100%" stop-color="#0abf91"/></linearGradient>
    <linearGradient id="bar2" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#18c4a8"/><stop offset="100%" stop-color="#3dafbe"/></linearGradient>
    <linearGradient id="bar3" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#3296cc"/><stop offset="100%" stop-color="#3480c6"/></linearGradient>
    <linearGradient id="bar4" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#3d7ed0"/><stop offset="100%" stop-color="#3971c1"/></linearGradient>
  </defs>

  <!-- Stage 1: Attract -->
  <text x="20" y="22" fill="#9ca3af" font-size="10" font-weight="700" letter-spacing="1.3">ATTRACT</text>
  <rect x="20" y="30" width="250" height="22" fill="url(#bar1)" rx="4"/>
  <rect x="20" y="58" width="250" height="14" fill="#e2e5ea" rx="4"/>

  <!-- Stage 2: Award -->
  <text x="20" y="102" fill="#9ca3af" font-size="10" font-weight="700" letter-spacing="1.3">AWARD</text>
  <rect x="20" y="110" width="345" height="22" fill="url(#bar2)" rx="4"/>
  <rect x="20" y="138" width="160" height="14" fill="#e2e5ea" rx="4"/>

  <!-- Stage 3: Enable -->
  <text x="20" y="182" fill="#9ca3af" font-size="10" font-weight="700" letter-spacing="1.3">ENABLE</text>
  <rect x="20" y="190" width="425" height="22" fill="url(#bar3)" rx="4"/>
  <rect x="20" y="218" width="92" height="14" fill="#e2e5ea" rx="4"/>

  <!-- Stage 4: Execute -->
  <text x="20" y="262" fill="#9ca3af" font-size="10" font-weight="700" letter-spacing="1.3">EXECUTE</text>
  <rect x="20" y="270" width="460" height="22" fill="url(#bar4)" rx="4"/>
  <rect x="20" y="298" width="28" height="14" fill="#e2e5ea" rx="4"/>

  <!-- Separator -->
  <line x1="20" y1="334" x2="480" y2="334" stroke="#f0f2f5" stroke-width="1"/>


</svg>
