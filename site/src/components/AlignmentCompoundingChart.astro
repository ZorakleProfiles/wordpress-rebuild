<!-- Vertical portrait layout: each stage is a row with aligned vs. disconnected horizontal bars -->
<svg
  viewBox="0 0 480 355"
  class="w-full h-auto"
  role="img"
  aria-label="At each lifecycle stage, aligned decisions compound into greater franchise system value while disconnected decisions erode it"
>
  <defs>
    <linearGradient id="bar1" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#09cc9c"/><stop offset="100%" stop-color="#0abf91"/></linearGradient>
    <linearGradient id="bar2" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#18c4a8"/><stop offset="100%" stop-color="#3dafbe"/></linearGradient>
    <linearGradient id="bar3" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#3296cc"/><stop offset="100%" stop-color="#3480c6"/></linearGradient>
    <linearGradient id="bar4" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#3d7ed0"/><stop offset="100%" stop-color="#3971c1"/></linearGradient>
  </defs>

  <!-- ── Stage 1: Attract ── -->
  <text x="0" y="12" fill="#9ca3af" font-size="10" font-weight="700" letter-spacing="1.5">ATTRACT</text>
  <rect x="0" y="20" width="240" height="22" fill="url(#bar1)" rx="4"/>
  <rect x="0" y="48" width="240" height="14" fill="#e2e5ea" rx="4"/>

  <!-- ── Stage 2: Award ── -->
  <text x="0" y="94" fill="#9ca3af" font-size="10" font-weight="700" letter-spacing="1.5">AWARD</text>
  <rect x="0" y="102" width="335" height="22" fill="url(#bar2)" rx="4"/>
  <rect x="0" y="130" width="152" height="14" fill="#e2e5ea" rx="4"/>

  <!-- ── Stage 3: Enable ── -->
  <text x="0" y="176" fill="#9ca3af" font-size="10" font-weight="700" letter-spacing="1.5">ENABLE</text>
  <rect x="0" y="184" width="415" height="22" fill="url(#bar3)" rx="4"/>
  <rect x="0" y="212" width="84" height="14" fill="#e2e5ea" rx="4"/>

  <!-- ── Stage 4: Execute ── -->
  <text x="0" y="258" fill="#9ca3af" font-size="10" font-weight="700" letter-spacing="1.5">EXECUTE</text>
  <rect x="0" y="266" width="455" height="22" fill="url(#bar4)" rx="4"/>
  <rect x="0" y="294" width="24"  height="14" fill="#e2e5ea" rx="4"/>

  <!-- Separator -->
  <line x1="0" y1="326" x2="455" y2="326" stroke="#f0f2f5" stroke-width="1"/>

  <!-- Legend -->
  <rect x="0"   y="336" width="10" height="10" fill="#09cc9c" rx="2"/>
  <text x="16"  y="345" fill="#9ca3af" font-size="11" font-weight="600">Aligned decisions</text>
  <rect x="160" y="336" width="10" height="10" fill="#e2e5ea" rx="2"/>
  <text x="176" y="345" fill="#9ca3af" font-size="11" font-weight="600">Disconnected decisions</text>
</svg>
