---
interface Props {
  variant?: "home" | "franchisors";
}

const { variant = "home" } = Astro.props;
const isFranchisorPage = variant === "franchisors";

const homeLifecycleSteps = [
  { label: "Recruit", detail: "Attract people aligned with your brand.", icon: "recruit", color: "#0a8a67", background: "#dcf7ee" },
  { label: "Select", detail: "Identify right-fit candidates with greater confidence.", icon: "select", color: "#0868c9", background: "#e5f3fc" },
  { label: "Onboard", detail: "Understand how each franchisee learns and operates.", icon: "onboard", color: "#f06a09", background: "#fff1df" },
  { label: "Coach", detail: "Tailor communication, support, and development.", icon: "coach", color: "#4820be", background: "#eee9ff" },
  { label: "Strengthen", detail: "Improve performance, relationships, and system health.", icon: "strengthen", color: "#0a8a67", background: "#e6f7e9" }
];

const franchisorLifecycleSteps = [
  { label: "Recruit", detail: "Focus development efforts on prospects whose values, motivations, and goals align with your brand.", icon: "recruit", color: "#0a8a67", background: "#dcf7ee" },
  { label: "Select", detail: "Compare candidates against your success profile and make more consistent, evidence-informed award decisions.", icon: "select", color: "#0868c9", background: "#e5f3fc" },
  { label: "Onboard", detail: "Give new franchisees a more relevant start by understanding how they learn, communicate, and put plans into action.", icon: "onboard", color: "#f06a09", background: "#fff1df" },
  { label: "Coach", detail: "Equip field teams to adapt communication and support to the needs of each franchisee—not a one-size-fits-all model.", icon: "coach", color: "#4820be", background: "#eee9ff" },
  { label: "Strengthen", detail: "Turn individual insight into stronger performance, healthier relationships, better validation, and systemwide growth.", icon: "strengthen", color: "#0a8a67", background: "#e6f7e9" }
];

const lifecycleSteps = isFranchisorPage ? franchisorLifecycleSteps : homeLifecycleSteps;
---

<section class="home-section overflow-hidden bg-[#f4fbfa]" aria-labelledby={isFranchisorPage ? "franchisor-lifecycle-title" : "lifecycle-title"}>
  <div class="section-shell">
    <div class="text-center">
      {isFranchisorPage && <p class="section-eyebrow">Beyond the award decision</p>}
      <h2 id={isFranchisorPage ? "franchisor-lifecycle-title" : "lifecycle-title"} class:list={["section-title", "!mt-0", { "md:!mt-3": isFranchisorPage }]}>Alignment Intelligence at Every Stage</h2>
      <p class="mx-auto mt-4 max-w-4xl text-[#56586a] md:text-lg">
        {isFranchisorPage
          ? "Candidate fit is only the beginning. Zorakle gives your development, training, and operations teams a shared understanding of each franchisee—so the insight behind a better award continues creating value throughout the relationship."
          : "From the first conversation to long-term growth, Zorakle helps you attract, select, onboard, coach, and strengthen franchisees who are built to succeed."}
      </p>
    </div>

    <div class:list={["lifecycle-flow mt-10 md:mt-12", isFranchisorPage ? "lifecycle-flow--roomy" : "lifecycle-flow--standard"]}>
      {lifecycleSteps.map((step, index) => (
        <Fragment>
          <article class="text-center">
            <div
              class="mx-auto flex h-36 w-36 flex-col items-center justify-center rounded-full"
              style={`color:${step.color};background:${step.background}`}
            >
              <span class="text-3xl font-bold leading-none">{String(index + 1).padStart(2, "0")}</span>

              {step.icon === "recruit" && (
                <svg class="mt-3 h-12 w-16" viewBox="0 0 64 48" fill="currentColor" aria-hidden="true">
                  <circle cx="32" cy="13" r="9" opacity=".95"/><circle cx="14" cy="18" r="7" opacity=".72"/><circle cx="50" cy="18" r="7" opacity=".72"/>
                  <path d="M17 43c0-11 6-18 15-18s15 7 15 18H17Z"/><path d="M1 43c0-9 5-15 13-15 4 0 7 2 9 4-3 3-5 7-6 11H1ZM47 43c-1-4-3-8-6-11 2-2 5-4 9-4 8 0 13 6 13 15H47Z" opacity=".72"/>
                </svg>
              )}
              {step.icon === "select" && (
                <svg class="mt-3 h-12 w-12" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" aria-hidden="true">
                  <circle cx="20" cy="20" r="14"/><path d="m31 31 13 13" stroke-linecap="round"/>
                </svg>
              )}
              {step.icon === "onboard" && (
                <svg class="mt-3 h-12 w-14" viewBox="0 0 56 48" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                  <rect x="4" y="2" width="35" height="42" rx="4"/><path d="M13 13h3m5 0h10M13 22h3m5 0h10M13 31h3m5 0h8" stroke-linecap="round"/>
                  <circle cx="42" cy="35" r="11" fill="currentColor" stroke="none"/><path d="m37 35 3 3 7-8" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {step.icon === "coach" && (
                <svg class="mt-3 h-12 w-15" viewBox="0 0 60 48" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                  <circle cx="20" cy="12" r="8"/><path d="M5 42c1-11 6-17 15-17 5 0 9 2 12 6" stroke-linecap="round"/>
                  <path d="M35 42V31h6v11m4 0V24h6v18m4 0V17h4v25" stroke-linejoin="round"/>
                </svg>
              )}
              {step.icon === "strengthen" && (
                <svg class="mt-3 h-12 w-14" viewBox="0 0 56 48" fill="currentColor" aria-hidden="true">
                  <rect x="5" y="31" width="10" height="13" rx="1" opacity=".55"/><rect x="22" y="23" width="10" height="21" rx="1" opacity=".75"/><rect x="39" y="12" width="10" height="32" rx="1"/>
                  <path d="M7 24 19 13l7 5L42 3v8h4V0H35v4h5L25 15l-7-5L4 22l3 2Z"/>
                </svg>
              )}
            </div>
            <h3 class="mt-4 text-2xl font-bold text-[#111827]">{step.label}</h3>
            <p class:list={["mx-auto mt-2 text-base leading-snug text-[#5f6d84]", isFranchisorPage ? "max-w-[19rem] md:text-base" : "max-w-[14rem] md:text-lg"]}>{step.detail}</p>
          </article>

          {index < lifecycleSteps.length - 1 && (
            <svg class="lifecycle-arrow" viewBox="0 0 72 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M1 12h66M59 4l8 8-8 8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
        </Fragment>
      ))}
    </div>

    <div class="mx-auto mt-6 max-w-4xl border-t border-[#cdd5da] pt-4">
      <p class="text-center text-xs font-medium uppercase tracking-[0.35em] text-[#8a97aa]">People aligned. Franchises stronger.</p>
      {isFranchisorPage && (
        <p class="mx-auto mt-4 max-w-3xl text-center text-sm leading-relaxed text-[#5f6d84] md:text-base">
          One source of alignment intelligence helps every team make better people decisions, deliver more personalized support, and build a franchise system where the right people can thrive.
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .lifecycle-flow {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }

  .lifecycle-arrow {
    width: 4rem;
    color: #8391a6;
    transform: rotate(90deg);
  }

  @media (min-width: 1024px) {
    .lifecycle-flow--standard {
      grid-template-columns: minmax(0, 1fr) 4rem minmax(0, 1fr) 4rem minmax(0, 1fr) 4rem minmax(0, 1fr) 4rem minmax(0, 1fr);
      align-items: start;
      gap: 0.6rem;
    }

    .lifecycle-flow--standard .lifecycle-arrow {
      align-self: start;
      margin-top: 4.4rem;
      transform: none;
    }
  }

  /* Franchisor copy runs longer, so the horizontal five-across layout waits
     for a wider viewport than the homepage's to give each step room. */
  @media (min-width: 1280px) {
    .lifecycle-flow--roomy {
      grid-template-columns: minmax(0, 1fr) 4rem minmax(0, 1fr) 4rem minmax(0, 1fr) 4rem minmax(0, 1fr) 4rem minmax(0, 1fr);
      align-items: start;
      gap: 0.6rem;
    }

    .lifecycle-flow--roomy .lifecycle-arrow {
      align-self: start;
      margin-top: 4.4rem;
      transform: none;
    }
  }
</style>
