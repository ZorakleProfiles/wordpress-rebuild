---
const lifecycleSteps = [
  {
    label: "Select",
    detail: "Identify candidates whose values, skills, and operating style align with your system."
  },
  {
    label: "Onboard",
    detail: "Tailor training and communication to how each franchisee learns and takes action."
  },
  {
    label: "Coach",
    detail: "Understand the behavioral patterns behind performance gaps and focus support."
  },
  {
    label: "Strengthen",
    detail: "Use system-wide insight to improve performance, relationships, and sustainable growth."
  }
];
---

<section class="bg-white py-20 md:py-28 overflow-hidden">
  <div class="section-shell">

    <!-- Lifecycle step flow -->
    <p class="section-eyebrow">Across the Franchise Lifecycle</p>
    <h2 class="section-title">One Profile. Insight at Every Stage.</h2>
    <p class="section-copy max-w-3xl">
      Zorakle turns alignment data into practical insight—from the first candidate conversation through long-term franchisee development.
    </p>

    <div class="relative mt-14 md:mt-16">
      <div
        class="absolute left-[12.5%] right-[12.5%] top-7 hidden h-px bg-[#d1d4dd] md:block"
        aria-hidden="true"
      ></div>
      <div class="grid gap-12 md:grid-cols-4 md:gap-6">
        {lifecycleSteps.map((step, index) => (
          <div class="flex flex-col items-center text-center">
            <span class="relative z-10 flex h-14 w-14 items-center justify-center rounded-full bg-[#09cc9c] font-display text-lg font-bold text-white">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-5 font-display text-xl font-bold md:text-2xl" style="color:#a8420c">{step.label}</h3>
            <p class="mt-2 max-w-[16rem] leading-relaxed text-[#3b3e47]">{step.detail}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
