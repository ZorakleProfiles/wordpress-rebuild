---
const painPoints = [
  {
    title: "Support becomes firefighting",
    description:
      "Recurring problems, inconsistent execution, and resistance to proven processes keep your team focused on correcting issues instead of helping franchisees grow."
  },
  {
    title: "Misalignment creates friction",
    description:
      "When a franchisee's skills, motivations, or working style do not fit the model, coaching becomes conflict, communication breaks down, and hard work does not translate into performance."
  },
  {
    title: "Systemwide growth suffers",
    description:
      "Underperformance creates inconsistent customer experiences and weakens validation, referrals, retention, and confidence in awarding new locations."
  }
];
---

<section class="bg-[#f3f3f3] py-20 md:py-28">
  <div class="section-shell">
    <div class="overflow-hidden bg-white lg:grid lg:grid-cols-[minmax(0,0.86fr)_minmax(0,1.14fr)]">
      <div class="relative flex flex-col justify-between bg-[#f3f3f3] px-7 py-10  md:px-12 md:py-14 lg:min-h-[420px] lg:px-14 lg:py-16">
        <div>
          <p class="section-eyebrow">When Alignment Is Off</p>
          <h2 class="section-title">Misalignment often disguises itself as something else.</h2>
          <p class="section-copy max-w-3xl">
            A training problem. A difficult franchisee. An isolated performance issue. But beneath the symptoms may be a deeper mismatch between the franchisee and the system.
          </p>
        </div>
      </div>

      <div class="px-7 py-4 md:px-12 lg:px-14 lg:py-8">
        {painPoints.map((painPoint, index) => (
          <article class="grid gap-4 border-b border-[#d9dce2] py-7 last:border-b-0 md:grid-cols-[3rem_minmax(0,1fr)] md:gap-6 md:py-8">
            <span class="font-display text-sm font-bold tracking-[0.12em] text-[#a8420c]">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="font-display text-2xl font-bold leading-tight text-[#22252a] md:text-[1.7rem]">
                {painPoint.title}
              </h3>
              <p class="mt-3 max-w-xl leading-relaxed text-[#656a73] md:text-base">
                {painPoint.description}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
    <div class="mt-8">
      <a class="btn-primary" href="/pricing">Get Started Now</a>
    </div>
  </div>
</section>
