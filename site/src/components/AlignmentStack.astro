---
const alignmentLayers = [
  {
    title: "Values Alignment",
    body: "Values shape what people pursue, prioritize, and expect from business ownership. When motivations and definitions of success align, commitment is more likely to endure."
  },
  {
    title: "Culture Alignment",
    body: "Culture determines how decisions are made, expectations are communicated, and people work together. The right fit makes communication easier and reduces friction."
  },
  {
    title: "Systems Alignment",
    body: "The right franchisee understands the brand’s current level of structure, support, and autonomy—and can succeed within the system as it exists today."
  },
  {
    title: "Skills Alignment",
    body: "Skills alignment reveals whether a candidate is equipped to lead, sell, manage, and operate effectively within the specific franchise model."
  },
  {
    title: "Execution Alignment",
    body: "Execution alignment reveals how someone responds to pressure, uncertainty, and competing demands—and whether potential will translate into consistent performance."
  }
];
---

<section class="overflow-hidden bg-[#f4f8f8] py-14 md:py-18">
  <div class="section-shell">
    <h2 class="section-title !mt-0 text-center">
      The Franchise Alignment Stack™
    </h2>
    <p class="mx-auto mt-4 max-w-5xl text-center text-base leading-relaxed text-[#5f6673] md:text-lg">
      Five measurable dimensions reveal how well a candidate is equipped to succeed within your franchise system.
    </p>

    <div class="alignment-stack-grid mt-10 md:mt-12">
      {alignmentLayers.map((layer, index) => (
        <article class="border-t-[3px] border-[#18b9a8] pt-5">
          <h3 class="text-[1.35rem] font-bold leading-tight text-[#111827] md:text-[1.5rem] font-display">
            {layer.title}
          </h3>
          <p class="mt-4 text-base leading-[1.55] text-[#5f6673] md:text-lg">{layer.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .alignment-stack-grid {
    display: grid;
    gap: 2.25rem;
  }

  @media (min-width: 768px) {
    .alignment-stack-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
      row-gap: 2.75rem;
    }

    .alignment-stack-grid article:last-child {
      grid-column: 1 / -1;
      width: calc(50% - 1.25rem);
      justify-self: center;
    }
  }

  @media (min-width: 1024px) {
    .alignment-stack-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: 2.25rem;
    }

    .alignment-stack-grid article {
      grid-column: span 2;
    }

    .alignment-stack-grid article:nth-child(4) {
      grid-column: 2 / span 2;
    }

    .alignment-stack-grid article:nth-child(5) {
      grid-column: 4 / span 2;
      width: auto;
    }
  }
</style>
