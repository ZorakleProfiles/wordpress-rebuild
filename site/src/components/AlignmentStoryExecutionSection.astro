---
import { Image } from "astro:assets";
import culturalFit   from "../assets/alignment/cultural-fit.svg";
import valuesFit     from "../assets/alignment/values-fit.svg";
import systemFit     from "../assets/alignment/system-fit.svg";
import capabilityFit from "../assets/alignment/capability-fit.svg";
import executionFit  from "../assets/alignment/execution-fit.svg";

const svgMap = [culturalFit, valuesFit, systemFit, capabilityFit, executionFit];

const alignmentLayers = [
  {
    title: "Cultural Fit",
    subtitle: "Identity alignment",
    description: "Culture is not a tagline—it's the daily standard franchisees either live up to or drift from.",
    elaboration: "When a franchisor's real operating style—how decisions are made, how problems are handled, how leaders show up—matches how franchisees naturally behave, the system reinforces itself at every level. When it doesn't, even capable owners become sources of friction that compounds silently across the network over time."
  },
  {
    title: "Values Fit",
    subtitle: "Motivation alignment",
    description: "Two people can work equally hard toward completely different definitions of success.",
    elaboration: "When franchisee values around financial goals, lifestyle expectations, and long-term purpose align with the franchisor's vision, commitment sustains through hard stretches. When they diverge, performance may start strong but erodes under pressure—because the owner is optimizing for something the system was never designed to deliver."
  },
  {
    title: "System Fit",
    subtitle: "Context alignment",
    description: "A profile that thrives in a 500-unit system may struggle in an emerging brand—and vice versa.",
    elaboration: "Franchisors at different stages of growth need fundamentally different owner profiles. Decision cadence, support availability, operational clarity, and peer community all shift as a system matures. Evaluating fit against your current system context—not an idealized version—is what makes selection decisions predictive rather than aspirational."
  },
  {
    title: "Capability Fit",
    subtitle: "Skill alignment",
    description: "Running a business and executing a specific franchise model are different skill sets.",
    elaboration: "The capabilities that predict success in your system—managing team dynamics, following operational systems precisely, leading customer experience, and applying financial discipline—are measurable when you know what to look for. Identifying gaps early makes training targeted and intentional instead of generic and reactive."
  },
  {
    title: "Execution Fit",
    subtitle: "Performance alignment",
    description: "Credentials and interviews describe potential. Execution under real-world pressure reveals truth.",
    elaboration: "Some owners are systematic under stress. Others adapt successfully outside the model. Some need structure to perform at their best; others thrive with autonomy. Understanding these patterns before and after launch—and building coaching around them—turns alignment from an abstract concept into a measurable operational advantage across the entire system."
  }
];

---

<section class="bg-white py-20 md:py-28 overflow-hidden">
  <div class="section-shell space-y-20 md:space-y-28">

    <!-- Alignment Stack -->
    <div>
      <p class="section-eyebrow">Alignment Stack</p>
      <h3 class="mt-2 text-4xl font-bold text-[#22252a] md:text-5xl">The Franchise Alignment Stack™</h3>

      <div class="mt-10">
        {alignmentLayers.map((layer, i) => (
          <div class="grid grid-cols-1 gap-10 border-t border-[#d1d4dd] py-12 md:grid-cols-[1fr_260px] md:gap-16 lg:py-16">
            <div class="max-w-2xl">
              <p class="text-xs font-semibold uppercase tracking-widest text-[#09cc9c]">{layer.subtitle}</p>
              <h4 class="mt-2 text-2xl font-bold text-[#22252a] md:text-3xl">{layer.title}</h4>
              <p class="mt-4 text-lg font-medium leading-snug text-[#22252a]">{layer.description}</p>
              <p class="mt-3 text-[15px] leading-relaxed text-[#3b3e47]">{layer.elaboration}</p>
            </div>
            <div class="flex items-center justify-center">
              <Image src={svgMap[i]} width={220} height={150} alt="" aria-hidden="true" />
            </div>
          </div>
        ))}
        <div class="border-t border-[#d1d4dd]"></div>
      </div>
    </div>
  </div>
</section>

