---
const lifecycleSteps = [
  {
    label: "Recruitment",
    detail: "Stop guessing on candidate fit. Zorakle surfaces alignment signals early so you attract prospects whose operating style, risk tolerance, and motivational drivers match how your system actually runs — before you've invested discovery days or franchise fees.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 md:w-9 md:h-9"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>`,
    accent: "#09cc9c",
  },
  {
    label: "Development",
    detail: "The signing decision is your highest-leverage moment. Alignment data gives development teams a clear, objective picture of how a candidate's profile maps to your top performers — so you approve owners with confidence, not just optimism.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 md:w-9 md:h-9"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    accent: "#3971c1",
  },
  {
    label: "Training",
    detail: "Generic onboarding creates inconsistent operators. When you know how a franchisee processes information, handles ambiguity, and responds to accountability, you can sequence training to match — accelerating time-to-competency and reducing costly early-stage mistakes.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 md:w-9 md:h-9"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
    accent: "#fd7730",
  },
  {
    label: "Coaching",
    detail: "Field coaches can't be everywhere — so every conversation needs to count. Alignment profiles show exactly where each owner's execution gaps are rooted, turning reactive check-ins into targeted interventions that actually move performance metrics.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 md:w-9 md:h-9"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
    accent: "#a259ff",
  },
];

---

<section class="bg-[#f3f3f3] py-20 md:py-28 overflow-hidden">
  <div class="section-shell">

    <!-- Lifecycle step flow -->
    <div>
      <p class="section-eyebrow">Where Zorakle Helps</p>
      <h2 class="section-title">Alignment intelligence across the lifecycle.</h2>
      <p class="section-copy max-w-3xl">
        From first conversation to long-term performance, alignment data drives smarter decisions at every stage.
      </p>

      <div class="mt-10">
        {lifecycleSteps.map((step) => (
          <div class="group grid grid-cols-[auto_1fr] items-start gap-x-5 gap-y-3 border-t border-[#d1d4dd] py-10 md:grid-cols-[2.5rem_minmax(0,1fr)_minmax(0,2fr)] md:items-center md:gap-x-10 lg:py-12">
            <div class="row-span-2 pt-1 transition-transform duration-300 group-hover:scale-110 md:row-span-1 md:pt-0" style={`color:${step.accent}`}>
              <Fragment set:html={step.icon} />
            </div>
            <h3 class="text-2xl font-bold text-[#22252a] md:text-3xl font-display">{step.label}</h3>
            <p class="col-start-2 text-[15px] leading-relaxed text-[#3b3e47] md:col-start-3 md:row-start-1">{step.detail}</p>
          </div>
        ))}
        <div class="border-t border-[#d1d4dd]"></div>
      </div>
    </div>

  </div>
</section>
