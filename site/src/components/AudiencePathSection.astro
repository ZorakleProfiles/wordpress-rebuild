---
const paths = [
  {
    role: "For Franchisors",
    title: "Build a system-specific standard for better awards.",
    features: [
      "A custom SpotOn! Blueprint and fit algorithm",
      "Candidate-to-system alignment reporting",
      "Insight for onboarding, coaching, and development"
    ],
    accent: "#f2773f",
    primary: { href: "/pricing/franchisors", label: "Choose a Franchisor Plan" },
    secondary: { href: "/solutions/franchisors", label: "Explore Franchisor Solutions" }
  },
  {
    role: "For Brokers",
    title: "Turn candidate insight into confident brand matches.",
    features: [
      "Candidate profiles you can use immediately",
      "Data-backed candidate-to-brand matching",
      "Stronger insight for discovery and recommendation conversations"
    ],
    accent: "#09a982",
    primary: { href: "/pricing/brokers", label: "Choose a Broker Plan" },
    secondary: { href: "/solutions/brokers", label: "Explore Broker Solutions" }
  }
];
---

<section id="how-zorakle-works" class="scroll-mt-28 border-b border-[#dbe4e2] bg-[#f8fbfa] py-16 md:py-20">
  <div class="section-shell">
    <div class="">
      <p class="section-eyebrow">Choose Your Path</p>
      <h2 class="section-title">One platform. Two ways to put alignment to work.</h2>
    </div>

    <div class="mt-12 grid gap-7 lg:grid-cols-2 lg:gap-8">
      {paths.map((path, index) => (
        <article
          class="group flex h-full flex-col overflow-hidden rounded-[28px] border border-[#d7e1df] border-t-4 bg-white shadow-[0_16px_42px_rgba(34,37,42,0.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_22px_52px_rgba(34,37,42,0.13)]"
          style={`border-top-color:${path.accent}`}
        >
          <div class="flex flex-1 flex-col p-7 md:p-9">
            <p class="mb-5 text-sm font-bold uppercase tracking-[0.14em]" style={`color:${path.accent}`}>
              {path.role}
            </p>
            <h3 class="font-display text-3xl font-bold leading-tight text-[#22252a] md:text-[2.15rem]">
              {path.title}
            </h3>

            <ul class="mt-7 space-y-3 border-t border-[#e2e8e6] pt-6">
              {path.features.map((feature) => (
                <li class="flex gap-3 text-[#3b3e47]">
                  <span
                    class="mt-[0.42rem] h-2.5 w-2.5 shrink-0 rounded-full"
                    style={`background:${path.accent}`}
                    aria-hidden="true"
                  ></span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <div class="mt-auto flex flex-col gap-3 pt-8 sm:flex-row sm:items-center">
              <a
                href={path.primary.href}
                class:list={[
                  "inline-flex items-center justify-center rounded-lg px-7 py-3 text-base font-bold transition hover:brightness-95 text-[#22252a]",
                  index === 0 ? "bg-[#fd7730] " : "bg-[#09a982]"
                ]}
              >
                {path.primary.label} <span class="ml-2" aria-hidden="true">→</span>
              </a>
              <a
                href={path.secondary.href}
                class="inline-flex items-center justify-center px-2 py-3 text-sm font-bold text-[#3b3e47] underline decoration-[#b7c7c3] decoration-2 underline-offset-8 transition hover:text-[#087f65]"
              >
                {path.secondary.label}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
