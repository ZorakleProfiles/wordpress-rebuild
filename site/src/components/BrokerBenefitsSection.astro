    <!--    })}-->
    <!--  </ol>-->
    <!--</div>-->
  </div>
</section>

<style>
  .benefit-ribbon :global(svg) {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.1;
  }

  ol :global(svg) {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.4;
  }
</style>
