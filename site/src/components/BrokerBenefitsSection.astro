---
const pillars = [
  { label: "Enhanced Engagement", icon: "engagement" },
  { label: "Stronger Credibility", icon: "credibility" },
  { label: "Added Client Value", icon: "value" },
  { label: "Science-Based Matches", icon: "science" },
  { label: "More Deals Closed", icon: "deals" }
];

const outcomes = [
  {
    stage: "Assess",
    title: "Understand every client",
    body: "Add objective insight to first conversations and professional judgment.",
    icon: "assess"
  },
  {
    stage: "Match",
    title: "Surface ranked brand fits",
    body: "Compare each client against real franchise requirements in minutes.",
    icon: "match"
  },
  {
    stage: "Present",
    title: "Present with confidence",
    body: "Walk clients through evidence-backed recommendations they can trust.",
    icon: "present"
  },
  {
    stage: "Close",
    title: "Close more deals faster",
    body: "Move from interest to a signed agreement with less back-and-forth.",
    icon: "close"
  }
];
---

<section class="relative overflow-hidden border-b border-[#d7e5e1] bg-[#f4fbfa] py-14 md:py-18" aria-labelledby="benefits-title">
  <div class="pointer-events-none absolute inset-0 opacity-45" aria-hidden="true">
    <div class="absolute -left-32 -top-52 size-[30rem] rounded-full border border-[#b8e2d8]"></div>
    <div class="absolute -left-20 -top-40 size-[21rem] rounded-full border border-[#c4e9e0]"></div>
    <div class="absolute -right-24 -bottom-52 size-[28rem] rounded-full border border-[#c4e9e0]"></div>
  </div>

  <div class="section-shell relative z-10">
    <header class="mx-auto max-w-3xl text-center">
      <p class="eyebrow-accent text-sm font-bold uppercase tracking-[0.16em] text-[#087f65]">What Working With Zorakle Makes Possible</p>
      <h2 id="benefits-title" class="font-display mt-3 text-[2.15rem] font-bold leading-[1.05] tracking-[-.03em] text-[#17233e] sm:text-[2.6rem] lg:text-[2.85rem]">
        Better Fit at the Table.{" "}
        <span class="text-[#087f65]">A Stronger Practice With Every Match.</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-[15px] leading-relaxed text-[#4f5e69] md:text-base">
        It&rsquo;s more than a sharper match. Science-based insight builds trust, shortens the path to a decision, and turns clients into referrals.
      </p>
    </header>

    <ul
      class="benefit-ribbon mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-x-4 gap-y-8 border-y border-[#cfe6e0] py-7 sm:grid-cols-3 md:mt-12 md:flex md:flex-nowrap md:items-start md:justify-between md:gap-0 md:py-8"
      aria-label="Key broker benefits"
    >
      {pillars.map((pillar, index) => (
        <li class:list={["flex flex-col items-center gap-2.5 text-center md:flex-1 md:px-3", index > 0 && "md:border-l md:border-[#cfe6e0]"]}>
          <span class="grid size-12 place-items-center rounded-full bg-[#e2f5f0] text-[#087f65] shadow-[0_6px_14px_rgba(8,127,101,0.14)] md:size-[50px]">
            {pillar.icon === "engagement" && <svg viewBox="0 0 32 32"><path d="M5 8h22a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H14l-5 4v-4H5a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2Z"/><path d="M10 14h12M10 18h8"/></svg>}
            {pillar.icon === "credibility" && <svg viewBox="0 0 32 32"><path d="M16 3 5 7v8c0 7 4.5 11.5 11 14 6.5-2.5 11-7 11-14V7Z"/><path d="m11 15.5 3.5 3.5L21 12"/></svg>}
            {pillar.icon === "value" && <svg viewBox="0 0 32 32"><path d="M9 5h14l6 8-13 15L3 13Z"/><path d="M3 13h26M12 5l-3 8 7 15M20 5l3 8-7 15"/></svg>}
            {pillar.icon === "science" && <svg viewBox="0 0 32 32"><circle cx="13" cy="13" r="8"/><path d="m19 19 9 9"/></svg>}
            {pillar.icon === "deals" && <svg viewBox="0 0 32 32"><path d="M4 27h24M8 27V18M15 27V11M22 27V15"/><path d="m6 15 8-7 5 4 9-8"/></svg>}
          </span>
          <span class="text-[11px] font-bold uppercase leading-snug tracking-[.06em] text-[#1e2f43] sm:text-xs">{pillar.label}</span>
        </li>
      ))}
    </ul>

    <!--<p class="mt-10 text-center text-[11px] font-bold uppercase tracking-[.22em] text-[#78928c] md:mt-12">How it comes together</p>-->

    <!--<div class="relative mt-6">-->
    <!--  <span class="absolute left-[23px] top-1 bottom-1 w-px bg-[#a9d4c9] md:left-0 md:right-0 md:top-[27px] md:bottom-auto md:h-px md:w-auto" aria-hidden="true"></span>-->

    <!--  <ol class="relative grid gap-9 md:grid-cols-4 md:gap-6">-->
