---
import { Image } from "astro:assets";
import VideoModalButton from "./VideoModalButton.astro";
import heroArtwork from "../assets/broker-hero.png";

// Solid teal treatment for the explainer button (a peer to the orange
// .btn-primary), matching the FranchisorHero explainer button. The [&>svg]
// rules restyle VideoModalButton's play glyph into a white circular badge.
const videoButtonClass =
  "inline-flex items-center justify-center gap-2.5 whitespace-nowrap rounded-lg bg-[#087f65] py-[11px] pl-[13px] pr-[22px] text-base font-bold text-white shadow-[0_10px_24px_rgba(8,127,101,0.28)] transition hover:-translate-y-px hover:bg-[#066b55] hover:shadow-[0_12px_30px_rgba(8,127,101,0.36)] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#09cc9c]/45 [&>svg]:size-[30px] [&>svg]:shrink-0 [&>svg]:rounded-full [&>svg]:bg-white [&>svg]:py-[7px] [&>svg]:pl-[9px] [&>svg]:pr-[7px] [&>svg]:text-[#087f65]";
---

<section class="relative overflow-hidden border-b border-[#d9e5e2] bg-[#eef7f4]">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <Image
      src={heroArtwork}
      alt=""
      widths={[640, 960, 1280, 1672]}
      sizes="100vw"
      class="h-full w-full object-cover object-[62%_center] sm:object-[58%_center] lg:object-center"
      priority={true}
    />
  </div>

  <div class="section-shell relative z-10 flex items-center py-10 sm:py-12 lg:min-h-[min(680px,calc(100svh-104px))] lg:py-8">
    <div class="max-w-[620px] rounded-3xl border border-white/80 bg-[#eef7f4]/94 p-6 shadow-[0_18px_50px_rgba(23,35,62,0.12)] backdrop-blur-[2px] sm:p-8 lg:p-9">
      <p class="font-display text-sm font-bold uppercase tracking-[0.16em] text-[#087f65] sm:text-base">
        Science-backed candidate &amp; brand intelligence
      </p>
      <h1 class="mt-4 font-display text-[2.35rem] font-bold leading-[1.01] tracking-[-0.03em] text-[#17233e] sm:mt-6 sm:text-[2.6rem] lg:text-[3rem] xl:text-[3.25rem]">
        Match clients to brands{" "}
        <span class="block text-[#087f65]">that fit.</span>
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed sm:mt-6 md:text-lg">
        Clients trust brokers who can explain fit, not just talk in probabilities. From the SpotOn! Profile to ranked brand matches — delivered under your own brand — Zorakle gives you science-backed insight that makes every introduction more credible.
      </p>

      <div class="mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:flex-wrap sm:items-center">
        <a class="btn-primary gap-2" href="/pricing/brokers">Sign Up Now <span aria-hidden="true">&rarr;</span></a>
        <VideoModalButton
          videoId="1137519120"
          label="Watch the 5-Minute Overview"
          modalTitle="Zorakle 5-minute broker overview"
          class={videoButtonClass}
        />
      </div>
    </div>
  </div>
</section>
