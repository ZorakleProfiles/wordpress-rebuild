---
import { Image } from "astro:assets";
import spotOnProfileReport from "../assets/spoton.png";
import spotonMatch from "../assets/spoton_match.png";

const outcomes = [
  {
    title: "Understand every client",
    body:
      "Start every recommendation with objective insight. One profile captures ownership traits, motivation patterns, and the behavioral indicators that predict franchise success.",
    tools: [
      {
        title: "SpotOn! Profile",
        body: "A complete candidate picture across fit, temperament, and business-owner capacity, on a single page."
      },
      {
        title: "Explainable results",
        body: "Plain-language output you can walk a client through, so every conversation feels grounded."
      }
    ],
    image: spotOnProfileReport,
    imageAlt: "SpotOn! Profile candidate report"
  },
  {
    title: "Match them to the right brands",
    body:
      "Turn insight into direction. Compare each client against real franchise requirements and present ranked, evidence-backed brand matches in minutes.",
    tools: [
      {
        title: "SpotOn! Match",
        body: "Ranked brand recommendations based on validated fit indicators, values alignment, and development readiness."
      },
      {
        title: "SpotOn! Referrals",
        body: "When a match is strong, send pre-qualified candidates straight to the franchisor's development team."
      }
    ],
    image: spotonMatch,
    imageAlt: "SpotOn! Match ranked brand results"
  }
];
---

<section class="overflow-hidden border-b border-[#e1e8e6] bg-white py-16 md:py-24">
  <div class="section-shell">
    <div class="max-w-4xl">
      <p class="section-eyebrow">The Broker Toolkit</p>
      <h2 class="section-title mt-4 text-[#1f232a]">
        Two connected tools. One confident recommendation.
      </h2>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-[#3b3e47] md:text-lg">
        Understand each client, then map them to the brands where they are most likely to win - with evidence you can put in front of them.
      </p>
    </div>

    <div class="mt-14 space-y-10 md:mt-18 md:space-y-14">
      {outcomes.map((outcome, index) => (
        <article class="grid items-center gap-8 rounded-[28px] border border-[#d7e1df] bg-[#f8fbfa] p-6 shadow-[0_18px_46px_rgba(23,35,62,0.07)] md:p-10 lg:grid-cols-2 lg:gap-14">
          <div class:list={["min-w-0", index % 2 === 1 && "lg:order-2"]}>
            <p class="font-display text-sm font-bold uppercase tracking-[0.14em] text-[#087f65]">
              Step {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-3 font-display text-3xl font-bold leading-tight text-[#1e2f43] sm:text-4xl">
              {outcome.title}
            </h3>
            <p class="mt-5 text-base leading-relaxed text-[#475569] md:text-lg">{outcome.body}</p>

            <div class="mt-7 space-y-4 border-t border-[#d8e5e1] pt-6">
              {outcome.tools.map((tool) => (
                <div class="grid grid-cols-[0.75rem_minmax(0,1fr)] gap-3">
                  <span class="mt-[0.55rem] h-2.5 w-2.5 rounded-full bg-[#09a985]" aria-hidden="true"></span>
                  <div>
                    <h4 class="font-display text-xl font-bold text-[#1e2f43]">{tool.title}</h4>
                    <p class="mt-1.5 text-sm leading-relaxed text-[#565b65] md:text-base">{tool.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div
            class:list={[
              "relative mx-auto flex min-h-[300px] w-full max-w-[560px] items-center justify-center sm:min-h-[400px]",
              index % 2 === 1 && "lg:order-1"
            ]}
            aria-label={`${outcome.title} report example`}
          >
            <div class="pointer-events-none absolute left-1/2 top-1/2 h-[260px] w-[260px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#d8f2ec] sm:h-[340px] sm:w-[340px]"></div>
            <div class="pointer-events-none absolute left-1/2 top-1/2 h-[300px] w-[300px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#cfe8e3] sm:h-[390px] sm:w-[390px]"></div>

            <div class="relative w-[86%] rotate-[-2deg] rounded-2xl border border-[#e1e9e7] bg-white p-2.5 shadow-[0_22px_48px_rgba(23,35,62,0.16)] sm:p-3">
              <Image
                src={outcome.image}
                alt={outcome.imageAlt}
                class="h-[200px] w-full rounded-xl object-contain object-top sm:h-[270px]"
                loading="lazy"
              />
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <a class="btn-primary" href="/request-reports">Get Sample Reports</a>
      <a class="inline-flex items-center gap-2 text-base font-semibold text-[#1e2f43] transition-colors hover:text-[#087f65]" href="/pricing/brokers">
        View Broker Pricing <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
