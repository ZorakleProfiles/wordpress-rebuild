---
import { Image } from "astro:assets";
import brokerBranding from "../assets/broker-branding.webp";
import confidentialQuestionnaire from "../assets/confidential-questionnaire.webp";
import spotOnProfileReport from "../assets/spoton.png";
import spotonMatch from "../assets/spoton_match.png";

const features = [
  {
    label: "SpotOn! Profile",
    title: "See exactly who you're talking to.",
    body: "Understand every client's fit, temperament, and business-owner potential with an objective, science-based read on who they are.",
    tone: "teal",
    icon: "candidate",
    image: spotOnProfileReport,
    imageAlt: "SpotOn! Profile candidate report",
    details: [
      "Objective, science-based read on temperament and fit",
      "Business-owner potential scored, not guessed",
      "Delivered as a branded report your clients keep"
    ]
  },
  {
    label: "SpotOn! Match",
    title: "Rank the right brands in minutes.",
    body: "Compare clients against real franchise requirements and rank the best-fit brands in minutes.",
    tone: "orange",
    icon: "match",
    image: spotonMatch,
    imageAlt: "SpotOn! Match ranked brand results",
    details: [
      "Ranks brands against real franchise requirements",
      "Compares clients across values, culture, and skills",
      "Surfaces the best-fit options in minutes, not weeks"
    ]
  },
  {
    label: "Confidential Questionnaire",
    title: "Get ahead of the hard conversations.",
    body: "A customizable questionnaire that surfaces net worth, liquidity, and background details before you invest more time.",
    tone: "orange",
    icon: "questionnaire",
    image: confidentialQuestionnaire,
    imageAlt: "Confidential Questionnaire settings with customizable sections, question counts, and status controls",
    details: [
      "Runs alongside the assessment or as its own link",
      "Simplified or comprehensive net worth calculator",
      "Sections and questions you customize to your process"
    ]
  },
  {
    label: "Broker Branding",
    title: "Every report looks like your practice.",
    body: "Every assessment link and report carries your logo and accent color, so clients see your practice at every step — not a vendor.",
    tone: "teal",
    icon: "branding",
    image: brokerBranding,
    imageAlt: "Broker branding settings alongside a client assessment customized with the broker's logo and accent color",
    details: [
      "Your logo and colors on every candidate report",
      "Consistent branding across assessment and Confidential Questionnaire links",
      "Reinforces your credibility in every client interaction"
    ]
  }
];

const toneClasses = {
  orange: { icon: "bg-[#fff1df] text-[#fd7730]", label: "text-[#a8420c]", check: "text-[#fd7730]" },
  teal: { icon: "bg-[#dcf7ee] text-[#087f65]", label: "text-[#087f65]", check: "text-[#087f65]" }
};
---

<section class="home-section overflow-hidden border-b border-[#dce9e6] bg-[#f4fbfa]">
  <div class="section-shell">
    <header class="text-center">
      <p class="section-eyebrow">Practical Intelligence</p>
      <h2 class="section-title text-center">Explore the Tools Behind Every Client Relationship.</h2>
      <p class="section-copy mx-auto max-w-2xl text-center">
        Matching is just the start. SpotOn! Profile, the Confidential Questionnaire, and your own branding work together on every report your clients see.
      </p>
    </header>

    <div class="mt-12 flex flex-col gap-16 md:mt-16 md:gap-20">
      {features.map((feature, index) => (
        <article class:list={["grid gap-8 md:grid-cols-2 md:gap-12", index % 2 === 1 && "md:[&>*:first-child]:order-2"]}>
          <div class="relative">
            <div class="overflow-hidden rounded-2xl border border-[#e2ecea] bg-white shadow-[0_18px_44px_rgba(25,55,70,0.1)]">
              {feature.image ? (
                <div class="flex h-[260px] items-center justify-center bg-[#f8fbfa] sm:h-[300px]">
                  <Image
                    src={feature.image}
                    alt={feature.imageAlt}
                    loading="lazy"
                    widths={[420, 640, 880]}
                    sizes="(max-width: 768px) calc(100vw - 3.75rem), 46vw"
                    class:list={[
                      "block h-full w-full object-contain",
                      feature.icon === "questionnaire" || feature.icon === "branding" ? "p-1 sm:p-2" : "p-5"
                    ]}
                  />
                </div>
              ) : (
                <div class="flex h-[260px] flex-col items-center justify-center gap-3 border-2 border-dashed border-[#d7e2df] bg-[#fafcfb] px-8 text-center sm:h-[300px]">
                  <span class:list={["flex size-14 items-center justify-center rounded-full", toneClasses[feature.tone].icon]} aria-hidden="true">
                    {feature.icon === "questionnaire" && <svg viewBox="0 0 48 48" class="size-7 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2.6]"><rect x="10" y="7" width="28" height="37" rx="3"/><path d="M18 7V6a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v1"/><path d="M17 20h14M17 27h14M17 34h9"/></svg>}
                    {feature.icon === "branding" && <svg viewBox="0 0 48 48" class="size-7 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2.6]"><path d="M6 23 23 6h13a6 6 0 0 1 6 6v13L25 42a3.5 3.5 0 0 1-5 0L6 28a3.5 3.5 0 0 1 0-5Z"/><circle cx="33" cy="15" r="3"/></svg>}
                  </span>
                  <p class="text-sm font-medium italic leading-snug text-[#67717b]">{feature.placeholder}</p>
                  <span class="rounded-full bg-white px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-[#697177] shadow-[0_2px_6px_rgba(23,35,62,0.06)]">Image coming soon</span>
                </div>
              )}
            </div>
          </div>

          <div>

            <p class:list={["text-sm font-bold uppercase tracking-[0.14em]", toneClasses[feature.tone].label]}>{feature.label}</p>
            <h3 class="font-display mt-2 text-2xl font-bold leading-tight text-[#17233e] sm:text-[1.75rem]">{feature.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-[#56586a]">{feature.body}</p>

            <ul class="mt-5 flex flex-col gap-3">
              {feature.details.map((detail) => (
                <li class="flex items-start gap-2.5 text-base leading-snug text-[#3b3e47]">
                  <svg viewBox="0 0 20 20" class:list={["mt-0.5 size-[17px] shrink-0", toneClasses[feature.tone].check]} aria-hidden="true"><path d="m4 10.5 4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{detail}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 flex items-center justify-center gap-8 max-[620px]:gap-3.5 md:mt-20">
      <span class="h-px w-[72px] bg-[#8790ad] max-[620px]:w-7" aria-hidden="true"></span>
      <a
        href="/request-reports"
        class="inline-flex min-h-11 items-center border-b border-[#35466e] pb-1.5 text-sm font-extrabold uppercase tracking-[0.12em] text-[#35466e] transition hover:text-[#0a9f86]"
      >
        Get Sample Reports <b class="ml-[15px] text-lg font-medium" aria-hidden="true">→</b>
      </a>
      <span class="h-px w-[72px] bg-[#8790ad] max-[620px]:w-7" aria-hidden="true"></span>
    </div>
  </div>
</section>
