---
import { Image } from "astro:assets";
import VideoModalButton from "./VideoModalButton.astro";
import brokerConsultation from "../assets/home-broker-consultation.png";
import spotonMatchOverall from "../assets/spoton.png";
---

<section class="home-section broker-feature relative overflow-hidden border-y border-[#d8ebe7] bg-[#f2fbf9]" aria-labelledby="broker-feature-title">
  <svg class="pointer-events-none absolute -left-10 -top-8 h-44 w-52 text-[#54cbbb] opacity-25" viewBox="0 0 220 170" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.5"><path d="M7 115 42 70l44 20 35-45 42-7 28 31"/><path d="m42 70 4-37m40 57 19 38m16-83-15-34"/></g>
    <g fill="currentColor"><circle cx="7" cy="115" r="9"/><circle cx="42" cy="70" r="11"/><circle cx="46" cy="33" r="10"/><circle cx="86" cy="90" r="10"/><circle cx="105" cy="128" r="7"/><circle cx="121" cy="45" r="11"/><circle cx="106" cy="11" r="7"/><circle cx="163" cy="38" r="10"/><circle cx="191" cy="69" r="8"/></g>
  </svg>
  <svg class="pointer-events-none absolute -right-12 top-1 h-48 w-48 rotate-12 text-[#54cbbb] opacity-25" viewBox="0 0 200 190" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.5"><path d="m24 23 38 47 38-24 36 43 49-8M62 70l-12 54m50-78 8-37m28 80 12 47m-12-47-36 47"/></g>
    <g fill="currentColor"><circle cx="24" cy="23" r="8"/><circle cx="62" cy="70" r="11"/><circle cx="50" cy="124" r="8"/><circle cx="100" cy="46" r="9"/><circle cx="108" cy="9" r="7"/><circle cx="136" cy="89" r="12"/><circle cx="148" cy="136" r="8"/><circle cx="100" cy="136" r="7"/><circle cx="185" cy="81" r="10"/></g>
  </svg>

  <div class="section-shell relative z-10 grid items-center gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-12 xl:gap-16">
    <div class="max-w-152.5">
      <p class="section-eyebrow">For Franchise Brokers</p>
      <h2 id="broker-feature-title" class="section-title">
        Help Candidates Find the Right Franchise.
      </h2>
      <p class="section-copy max-w-147.5">
        Bring science-backed candidate insight to every conversation—so you build credibility, add real value, match candidates to right-fit franchises, and close more deals.
      </p>

      <div class="mt-6 grid grid-cols-2 gap-4 border-[#9fcfc7] sm:grid-cols-4 sm:gap-0">
        <div class="flex items-center gap-2 sm:border-r sm:pr-3">
          <svg class="h-9 w-9 shrink-0 text-[#16b49a]" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M24 4 8 10v11c0 10 6.5 17.5 16 23 9.5-5.5 16-13 16-23V10L24 4Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="m17 23 5 5 10-11" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-[0.62rem] font-bold uppercase leading-snug tracking-[0.03em] text-[#344568]">Increase engagement &amp; credibility</span>
        </div>
        <div class="flex items-center gap-2 sm:border-r sm:px-3">
          <svg class="h-9 w-9 shrink-0 text-[#16b49a]" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M15 9h18l9 11-18 20L6 20 15 9Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M6 20h36M18 9l-4 11 10 20M30 9l4 11-10 20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-[0.62rem] font-bold uppercase leading-snug tracking-[0.03em] text-[#344568]">Add more value</span>
        </div>
        <div class="flex items-center gap-2 sm:border-r sm:px-3">
          <svg class="h-9 w-9 shrink-0 text-[#16b49a]" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M7 40h34M12 40V27M22 40V17M32 40V25M42 40V11" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="m11 20 10-9 7 6 12-11" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M33 6h8v8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-[0.62rem] font-bold uppercase leading-snug tracking-[0.03em] text-[#344568]">Do more deals</span>
        </div>
        <div class="flex items-center gap-2 sm:pl-3">
          <svg class="h-9 w-9 shrink-0 text-[#16b49a]" viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="23" cy="25" r="15" stroke="currentColor" stroke-width="2.5"/><circle cx="23" cy="25" r="8" stroke="currentColor" stroke-width="2.5"/><path d="m23 25 14-14m0 0v8m0-8h-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-[0.62rem] font-bold uppercase leading-snug tracking-[0.03em] text-[#344568]">Match to right-fit franchises</span>
        </div>
      </div>

      <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a href="/solutions/brokers" class="inline-flex min-h-12 items-center justify-center gap-4 rounded-lg bg-linear-to-r from-[#27b79f] to-[#12a68c] px-7 py-3 text-xs font-bold uppercase tracking-[0.16em] text-white transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#9be3d7]">
          Explore Broker Solutions <span class="text-lg leading-none" aria-hidden="true">&rarr;</span>
        </a>
        <VideoModalButton
          videoId="1137519120"
          label="Watch how it works"
          modalTitle="How Zorakle helps franchise brokers"
          class="broker-video-button inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.04em] text-[#3f4b73] underline decoration-[#3f4b73] underline-offset-4 transition hover:text-[#0a9f86]"
        />
      </div>
    </div>

    <div class="relative mx-auto hidden w-full max-w-165 overflow-hidden rounded-xl border border-[#9ed4c9] bg-white lg:block">
      <Image src={brokerConsultation} alt="A franchise consultant speaking with a prospective franchise owner" class="h-auto w-full object-contain object-center" widths={[540, 720, 960, 1200]} sizes="(min-width: 1024px) 50vw, 92vw" />

      <!--<div class="spoton-match-card absolute left-[55%] top-4 w-[56%] min-w-55 max-w-1/3 -translate-x-1/2 overflow-hidden rounded-xl border border-[#dce9e7] bg-white/95 backdrop-blur-sm sm:top-5" aria-hidden="true">-->
      <!--  <Image-->
      <!--    src={spotonMatchOverall}-->
      <!--    alt=""-->
      <!--    class="h-auto w-full object-cover"-->
      <!--    widths={[320, 480, 640]}-->
      <!--    sizes="(min-width: 1024px) 340px, 56vw"-->
      <!--  />-->
      <!--</div>-->
    </div>
  </div>
</section>

<style>
  .broker-video-button :global(svg) {
    box-sizing: content-box;
    border: 2px solid #16b49a;
    border-radius: 9999px;
    color: #16b49a;
    padding: 0.28rem;
  }

  .spoton-match-card {
    box-shadow: 0 10px 28px rgba(24, 73, 70, 0.14);
  }

  @media (max-width: 390px) {
    .spoton-match-card { transform: translateX(-50%) scale(0.84); transform-origin: top center; }
  }
</style>
