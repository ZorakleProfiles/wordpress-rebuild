---
import { franchiseWomanPodcast } from "../data/site-content";

const { name, platforms } = franchiseWomanPodcast;
---

<div class="rounded-xl border border-[#e2e5ec] bg-white px-5 py-4 shadow-sm sm:px-6">
  <p class="text-sm font-semibold uppercase tracking-wide text-[#56586a]">
    Listen to <span class="text-[#22252a]">{name}</span>
  </p>
  <ul class="mt-3 flex flex-wrap gap-2.5">
    {
      platforms.map((platform) => (
        <li>
          <a
            href={platform.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-[#d1d4dd] px-4 py-2 text-sm font-semibold text-[#22252a] transition hover:border-[#fd7730] hover:text-[#a8420c]"
          >
            {platform.icon === "spotify" && (
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.586 14.424a.623.623 0 0 1-.857.208c-2.348-1.435-5.304-1.76-8.785-.964a.623.623 0 1 1-.278-1.215c3.808-.871 7.076-.496 9.712 1.115a.623.623 0 0 1 .208.856Zm1.223-2.722a.78.78 0 0 1-1.072.257c-2.687-1.652-6.785-2.13-9.965-1.166a.78.78 0 1 1-.452-1.492c3.632-1.1 8.147-.568 11.232 1.329a.78.78 0 0 1 .257 1.072Zm.105-2.835c-3.223-1.914-8.54-2.09-11.618-1.156a.935.935 0 1 1-.542-1.79c3.532-1.072 9.404-.865 13.115 1.339a.935.935 0 1 1-.955 1.607Z" />
              </svg>
            )}
            {platform.icon === "apple" && (
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 0 0-3.16 19.49c-.02-.55-.03-1.4.02-2.02.05-.6.35-3.83.35-3.83s-.09-.18-.09-.45c0-.42.24-.73.55-.73.26 0 .38.19.38.43 0 .26-.17.65-.25 1.02-.07.3.15.55.45.55.54 0 .96-.57.96-1.4 0-.73-.53-1.24-1.28-1.24-.87 0-1.39.66-1.39 1.34 0 .27.1.55.24.71a.1.1 0 0 1 .02.09l-.09.37c-.02.06-.06.08-.13.05-.48-.22-.78-.92-.78-1.48 0-1.2.87-2.31 2.51-2.31 1.32 0 2.35.94 2.35 2.2 0 1.31-.83 2.37-1.98 2.37-.39 0-.75-.2-.87-.44l-.24.9c-.09.33-.32.75-.48 1 .36.11.74.17 1.14.17A10 10 0 0 0 12 2Z" />
              </svg>
            )}
            {platform.icon === "youtube" && (
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" />
              </svg>
            )}
            <span>{platform.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
