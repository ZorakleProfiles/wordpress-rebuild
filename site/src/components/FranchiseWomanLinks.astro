---
import { franchiseWomanPodcast } from "../data/site-content";

const { name, platforms } = franchiseWomanPodcast;
---

<div class="flex flex-col gap-1.5">
  <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[#6f727a]">Listen on</p>
  <ul class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-semibold">
    {
      platforms.map((platform, index) => (
        <li class="inline-flex items-center gap-4">
          {index > 0 && <span aria-hidden="true" class="text-[#c7cbd5]">•</span>}
          <a
            href={platform.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-sm text-[#3b3e47] underline decoration-transparent underline-offset-4 transition hover:text-[#a8420c] hover:decoration-[#fd7730] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ffd9c3]"
          >
            {platform.icon === "spotify" && (
              <svg class="h-4 w-4 text-[#fd7730]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.586 14.424a.623.623 0 0 1-.857.208c-2.348-1.435-5.304-1.76-8.785-.964a.623.623 0 1 1-.278-1.215c3.808-.871 7.076-.496 9.712 1.115a.623.623 0 0 1 .208.856Zm1.223-2.722a.78.78 0 0 1-1.072.257c-2.687-1.652-6.785-2.13-9.965-1.166a.78.78 0 1 1-.452-1.492c3.632-1.1 8.147-.568 11.232 1.329a.78.78 0 0 1 .257 1.072Zm.105-2.835c-3.223-1.914-8.54-2.09-11.618-1.156a.935.935 0 1 1-.542-1.79c3.532-1.072 9.404-.865 13.115 1.339a.935.935 0 1 1-.955 1.607Z" />
              </svg>
            )}
            {platform.icon === "apple" && (
                <svg class="h-4 w-4 text-[#fd7730]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z" />
                  <circle cx="12" cy="12" r="2" fill="currentColor" />
                  <path d="M12 14v4" />
                </svg>

            )}
            {platform.icon === "youtube" && (
              <svg class="h-4 w-4 text-[#fd7730]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" />
              </svg>
            )}
            <span>{platform.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
