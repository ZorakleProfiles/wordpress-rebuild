---
const benefits = [
  {
    title: "Fewer Wrong Fits",
    body: "Screen out mismatches before they ever reach a signed agreement.",
    icon: "fit",
  },
  {
    title: "Faster Time to Profitability",
    body: "New owners ramp up faster when the role plays to their strengths.",
    icon: "growth",
  },
  {
    title: "Stronger Culture Fit",
    body: "Build a system of owners who reinforce your brand instead of fighting it.",
    icon: "culture",
  },
  {
    title: "Higher Retention",
    body: "Owners who fit the model stay longer and reinvest in the system.",
    icon: "retention",
  },
];
---

<section class="relative overflow-hidden border-b border-[#d7e5e1] bg-[#f4fbfa] py-12 md:py-16" aria-labelledby="benefits-title">
  <div class="pointer-events-none absolute inset-0 opacity-45" aria-hidden="true">
    <div class="absolute -left-32 -top-52 size-[30rem] rounded-full border border-[#b8e2d8]"></div>
    <div class="absolute -left-20 -top-40 size-[21rem] rounded-full border border-[#c4e9e0]"></div>
    <div class="absolute -right-24 -bottom-52 size-[28rem] rounded-full border border-[#c4e9e0]"></div>
  </div>

  <div class="section-shell relative z-10">
    <header class="mx-auto max-w-3xl text-center">
      <p class="section-eyebrow">The Alignment Advantage</p>
      <h2 id="benefits-title" class="font-display mt-2.5 text-[2.25rem] font-bold leading-[1.03] tracking-[-.03em] text-[#17233e] sm:text-[2.6rem] lg:text-[2.85rem]">
        Fewer Wrong Fits. Fewer Costly Exits.{" "}
        <span class="text-[#087f65]">A Stronger System Every Year.</span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-[15px] leading-relaxed text-[#4f5e69] md:text-base">
        When candidates are chosen on evidence instead of instinct, the benefits compound&mdash;through the award, the ramp-up, and every year of ownership that follows.
      </p>
    </header>

    <ul class="mx-auto mt-12 flex max-w-5xl flex-col divide-y divide-[#cfe6e0] md:mt-14 md:flex-row md:divide-x md:divide-y-0">
      {benefits.map((benefit) => (
        <li class="flex items-start gap-4 py-6 first:pt-0 last:pb-0 md:flex-1 md:flex-col md:items-center md:px-6 md:py-0 md:text-center">
          <div class="grid size-11 shrink-0 place-items-center rounded-full bg-[#e2f5f0] text-[#087f65] [&_svg]:size-[22px] [&_svg]:fill-none [&_svg]:stroke-current [&_svg]:stroke-[2.2] [&_svg]:[stroke-linecap:round] [&_svg]:[stroke-linejoin:round]">
            {benefit.icon === "fit" && <svg viewBox="0 0 32 32"><path d="M16 3 5 7v8c0 7 4.5 11.5 11 14 6.5-2.5 11-7 11-14V7Z"/><path d="m11 15.5 3.5 3.5L21 12"/></svg>}
            {benefit.icon === "growth" && <svg viewBox="0 0 32 32"><path d="M4 27h24M6 27V19l7-3 6 4 8-11"/><path d="M22 9h6v6"/></svg>}
            {benefit.icon === "culture" && <svg viewBox="0 0 32 32"><circle cx="12" cy="10" r="5"/><circle cx="23" cy="12" r="4"/><path d="M4 29v-4c0-5 3.5-8 8-8s8 3 8 8v4M22 29v-3c0-4 2.5-7 7-7"/></svg>}
            {benefit.icon === "retention" && <svg viewBox="0 0 32 32"><path d="M27 12a11 11 0 1 0-1.6 8.4"/><path d="M27 5v7h-7"/></svg>}
          </div>
          <div class="md:mt-4">
            <h3 class="font-display text-lg font-bold leading-snug text-[#17233e]">{benefit.title}</h3>
            <p class="mt-1.5 text-[13.5px] leading-[1.5] text-[#5f6d73] md:mx-auto md:max-w-[200px]">{benefit.body}</p>
          </div>
        </li>
      ))}
    </ul>

    <p class="mx-auto mt-12 max-w-2xl text-center font-display text-lg font-bold leading-snug text-[#17233e] md:mt-14 md:text-xl">
      The strongest franchise systems don&rsquo;t leave franchisee fit to chance.
    </p>
  </div>
</section>
