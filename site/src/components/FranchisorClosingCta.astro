---
import { Image } from "astro:assets";
import meetingArtwork from "../assets/franchisor-closing-alignment-v2.png";
---

<section class="relative overflow-hidden border-t border-[#d9ebe7] bg-[#eefaf8]" aria-labelledby="franchisor-closing-title">
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={meetingArtwork}
      alt=""
      widths={[768, 1200, 1600, 2048]}
      sizes="100vw"
      class="h-full w-full object-cover object-[52%_top] max-[720px]:object-[62%_center]"
    />
  </div>

  <div class="section-shell relative z-10 flex min-h-[390px] items-center py-12 max-[720px]:min-h-[540px]">
    <div class="my-10 w-full rounded-[22px] border border-white/80 bg-[#f0fbf9]/[0.93] p-10 shadow-[0_18px_50px_rgba(23,35,62,0.1)] md:w-[62%] md:max-w-[620px] lg:w-[54%] lg:max-w-[690px] max-[720px]:my-8 max-[720px]:rounded-[18px] max-[720px]:p-6">
      <p class="section-eyebrow">People Aligned. Franchises Stronger.</p>
      <h2 id="franchisor-closing-title" class="section-title">
        Build Your Franchise System Around Better-Fit People.
      </h2>
      <p class="section-copy max-w-[650px]">
        See how Zorakle can help you establish a system-specific standard for selecting, supporting, and developing franchisees.
      </p>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
        <a class="btn-primary" href="/schedule">Book a Consultation <span aria-hidden="true">&rarr;</span></a>
        <a
          class="inline-flex items-center gap-2 text-base font-semibold text-[#1e2f43] transition-colors hover:text-[#23bfa8]"
          href="/pricing/franchisors"
        >
          View Plans &amp; Pricing <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>
