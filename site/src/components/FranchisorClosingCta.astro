---
import { Image } from "astro:assets";
import meetingArtwork from "../assets/franchisor-closing-alignment-v2.png";
---

<section class="closing-cta" aria-labelledby="franchisor-closing-title">
  <div class="closing-art" aria-hidden="true">
    <Image
      src={meetingArtwork}
      alt=""
      widths={[768, 1200, 1600, 2048]}
      sizes="100vw"
      class="closing-image"
    />
  </div>
  <div class="closing-wash" aria-hidden="true"></div>

  <div class="closing-shell">
    <div class="closing-copy">
      <p class="eyebrow">People Aligned. Franchises Stronger.</p>
      <h2 id="franchisor-closing-title">Build Your Franchise System{" "}<br />Around Better-Fit People.</h2>
      <p class="supporting-copy">
        See how Zorakle can help you establish a system-specific standard for selecting, supporting, and developing franchisees.
      </p>

      <div class="actions">
        <a class="primary-action" href="/schedule">
          Book a Consultation <span aria-hidden="true">→</span>
        </a>
        <a class="secondary-action" href="/pricing/franchisors">
          View Plans &amp; Pricing <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .closing-cta {
    position: relative;
    min-height: 390px;
    overflow: hidden;
    border-top: 1px solid #d9ebe7;
    background: #eefaf8;
  }

  .closing-art,
  .closing-wash {
    position: absolute;
    inset: 0;
  }

  .closing-art :global(.closing-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% top;
  }

  .closing-wash {
    background:
      linear-gradient(90deg, #f2fbfa 0%, rgba(242, 251, 250, .99) 36%, rgba(242, 251, 250, .82) 48%, rgba(242, 251, 250, .08) 69%),
      linear-gradient(180deg, rgba(234, 250, 247, .12), rgba(234, 250, 247, .22));
  }

  .closing-shell {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(1382px, calc(100% - 6rem));
    min-height: 390px;
    align-items: center;
    margin-inline: auto;
  }

  .closing-copy {
    width: min(650px, 51%);
    padding: 48px 0 46px;
  }

  .eyebrow {
    margin: 0;
    color: #009b83;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .25em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  h2 {
    margin: 19px 0 0;
    color: #07102c;
    font-family: "MontereyFLF", "Century Gothic", sans-serif;
    font-size: clamp(2.75rem, 3.65vw, 4.05rem);
    font-weight: 700;
    letter-spacing: -.025em;
    line-height: 1.02;
  }

  .supporting-copy {
    max-width: 650px;
    margin: 18px 0 0;
    color: #48557a;
    font-size: 16px;
    line-height: 1.48;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 21px;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    transition: transform .18s ease, filter .18s ease, color .18s ease;
  }

  .primary-action {
    min-width: 315px;
    padding: 0 25px;
    border-radius: 10px;
    background: #ff5d17;
    box-shadow: 0 10px 22px rgba(255, 93, 23, .18);
    color: #fff;
  }

  .secondary-action {
    min-width: 204px;
    border-bottom: 1px solid #24375f;
    color: #24375f;
  }

  .primary-action:hover,
  .secondary-action:hover {
    transform: translateY(-1px);
  }

  .primary-action:hover { filter: brightness(.96); }
  .secondary-action:hover { color: #007f6a; }

  @media (max-width: 1100px) {
    .closing-shell { width: min(100% - 3rem, 960px); }
    .closing-wash { background: linear-gradient(90deg, #f2fbfa 0%, rgba(242,251,250,.98) 44%, rgba(242,251,250,.6) 67%, rgba(242,251,250,.12) 100%); }
    .closing-copy { width: 60%; }
    .actions { align-items: flex-start; flex-direction: column; gap: 10px; }
    .secondary-action { min-height: 42px; }
  }

  @media (max-width: 720px) {
    /* Text overlays the full-bleed image (same treatment as the hero) rather
       than stacking below an image band. */
    .closing-cta { min-height: 540px; }
    .closing-art :global(.closing-image) { object-position: 62% center; }
    .closing-wash {
      background: linear-gradient(180deg, rgba(242,251,250,.58) 0%, rgba(242,251,250,.8) 46%, rgba(242,251,250,.92) 100%);
    }
    .closing-shell {
      width: min(100% - 2rem, 580px);
      min-height: 540px;
      align-items: center;
    }
    .closing-copy {
      width: 100%;
      padding: 52px 0;
    }
    .eyebrow { font-size: 11px; }
    h2 { margin-top: 14px; font-size: clamp(2.35rem, 10.6vw, 3.1rem); }
    h2 br { display: none; }
    .supporting-copy { margin-top: 14px; font-size: 15px; }
    .actions { width: 100%; margin-top: 19px; }
    .primary-action, .secondary-action { box-sizing: border-box; width: 100%; min-width: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-action,
    .secondary-action { transition: none; }
  }
</style>
