---
import { Image } from "astro:assets";
import VideoModalButton from "./VideoModalButton.astro";
import heroArtwork from "../assets/franchisor-hero-alignment-v2.png";

const explainerVideo =
  "https://cdn.sanity.io/files/4kjxjblw/production/676d9e59bc7e318e2e1756be2b170d63faf3d3ca.mp4";
---

<section class="relative overflow-hidden border-b border-[#d9e5e2] bg-[#eef7f4]">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <Image
      src={heroArtwork}
      alt=""
      widths={[640, 960, 1280, 1536]}
      sizes="100vw"
      class="h-full w-full object-cover object-[68%_center] lg:object-center"
      priority={true}
    />
    <div class="absolute inset-0 bg-[#eef7f4]/85 sm:bg-[#eef7f4]/72 lg:bg-transparent"></div>
  </div>

  <div class="section-shell relative z-10 flex items-center py-10 sm:py-12 lg:min-h-[min(680px,calc(100svh-104px))] lg:py-8">
    <div class="max-w-[600px] lg:rounded-3xl lg:border lg:border-white/80 lg:bg-[#eef7f4]/95 lg:p-5 lg:shadow-[0_18px_50px_rgba(23,35,62,0.10)] xl:p-6">
      <p class="font-display text-sm font-bold uppercase tracking-[0.16em] text-[#087f65] sm:text-base">
        For Franchisors
      </p>
      <h1 class="mt-4 font-display text-[2.35rem] font-bold leading-[1.01] tracking-[-0.03em] text-[#17233e] sm:mt-6 sm:text-[2.6rem] lg:text-[3rem] xl:text-[3.25rem]">
        Build a Stronger Franchise System
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed sm:mt-6 md:text-lg">
        Zorakle helps you identify candidates who fit your culture, operating model, and expectations&mdash;and gives your team the insight to help them succeed long after the agreement is signed.
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:mt-8 sm:items-start sm:gap-5">
        <a class="btn-primary" href="/schedule">Book a Consultation <span aria-hidden="true">&rarr;</span></a>
        <VideoModalButton
          videoSrc={explainerVideo}
          label="Watch the 5-Minute Explainer"
          modalTitle="Zorakle 5-minute franchisor explainer"
          class="hero-video-trigger"
        />
      </div>
    </div>
  </div>
</section>

<style>
  :global(.hero-video-trigger) {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #21335d;
    cursor: pointer;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  :global(.hero-video-trigger svg) {
    box-sizing: border-box;
    width: 44px;
    height: 44px;
    padding: 13px 12px 13px 15px;
    border: 2px solid #00a98d;
    border-radius: 999px;
    color: #00a98d;
  }
</style>
