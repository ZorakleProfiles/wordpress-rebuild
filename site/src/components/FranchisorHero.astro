---
import { Image } from "astro:assets";
import VideoModalButton from "./VideoModalButton.astro";
import heroArtwork from "../assets/franchisor-hero-alignment-v2.png";

const explainerVideo =
  "https://cdn.sanity.io/files/4kjxjblw/production/676d9e59bc7e318e2e1756be2b170d63faf3d3ca.mp4";
---

<section class="franchisor-hero">
  <div class="hero-art" aria-hidden="true">
    <Image src={heroArtwork} alt="" widths={[640, 960, 1280, 1672]} sizes="100vw" class="h-full w-full object-cover" priority={true} />
  </div>
  <div class="hero-wash" aria-hidden="true"></div>

  <div class="franchisor-shell hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">For Franchisors</p>
      <span class="eyebrow-rule" aria-hidden="true"></span>
      <h1>Build a Stronger<br />Franchise System—<br />Starting With the<br />Right People.</h1>
      <p class="hero-description">
        Zorakle helps you identify candidates who fit your culture, operating model, and expectations—and gives your team the insight to help them succeed long after the agreement is signed.
      </p>
      <a class="hero-cta" href="/schedule">Book a Consultation <span aria-hidden="true">→</span></a>
      <VideoModalButton
        videoSrc={explainerVideo}
        label="Watch the 5-Minute Explainer"
        modalTitle="Zorakle 5-minute franchisor explainer"
        class="hero-video-trigger"
      />
    </div>

  </div>
</section>

<style>
  .franchisor-hero { position: relative; min-height: 800px; overflow: hidden; border-bottom: 1px solid #dbe9e6; background: #f3fbfa; }
  .hero-art { position: absolute; inset: 0; }
  .hero-art :global(img) { object-position: center center; }
  .hero-wash { position: absolute; inset: 0; background: linear-gradient(90deg, #f7fcfb 0%, rgba(247,252,251,.96) 28%, rgba(247,252,251,.64) 39%, rgba(247,252,251,0) 55%); }
  .franchisor-shell { width: min(1382px, calc(100% - 6rem)); margin-inline: auto; }
  .hero-inner { position: relative; z-index: 1; min-height: 800px; display: flex; align-items: flex-start; }
  .hero-copy { width: 510px; padding: 55px 0 54px; }
  .hero-eyebrow { margin: 0; color: #008e76; font-size: 15px; font-weight: 700; letter-spacing: .27em; line-height: 1.2; text-transform: uppercase; }
  .eyebrow-rule { display: block; width: 56px; height: 2px; margin-top: 20px; background: #00ac91; }
  h1 { margin: 19px 0 0; color: #070d28; font-family: "MontereyFLF", "Century Gothic", sans-serif; font-size: clamp(3.2rem, 4.25vw, 4.12rem); font-weight: 700; letter-spacing: -.025em; line-height: .99; }
  .hero-description { max-width: 510px; margin: 32px 0 0; color: #48557a; font-size: 17px; line-height: 1.48; }
  .hero-cta { display: flex; width: 475px; min-height: 64px; align-items: center; justify-content: center; gap: 24px; margin-top: 28px; border-radius: 16px; background: #ff5d17; box-shadow: 0 12px 24px rgba(255,93,23,.18); color: white; font-size: 16px; font-weight: 700; letter-spacing: .19em; text-transform: uppercase; transition: transform .18s ease, filter .18s ease; }
  .hero-cta:hover { filter: brightness(.96); transform: translateY(-1px); }
  :global(.hero-video-trigger) { display: inline-flex; min-height: 54px; align-items: center; gap: 20px; margin-top: 26px; padding: 0 0 0 2px; border: 0; background: transparent; color: #21335d; cursor: pointer; font-size: 13px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  :global(.hero-video-trigger svg) { box-sizing: border-box; width: 54px; height: 54px; padding: 16px 15px 16px 18px; border: 2px solid #00a98d; border-radius: 999px; color: #00a98d; }
  :global(.hero-video-trigger)::after { content: ""; width: 220px; height: 2px; margin-left: -238px; margin-top: 48px; background: #00a98d; }
  @media (max-width: 1100px) {
    .franchisor-shell { width: min(100% - 3rem, 960px); }
    .hero-wash { background: linear-gradient(90deg, rgba(247,252,251,.99) 0%, rgba(247,252,251,.94) 42%, rgba(247,252,251,.2) 82%); }
  }
  @media (max-width: 767px) {
    .franchisor-hero, .hero-inner { min-height: 780px; }
    .franchisor-shell { width: min(100% - 2rem, 590px); align-items: flex-end; }
    .hero-art { height: 46%; }
    .hero-art :global(img) { object-position: 67% center; }
    .hero-wash { background: linear-gradient(180deg, rgba(247,252,251,.04) 0%, rgba(247,252,251,.3) 30%, #f7fcfb 48%, #f7fcfb 100%); }
    .hero-copy { width: 100%; padding: 300px 0 36px; }
    .hero-eyebrow { font-size: 12px; }
    .eyebrow-rule { margin-top: 12px; }
    h1 { margin-top: 14px; font-size: clamp(2.45rem, 11.2vw, 3.35rem); }
    .hero-description { margin-top: 20px; font-size: 15px; }
    .hero-cta { width: 100%; min-height: 58px; font-size: 13px; }
    :global(.hero-video-trigger) { margin-top: 18px; font-size: 11px; letter-spacing: .14em; }
    :global(.hero-video-trigger svg) { width: 46px; height: 46px; padding: 13px 12px 13px 15px; }
    :global(.hero-video-trigger)::after { display: none; }
  }
</style>
