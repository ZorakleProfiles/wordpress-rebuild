---
import { Image } from "astro:assets";
import spotOnProfileReport from "../assets/spoton.png";
import eclipseReport from "../assets/eclipse.png";
import blueprintReport from "../assets/blueprint.png";
import alignmentReport from "../assets/alignment_report.png";
import spotonReferral from "../assets/referrall.png";
import marketingBlueprint from "../assets/marketing_blueprint.png";

const outcomes = [
  {
    title: "Build your standard",
    body:
      "Turn what makes your strongest operators successful into a documented, system-specific standard your entire development team can use.",
    tools: [
      {
        title: "SpotOn! Blueprint",
        body: "Defines your custom fit algorithm and the traits connected to success in your system."
      },
      {
        title: "Alignment Report",
        body: "Compares brand expectations with actual franchisee performance so the standard can improve over time."
      }
    ],
    primaryImage: blueprintReport,
    primaryAlt: "SpotOn Blueprint report",
    secondaryImage: alignmentReport,
    secondaryAlt: "SpotOn Alignment Report"
  },
  {
    title: "Select with confidence",
    body:
      "Move from a promising candidate to an informed award decision with a complete view of the person and their fit with your franchise model.",
    tools: [
      {
        title: "SpotOn! Profile",
        body: "Shows the candidate across all seven sciences, including values, work style, competencies, and business capacity."
      },
      {
        title: "Eclipse Report",
        body: "Measures candidate-to-system compatibility and makes strengths and potential risk areas easy to see."
      }
    ],
    primaryImage: spotOnProfileReport,
    primaryAlt: "Candidate SpotOn Profile",
    secondaryImage: eclipseReport,
    secondaryAlt: "Candidate-to-system Eclipse Report"
  },
  {
    title: "Improve franchise development",
    body:
      "Use the same fit intelligence to attract stronger prospects and create a more qualified path into your development pipeline.",
    tools: [
      {
        title: "SpotOn! Referrals",
        body: "Brings broker-assessed, high-alignment candidates directly to your team for review."
      },
      {
        title: "Marketing Blueprint",
        body: "Translates your ideal franchisee profile into messaging, tone, visuals, and channels that resonate."
      }
    ],
    primaryImage: spotonReferral,
    primaryAlt: "SpotOn Referral for a pre-qualified franchise candidate",
    secondaryImage: marketingBlueprint,
    secondaryAlt: "SpotOn Marketing Blueprint"
  }
];
---

<section class="overflow-hidden border-b border-[#e1e8e6] bg-white py-16 md:py-24">
  <div class="section-shell">
    <div class="max-w-4xl">
      <p class="section-eyebrow">What Every Franchisor Gets</p>
      <h2 class="section-title mt-4 text-[#1f232a]">
        Six connected tools. Three outcomes that strengthen your system.
      </h2>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-[#3b3e47] md:text-lg">
        Each tool is valuable on its own. Together, they create one connected approach to defining fit, selecting candidates, and improving franchise development.
      </p>
    </div>

    <div class="mt-14 space-y-10 md:mt-18 md:space-y-14">
      {outcomes.map((outcome, index) => (
        <article class="grid items-center gap-8 rounded-[28px] border border-[#d7e1df] bg-[#f8fbfa] p-6 shadow-[0_18px_46px_rgba(23,35,62,0.07)] md:p-10 lg:grid-cols-2 lg:gap-14">
          <div class:list={["min-w-0", index % 2 === 1 && "lg:order-2"]}>
            <p class="font-display text-sm font-bold uppercase tracking-[0.14em] text-[#087f65]">
              Outcome {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-3 font-display text-3xl font-bold leading-tight text-[#1e2f43] sm:text-4xl">
              {outcome.title}
            </h3>
            <p class="mt-5 text-base leading-relaxed text-[#475569] md:text-lg">{outcome.body}</p>

            <div class="mt-7 space-y-4 border-t border-[#d8e5e1] pt-6">
              {outcome.tools.map((tool) => (
                <div class="grid grid-cols-[0.75rem_minmax(0,1fr)] gap-3">
                  <span class="mt-[0.55rem] h-2.5 w-2.5 rounded-full bg-[#09a985]" aria-hidden="true"></span>
                  <div>
                    <h4 class="font-display text-xl font-bold text-[#1e2f43]">{tool.title}</h4>
                    <p class="mt-1.5 text-sm leading-relaxed text-[#565b65] md:text-base">{tool.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div
            class:list={[
              "relative mx-auto min-h-[330px] w-full max-w-[610px] sm:min-h-[430px]",
              index % 2 === 1 && "lg:order-1"
            ]}
            aria-label={`${outcome.title} report examples`}
          >
            <div class="pointer-events-none absolute left-1/2 top-1/2 h-[270px] w-[270px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#d8f2ec] sm:h-[360px] sm:w-[360px]"></div>
            <div class="pointer-events-none absolute left-1/2 top-1/2 h-[310px] w-[310px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#cfe8e3] sm:h-[410px] sm:w-[410px]"></div>

            <div class="absolute right-0 top-2 w-[69%] rotate-[3deg] rounded-2xl border border-[#e1e9e7] bg-white p-2.5 shadow-[0_20px_44px_rgba(23,35,62,0.14)] sm:p-3">
              <Image
                src={outcome.secondaryImage}
                alt={outcome.secondaryAlt}
                class="h-[210px] w-full rounded-xl object-contain object-top sm:h-[285px]"
                loading="lazy"
              />
            </div>
            <div class="absolute bottom-2 left-0 w-[73%] rotate-[-3deg] rounded-2xl border border-[#e1e9e7] bg-white p-2.5 shadow-[0_22px_48px_rgba(23,35,62,0.18)] sm:p-3">
              <Image
                src={outcome.primaryImage}
                alt={outcome.primaryAlt}
                class="h-[210px] w-full rounded-xl object-contain object-top sm:h-[285px]"
                loading="lazy"
              />
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <a class="btn-primary" href="/request-reports">Get Sample Reports</a>
      <a class="inline-flex items-center gap-2 text-base font-semibold text-[#1e2f43] transition-colors hover:text-[#087f65]" href="/pricing/franchisors">
        View Franchisor Pricing <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
