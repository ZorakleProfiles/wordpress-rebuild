---
import { Image } from "astro:assets";
import attractionReports from "../assets/practical-attraction-reports.png";
import candidateReports from "../assets/practical-candidate-reports.png";
import systemReports from "../assets/practical-system-reports.png";

const cards = [
  {
    title: "Attraction Intelligence",
    body: "Use your Marketing Blueprint to attract better-fit franchise candidates.",
    tone: "orange",
    icon: "attraction",
    image: attractionReports,
    imageAlt: "Marketing Blueprint and Ideal Franchise Candidate Messaging report covers"
  },
  {
    title: "Candidate Intelligence",
    body: "Use the SpotOn! Profile and Eclipse Report to evaluate and compare franchise candidates.",
    tone: "teal",
    icon: "candidate",
    image: candidateReports,
    imageAlt: "SpotOn Blueprint and Eclipse Report covers"
  },
  {
    title: "System Intelligence",
    body: "Use the Blueprint and Alignment Report to strengthen performance over time.",
    tone: "navy",
    icon: "system",
    image: systemReports,
    imageAlt: "System Blueprint and Alignment Report covers"
  }
];
---

<section class="intelligence-section">
  <div class="intelligence-shell">
    <header class="section-heading">
      <p>Practical Intelligence</p>
      <span aria-hidden="true"></span>
      <h2>Explore the Insight Behind Better Decisions.</h2>
    </header>

    <div class="cards-grid">
      {cards.map((card) => (
        <article class:list={["intelligence-card", card.tone]}>
          <div class="card-heading">
            <div class="card-icon" aria-hidden="true">
              {card.icon === "attraction" && (
                <svg viewBox="0 0 48 48"><path d="M7 27h7l19 9V10L14 19H7v8Z"/><path d="m14 27 4 13h7l-5-11M38 15l5-4M39 23h6M38 31l5 4"/></svg>
              )}
              {card.icon === "candidate" && (
                <svg viewBox="0 0 48 48"><circle cx="24" cy="13" r="6"/><circle cx="10" cy="20" r="4"/><circle cx="38" cy="20" r="4"/><path d="M14 39v-7c0-7 4-11 10-11s10 4 10 11v7M3 38v-5c0-5 3-8 8-8h3M45 38v-5c0-5-3-8-8-8h-3"/></svg>
              )}
              {card.icon === "system" && (
                <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="8"/><path d="M24 3v6M24 39v6M3 24h6M39 24h6M9 9l4 4M35 35l4 4M39 9l-4 4M13 35l-4 4"/><circle cx="24" cy="24" r="17" stroke-dasharray="5 4"/></svg>
              )}
            </div>
            <div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </div>
          </div>

          <div class="report-artwork">
            <Image src={card.image} alt={card.imageAlt} loading="lazy" widths={[420, 640, 880]} sizes="(max-width: 620px) calc(100vw - 3.75rem), (max-width: 1050px) 650px, 29vw" />
          </div>
        </article>
      ))}
    </div>

    <div class="all-reports">
      <span aria-hidden="true"></span>
      <a href="/request-reports">Explore All Sample Reports <b aria-hidden="true">→</b></a>
      <span aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .intelligence-section { position: relative; overflow: hidden; border-bottom: 1px solid #dce9e6; background:#fff; padding: 36px 0 28px; }
  .intelligence-shell { position: relative; z-index: 1; width: min(1420px, calc(100% - 4rem)); margin-inline: auto; }
  .section-heading { text-align: center; }
  .section-heading > p { margin: 0; color: #00a78b; font-size: 14px; font-weight: 700; letter-spacing: .24em; line-height: 1.3; text-transform: uppercase; }
  .section-heading > span { display: block; width: 60px; height: 2px; margin: 13px auto 14px; background: #00ac91; }
  .section-heading h2 { margin: 0; color: #07102c; font-family: "MontereyFLF", "Century Gothic", sans-serif; font-size: clamp(2.35rem, 3.2vw, 3.3rem); font-weight: 700; letter-spacing: -.025em; line-height: 1.05; }
  .cards-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: 20px; }
  .intelligence-card { display: flex; min-width: 0; min-height: 485px; flex-direction: column; overflow: hidden; padding: 20px 18px 17px; border: 1px solid #e2ecea; border-radius: 18px; background: rgba(255,255,255,.96); box-shadow: 0 13px 34px rgba(25,55,70,.07); }
  .card-heading { display: grid; grid-template-columns: 82px minmax(0, 1fr); gap: 16px; align-items: center; min-height: 100px; }
  .card-icon { display: flex; width: 82px; height: 82px; align-items: center; justify-content: center; border-radius: 999px; }
  .orange .card-icon { color: #ff5a18; background: #ffebe1; }
  .teal .card-icon { color: #00a88a; background: #d4f8f1; }
  .navy .card-icon { color: #00a88a; background: #d4f8f1; }
  .card-icon svg { width: 45px; height: 45px; fill: none; stroke: currentColor; stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; }
  .card-heading h3 { margin: 0; color: #0a1737; font-size: 15px; font-weight: 800; letter-spacing: .1em; line-height: 1.25; text-transform: uppercase; }
  .card-heading p { margin: 6px 0 0; color: #4d587b; font-size: 14px; line-height: 1.35; }
  .report-artwork { display: flex; flex: 1; min-height: 286px; align-items: flex-end; justify-content: center; overflow: hidden; margin: 5px -10px 10px; border-radius: 12px; background: #f8fbfa; }
  .report-artwork :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: center; transition: transform .28s ease; }
  .intelligence-card:hover .report-artwork :global(img) { transform: scale(1.012); }
  .all-reports { display: flex; align-items: center; justify-content: center; gap: 34px; margin-top: 20px; }
  .all-reports > span { width: 72px; height: 1px; background: #8790ad; }
  .all-reports a { padding-bottom: 6px; border-bottom: 1px solid #35466e; color: #35466e; font-size: 13px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .all-reports b { margin-left: 15px; font-size: 18px; font-weight: 500; }
  @media (max-width: 1050px) {
    .cards-grid { grid-template-columns: 1fr; max-width: 720px; margin: 28px auto 0; }
    .intelligence-card { min-height: 0; }
    .report-artwork { min-height: 0; margin-top: 12px; }
  }
  @media (max-width: 620px) {
    .intelligence-section { padding: 42px 0 30px; }
    .intelligence-shell { width: min(100% - 2rem, 580px); }
    .section-heading > p { font-size: 11px; }
    .section-heading h2 { font-size: 2.35rem; }
    .intelligence-card { min-height: 0; padding: 17px 14px 14px; }
    .card-heading { grid-template-columns: 66px minmax(0, 1fr); gap: 12px; }
    .card-icon { width: 66px; height: 66px; }
    .card-icon svg { width: 37px; height: 37px; }
    .card-heading h3 { font-size: 13px; }
    .card-heading p { font-size: 13px; }
    .report-artwork { margin: 12px -7px 10px; }
    .all-reports { gap: 14px; }
    .all-reports > span { width: 28px; }
    .all-reports a { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .report-artwork :global(img) { transition: none; }
  }
</style>
