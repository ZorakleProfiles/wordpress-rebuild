---
import { Image } from "astro:assets";
import attractionReports from "../assets/practical-attraction-reports.png";
import candidateReports from "../assets/practical-candidate-reports.png";
import systemReports from "../assets/practical-system-reports.png";

const cards = [
  {
    title: "Attraction Intelligence",
    body: "Use your Marketing Blueprint to attract better-fit franchise candidates.",
    tone: "orange",
    icon: "attraction",
    image: attractionReports,
    imageAlt: "Marketing Blueprint and Ideal Franchise Candidate Messaging report covers"
  },
  {
    title: "Candidate Intelligence",
    body: "Use the SpotOn! Profile and Eclipse Report to evaluate and compare franchise candidates.",
    tone: "teal",
    icon: "candidate",
    image: candidateReports,
    imageAlt: "SpotOn Blueprint and Eclipse Report covers"
  },
  {
    title: "System Intelligence",
    body: "Use the Blueprint and Alignment Report to strengthen performance over time.",
    tone: "navy",
    icon: "system",
    image: systemReports,
    imageAlt: "System Blueprint and Alignment Report covers"
  }
];

const iconToneClasses = {
  orange: "bg-[#ffebe1] text-[#ff5a18]",
  teal: "bg-[#d4f8f1] text-[#00a88a]",
  navy: "bg-[#d4f8f1] text-[#00a88a]"
};
---

<section class="home-section overflow-hidden border-b border-[#dce9e6] bg-[#f4fbfa]">
  <div class="section-shell">
    <header class="text-center">
      <p class="section-eyebrow">Practical Intelligence</p>
      <h2 class="section-title text-center">Explore the Insight Behind Better Decisions.</h2>
    </header>

    <div class="mx-auto mt-10 grid max-w-[720px] gap-5 md:mt-12 lg:max-w-none lg:grid-cols-3">
      {cards.map((card) => (
        <article class="group flex min-w-0 flex-col overflow-hidden rounded-2xl border border-[#e2ecea] bg-white/95 px-[18px] pb-[17px] pt-5 shadow-[0_13px_34px_rgba(25,55,70,0.07)] lg:min-h-[485px]">
          <div class="grid min-h-[100px] grid-cols-[66px_minmax(0,1fr)] items-center gap-3 sm:grid-cols-[82px_minmax(0,1fr)] sm:gap-4">
            <div
              class:list={[
                "flex size-[66px] items-center justify-center rounded-full sm:size-[82px] [&_svg]:size-[37px] sm:[&_svg]:size-[45px] [&_svg]:fill-none [&_svg]:stroke-current [&_svg]:[stroke-linecap:round] [&_svg]:[stroke-linejoin:round] [&_svg]:[stroke-width:2.8]",
                iconToneClasses[card.tone]
              ]}
              aria-hidden="true"
            >
              {card.icon === "attraction" && <svg viewBox="0 0 48 48"><path d="M7 27h7l19 9V10L14 19H7v8Z"/><path d="m14 27 4 13h7l-5-11M38 15l5-4M39 23h6M38 31l5 4"/></svg>}
              {card.icon === "candidate" && <svg viewBox="0 0 48 48"><circle cx="24" cy="13" r="6"/><circle cx="10" cy="20" r="4"/><circle cx="38" cy="20" r="4"/><path d="M14 39v-7c0-7 4-11 10-11s10 4 10 11v7M3 38v-5c0-5 3-8 8-8h3M45 38v-5c0-5-3-8-8-8h-3"/></svg>}
              {card.icon === "system" && <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="8"/><path d="M24 3v6M24 39v6M3 24h6M39 24h6M9 9l4 4M35 35l4 4M39 9l-4 4M13 35l-4 4"/><circle cx="24" cy="24" r="17" stroke-dasharray="5 4"/></svg>}
            </div>
            <div>
              <h3 class="font-display text-base font-bold leading-snug text-[#111827] sm:text-lg">{card.title}</h3>
              <p class="mt-1.5 text-sm leading-snug text-[#5f6673]">{card.body}</p>
            </div>
          </div>

          <div class="-mx-2 mb-2.5 mt-1.5 flex flex-1 items-end justify-center overflow-hidden rounded-xl bg-[#f8fbfa] lg:min-h-[286px]">
            <Image
              src={card.image}
              alt={card.imageAlt}
              loading="lazy"
              widths={[420, 640, 880]}
              sizes="(max-width: 620px) calc(100vw - 3.75rem), (max-width: 1050px) 650px, 29vw"
              class="block aspect-[4/3] h-auto w-full object-cover object-center transition-transform duration-[280ms] group-hover:scale-[1.012] motion-reduce:transition-none"
            />
          </div>
        </article>
      ))}
    </div>

    <div class="mt-8 flex items-center justify-center gap-8 max-[620px]:gap-3.5">
      <span class="h-px w-[72px] bg-[#8790ad] max-[620px]:w-7" aria-hidden="true"></span>
      <a
        href="/request-reports"
        class="inline-flex min-h-11 items-center border-b border-[#35466e] pb-1.5 text-[13px] font-extrabold uppercase tracking-[0.12em] text-[#35466e] transition hover:text-[#0a9f86] max-[620px]:text-[11px]"
      >
        Get Sample Reports <b class="ml-[15px] text-lg font-medium" aria-hidden="true">→</b>
      </a>
      <span class="h-px w-[72px] bg-[#8790ad] max-[620px]:w-7" aria-hidden="true"></span>
    </div>
  </div>
</section>
