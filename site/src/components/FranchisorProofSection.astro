---
const without = [
  "Awards decided mostly on interview chemistry and gut feel",
  "No visibility into how a candidate handles pressure or ambiguity",
  "Onboarding and support plans that look the same for every owner",
  "Fit issues surface only after the agreement is signed",
];

const withZorakle = [
  "Objective, benchmarked insight into every candidate's fit",
  "A clear read on how each candidate learns, communicates, and performs",
  "Onboarding and support built around the individual owner",
  "Confidence in the decision, backed by evidence",
];
---

<section class="overflow-hidden border-b border-[#dce9e6] bg-white pt-12 md:pt-16">
  <div class="section-shell">
    <header class="text-center">
      <p class="section-eyebrow">The Shift in Decision-Making</p>
      <h2 class="section-title text-center">Move Past the Interview. See the Whole Candidate.</h2>
      <p class="section-copy mx-auto max-w-2xl text-center">
        A great conversation can only tell you so much. Objective insight fills in the rest&mdash;before the agreement is signed.
      </p>
    </header>
  </div>

  <div class="relative mt-12 md:mt-14">
    <div class="grid md:grid-cols-2">
      <div class="flex justify-center bg-[#f6f3ec] px-6 py-12 sm:px-10 md:justify-end md:py-16 md:pl-[max(1.5rem,calc((100vw-1240px)/2+1.5rem))] md:pr-10 lg:pr-16">
        <div class="w-full max-w-sm">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#a39c88]">Without Zorakle</p>
          <ul class="mt-5 flex flex-col gap-4">
            {without.map((item) => (
              <li class="flex items-start gap-3">
                <svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0 fill-none stroke-[#c4bca7] stroke-[2.2]" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="m9 9 6 6M15 9l-6 6" />
                </svg>
                <span class="text-[15px] leading-snug text-[#6b6656]">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="flex justify-center bg-[#087f65] px-6 py-12 text-white sm:px-10 md:justify-start md:py-16 md:pl-10 md:pr-[max(1.5rem,calc((100vw-1240px)/2+1.5rem))] lg:pl-16">
        <div class="w-full max-w-sm">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#8fe4cd]">With Zorakle</p>
          <ul class="mt-5 flex flex-col gap-4">
            {withZorakle.map((item) => (
              <li class="flex items-start gap-3">
                <svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0 fill-none stroke-white stroke-[2.4]" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="m8 12.5 2.7 2.7L16 9.5" />
                </svg>
                <span class="text-[15px] font-medium leading-snug text-white">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <span
      class="pointer-events-none absolute left-1/2 top-1/2 z-10 hidden size-14 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-4 border-white bg-[#17233e] text-xl font-bold text-white shadow-[0_10px_26px_rgba(23,35,62,0.35)] md:grid"
      aria-hidden="true"
    >
      &rarr;
    </span>
  </div>
</section>
