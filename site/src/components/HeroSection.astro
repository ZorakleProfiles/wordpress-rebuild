---
import heroBackground from "../assets/home-hero.png";
const hero = {
    eyebrow: "The Franchise Alignment Experts",
    titlePrefix: "Franchise Success Is Not Random.",
    titleAccent: "It’s Aligned.",
    description:
        "Zorakle helps franchisors build predictable, scalable franchise systems by aligning culture, values, systems, skills, and execution across the entire franchise lifecycle.",
    primaryCta: { href: "/solutions/franchisors", label: "I'm a Franchisor →" },
    secondaryCta: { href: "/solutions/brokers", label: "I'm a Broker →" }
};
import PageHero from "./PageHero.astro";
---

<PageHero
  eyebrow={hero.eyebrow}
  titlePrefix={hero.titlePrefix}
  titleHighlight={hero.titleAccent}
  description={hero.description}
  supportingLine={hero.supportingLine}
  primaryCta={hero.primaryCta}
  secondaryCta={hero.secondaryCta}
  backgroundImage={heroBackground}
  dark={true}
/>
