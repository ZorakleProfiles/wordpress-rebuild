---
import { Image } from "astro:assets";
import heroArtwork from "../assets/home-alignment-hero-v2.webp";
---

<section class="relative overflow-hidden border-b border-[#d9e5e2] bg-[#f7fcfb]">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_10%,rgba(9,204,156,0.12),transparent_36%)]" aria-hidden="true"></div>
  <div class="section-shell relative grid min-h-[650px] items-center gap-8 py-14 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:gap-8 lg:py-16">
    <div class="relative z-10 max-w-2xl">
      <p class="font-display text-sm font-bold uppercase tracking-[0.16em] text-[#087f65] sm:text-base">
        The science of franchisee fit
      </p>
      <h1 class="mt-6 font-display text-[clamp(2.8rem,4.15vw,4.25rem)] font-bold leading-[1.01] tracking-[-0.03em] text-[#17233e]">
        The Right Franchisee Doesn’t Just Look Good on Paper.
        <span class="block text-[#09a985]">They Fit Your System.</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-[#3b4961] md:text-lg">
        Zorakle gives franchisors science-based insight into how well each candidate aligns with the culture, expectations, and behaviors associated with success in their organization.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a class="btn-primary" href="/pricing">Sign Up Now <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="relative -mx-6 min-h-[420px] lg:-mr-16 lg:ml-0 lg:min-h-[590px]">
      <Image
        src={heroArtwork}
        alt="Right-fit franchise candidate connected to values, culture, systems, skills, and execution alignment"
        widths={[768, 1024, 1280, 1536]}
        sizes="(max-width: 1023px) 100vw, 62vw"
        class="absolute inset-0 h-full w-full object-cover object-right [mask-image:linear-gradient(to_right,transparent_0%,black_8%,black_100%)]"
        priority
      />
    </div>
  </div>
</section>
