---
const portalUrl = import.meta.env.PORTAL_URL || "http://localhost:3000";
---

<section class="bg-[#f3f3f3] py-8">
  <div class="section-shell">
    <div class="overflow-hidden">
      <div class="logo-ticker" id="logo-ticker" data-portal-url={portalUrl}>
        <!-- Logos will be loaded here -->
      </div>
    </div>
  </div>
</section>

<script>
  function restartLogoTicker() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const track = document.querySelector<HTMLElement>(".logo-ticker .logo-track");
    if (!track) return;

    // iOS Safari can leave CSS animations paused after dynamic insertion or a page-cache restore.
    track.style.setProperty("-webkit-animation", "none");
    track.style.animation = "none";
    void track.offsetWidth;
    track.style.removeProperty("-webkit-animation");
    track.style.removeProperty("animation");
  }

  async function loadLogos() {
    try {
      const ticker = document.getElementById("logo-ticker");
      if (!ticker) return;

      const portalUrl = ticker.getAttribute("data-portal-url");
      const endpoint = `${portalUrl}/website/logos`;

      console.log("Fetching logos from:", endpoint);
      const response = await fetch(endpoint);

      if (!response.ok) {
        console.error("Failed to fetch logos - Status:", response.status);
        return;
      }

      const data = await response.json();
      type BrandLogo = { logo_path: string; name?: string };
      const logos = (Array.isArray(data?.accounts) ? data.accounts : Array.isArray(data) ? data : []) as BrandLogo[];
      const brandLogos = logos.filter((logo: BrandLogo) => logo?.logo_path);

      if (brandLogos.length === 0) {
        console.error("No logos returned from endpoint");
        return;
      }

      const logoMarkup = brandLogos
        .map(
          (logo: BrandLogo) => `
            <div class="w-[200px] h-[100px] logo-item flex items-center justify-center backdrop-blur-sm">
              <div class="flex items-center justify-center p-3 w-full h-full">
                <img src="${logo.logo_path}" alt="${logo.name || "Brand logo"}" class="max-w-full max-h-full object-contain" />
              </div>
            </div>
          `
        )
        .join("");

      // Two identical groups let us animate exactly half-width with no visible seam.
      ticker.innerHTML = `
        <div class="logo-track" aria-label="Trusted brand logos">
          <div class="logo-group">${logoMarkup}</div>
          <div class="logo-group" aria-hidden="true">${logoMarkup}</div>
        </div>
      `;

      requestAnimationFrame(restartLogoTicker);
    } catch (error) {
      console.error("Failed to load brand logos:", error);
    }
  }

  loadLogos();

  window.addEventListener("pageshow", restartLogoTicker);
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") restartLogoTicker();
  });
</script>

<style is:global>
  .logo-ticker {
    overflow: hidden;
  }

  .logo-ticker .logo-track {
    display: flex;
    width: max-content;
    -webkit-animation: ticker-scroll 40s linear infinite;
    animation: ticker-scroll 40s linear infinite;
    -webkit-animation-play-state: running;
    animation-play-state: running;
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  .logo-ticker .logo-group {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }

  .logo-ticker .logo-item {
    flex-shrink: 0;
  }

  @keyframes ticker-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @-webkit-keyframes ticker-scroll {
    from {
      -webkit-transform: translate3d(0, 0, 0);
      transform: translate3d(0, 0, 0);
    }
    to {
      -webkit-transform: translate3d(-50%, 0, 0);
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-ticker .logo-track {
      -webkit-animation: none;
      animation: none;
    }
  }
</style>
