---
import { Image } from 'astro:assets';

interface Props {
  heading?: string;
  showHeading?: boolean;
  sectionClass?: string;
}

const {
  heading = "Franchise brands that use Zorakle",
  showHeading = false,
  sectionClass = "home-section-band border-b border-[#e1e8e6] bg-white"
} = Astro.props;

const portalUrl = import.meta.env.PORTAL_URL || "http://localhost:3000";

const imageModules = import.meta.glob('/src/assets/logos/*.{jpeg,jpg,png,gif,webp}', { eager: true });

// Order below is intentional and must be preserved as-given — do not sort or randomize.
const franchisorLogoOrder: [string, string][] = [
  ["beef-o-bradys.jpg", "Beef 'O' Brady's"],
  ["archadeck.png", "Archadeck"],
  ["dreammaker-kitchen-bath.png", "DreamMaker Kitchen & Bath"],
  ["office-pride.png", "Office Pride"],
  ["zaxbys.png", "Zaxby's"],
  ["tab.png", "TAB"],
  ["homewell-senior-care.png", "HomeWell Senior Care"],
  ["4ever-young.png", "4Ever Young"],
  ["mrs-fields-cookies.png", "Mrs Fields Cookies"],
  ["any-lab-test-now.png", "Any Lab Test Now"],
  ["ivy-kids.png", "Ivy Kids"],
  ["house-of-colour-v2.png", "House of Colour"],
  ["pacific-perks.jpg", "Pacific Perks"],
  ["alphagraphics.jpg", "AlphaGraphics"],
  ["mr-appliance.jpg", "Mr. Appliance"],
  ["wow-1-day-painting.png", "WOW1 Day Painting"],
  ["the-brass-tap.jpg", "Brass Tap"],
  ["milex-mr-transmission.png", "Milex - Mr. Transmission"],
  ["kidstrong.png", "Kidstrong"],
  ["voda.jpg", "Voda"],
  ["tcby.png", "TCBY"],
  ["squeegee-squad.jpg", "Squeegee Squad"],
  ["ar-homes-v2.png", "AR Homes"],
  ["fleet-feet.png", "Fleet Feet"],
  ["scooters-coffee.png", "Scooter's Coffee"],
  ["enviro-master-v2.png", "Enviro Master"],
  ["united-water-restoration.png", "United Water Restoration"],
  ["arcpoint.png", "ARCPoint"],
  ["servicemaster-v2.png", "ServiceMaster"]
];

const imagesByFilename: Record<string, any> = {};
for (const [path, image] of Object.entries(imageModules)) {
  imagesByFilename[path.split('/').pop() ?? ""] = image;
}

type LogoLimits = {
  desktop?: [number, number];
  mobile?: [number, number];
};

const logoLimits: Record<string, LogoLimits> = {
  "4ever-young": { desktop: [184, 84], mobile: [128, 62] },
  "house-of-colour-v2": { desktop: [216, 76], mobile: [152, 56] },
  "wow-1-day-painting": { desktop: [184, 84], mobile: [128, 62] },
  "scooters-coffee": { desktop: [184, 84], mobile: [128, 62] },
  "united-water-restoration": { desktop: [184, 84], mobile: [128, 62] },
  "ar-homes-v2": { desktop: [200, 76], mobile: [140, 56] },
  "servicemaster-v2": { desktop: [208, 76], mobile: [144, 56] },
  "office-pride": { desktop: [160, 76], mobile: [112, 56] },
  "milex-mr-transmission": { desktop: [164, 76], mobile: [116, 56] },
  "squeegee-squad": { desktop: [152, 64], mobile: [108, 48] }
};

function containedSize(width: number, height: number, limits: [number, number]) {
  const scale = Math.min(limits[0] / width, limits[1] / height);
  return {
    width: Math.round(width * scale * 100) / 100,
    height: Math.round(height * scale * 100) / 100
  };
}

// Keep both halves of the marquee identical and in the exact specified order.
const images = franchisorLogoOrder.map(([filename, alt]) => {
  const image = imagesByFilename[filename];
  const key = filename.replace(/\.[^.]+$/, "");
  const limits = logoLimits[key] ?? {};
  const desktop = containedSize(image.default.width, image.default.height, limits.desktop ?? [184, 76]);
  const mobile = containedSize(image.default.width, image.default.height, limits.mobile ?? [128, 56]);

  return {
    image,
    alt,
    key,
    style: `--logo-width:${desktop.width}px;--logo-render-height:${desktop.height}px;--logo-mobile-width:${mobile.width}px;--logo-mobile-height:${mobile.height}px`
  };
});
---

<section class={sectionClass} aria-labelledby="franchisor-logo-heading">
  <div class="section-shell">
    <h2
      id="franchisor-logo-heading"
      class:list={[
        showHeading
          ? "mb-5 text-center font-display text-xl font-bold text-[#1e2f43] md:text-2xl"
          : "sr-only"
      ]}
    >
      {heading}
    </h2>
    <div class="overflow-hidden">
      <div class="logo-ticker" id="logo-ticker" data-portal-url={portalUrl}>
        <div class="logo-track" aria-label="Trusted brand logos">

          {/* Main group for the loop */}
          <div class="logo-group">
            {images.map(({ image: img, alt, key, style }: any) => (
                <div class="logo-item" data-logo={key} style={style}>
                  <div class="logo-frame">
                    <Image src={img.default} alt={alt} class="max-w-full max-h-full object-contain" loading="eager" decoding="sync" />
                  </div>
                </div>
            ))}
          </div>

          {/* Identical cloned group for infinite animation tracking */}
          <div class="logo-group" aria-hidden="true">
            {images.map(({ image: img, key, style }: any) => (
                <div class="logo-item" data-logo={key} style={style}>
                  <div class="logo-frame">
                    <Image src={img.default} alt="" class="max-w-full max-h-full object-contain" loading="eager" decoding="sync" />
                  </div>
                </div>
            ))}
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function restartLogoTicker() {
    const track = document.querySelector<HTMLElement>('.logo-ticker .logo-track');
    if (!track) return;

    // iOS Safari can leave composited CSS animations paused after a page-cache
    // restore or after the browser returns from the background.
    track.style.setProperty('-webkit-animation', 'none');
    track.style.animation = 'none';
    void track.offsetWidth;
    track.style.removeProperty('-webkit-animation');
    track.style.removeProperty('animation');
  }

  requestAnimationFrame(restartLogoTicker);
  window.addEventListener('pageshow', restartLogoTicker);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') restartLogoTicker();
  });
</script>

<style is:global>
  .logo-ticker {
    --logo-gap: 2rem;
    --logo-height: 6.25rem;
    --ticker-duration: 72s;
    overflow: hidden;
    width: 100%;
  }

  .logo-ticker .logo-track {
    display: flex;
    width: max-content;
    -webkit-animation: ticker-scroll var(--ticker-duration) linear infinite;
    animation: ticker-scroll var(--ticker-duration) linear infinite;
    -webkit-animation-play-state: running;
    animation-play-state: running;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-transform: translate3d(0, 0, 0);
    transform: translateZ(0);
    will-change: transform;
  }

  .logo-ticker .logo-group {
    display: flex;
    align-items: center;
    gap: var(--logo-gap);
    padding-inline-end: var(--logo-gap);
    flex-shrink: 0;
  }

  .logo-ticker .logo-item {
    width: var(--logo-width);
    height: var(--logo-height);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .logo-ticker .logo-frame {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-ticker .logo-frame img {
    display: block;
    width: var(--logo-width);
    height: var(--logo-render-height);
    max-width: none;
    max-height: none;
  }

  @keyframes ticker-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @-webkit-keyframes ticker-scroll {
    from {
      -webkit-transform: translate3d(0, 0, 0);
      transform: translate3d(0, 0, 0);
    }
    to {
      -webkit-transform: translate3d(-50%, 0, 0);
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (max-width: 639px) {
    .logo-ticker {
      --logo-gap: 1.5rem;
      --logo-height: 5rem;
      --ticker-duration: 54s;
    }

    .logo-ticker .logo-item,
    .logo-ticker .logo-frame img {
      width: var(--logo-mobile-width);
    }

    .logo-ticker .logo-frame img {
      height: var(--logo-mobile-height);
    }
  }

</style>
