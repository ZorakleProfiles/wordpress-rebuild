---
import { Image } from 'astro:assets';

interface Props {
  heading?: string;
  showHeading?: boolean;
  sectionClass?: string;
}

const {
  heading = "Franchise brands that use Zorakle",
  showHeading = false,
  sectionClass = "border-b border-[#e1e8e6] bg-white py-8"
} = Astro.props;

const portalUrl = import.meta.env.PORTAL_URL || "http://localhost:3000";

const imageModules = import.meta.glob('/src/assets/logos/*.{jpeg,jpg,png,gif,webp}', { eager: true });

const franchisorLogos: Record<string, string> = {
  "4ever-young.png": "4Ever Young",
  "atwork-group.png": "@WORK Group",
  "beef-o-bradys.jpg": "Beef 'O' Brady's",
  "bubbas-famous-ice-cream.jpg": "Bubba's Famous Ice Cream",
  "caring-transitions.png": "Caring Transitions",
  "crust-pizza-co.jpg": "Crust Pizza Co.",
  "ducklings-early-learning-center.png": "Ducklings Early Learning Center",
  "enviro-master.png": "Enviro-Master",
  "exclusively-cabinets.png": "Exclusively Cabinets by Cabinetek",
  "gloria-jeans-coffees.png": "Gloria Jean's Coffees",
  "house-of-colour.png": "House of Colour",
  "iboost-talent.png": "iBoost Talent",
  "integrity-1st-car-pros.png": "Integrity 1st Car Pros",
  "la-ruta-del-cilantro-taqueria.png": "La Ruta del Cilantro Taqueria",
  "lice-clinics-of-america.jpg": "Lice Clinics of America",
  "little-lions-club.png": "Little Lions Club",
  "naturals-2-go.png": "Naturals2Go",
  "neuron-garage.png": "Neuron Garage",
  "pacific-perks.jpg": "Pacific Perks",
  "prime-senior-placement.png": "Prime Senior Placement",
  "saras-artisan-gelato.png": "Sara's Artisan Gelato",
  "sparkle-team.png": "Sparkle Team",
  "the-brass-tap.jpg": "The Brass Tap",
  "ultimate-ninjas.jpg": "Ultimate Ninjas",
  "vella-haus.jpg": "Vella Haus",
  "wow-1-day-painting.png": "WOW 1 Day Painting"
};

// Keep both halves of the marquee deterministic and pixel-identical.
const images = Object.entries(imageModules)
  .filter(([path]) => Object.hasOwn(franchisorLogos, path.split('/').pop() ?? ""))
  .sort(([firstPath], [secondPath]) => firstPath.localeCompare(secondPath))
  .map(([path, image]) => ({
    image,
    alt: franchisorLogos[path.split('/').pop() ?? ""]
  }));
---

<section class={sectionClass} aria-labelledby="franchisor-logo-heading">
  <div class="section-shell">
    <h2
      id="franchisor-logo-heading"
      class:list={[
        showHeading
          ? "mb-5 text-center font-display text-xl font-bold text-[#1e2f43] md:text-2xl"
          : "sr-only"
      ]}
    >
      {heading}
    </h2>
    <div class="overflow-hidden">
      <div class="logo-ticker" id="logo-ticker" data-portal-url={portalUrl}>
        <div class="logo-track" aria-label="Trusted brand logos">

          {/* Main group for the loop */}
          <div class="logo-group">
            {images.map(({ image: img, alt }: any) => (
                <div class="logo-item flex items-center justify-center">
                  <div class="flex items-center justify-center p-3 w-full h-full">
                    <Image src={img.default} alt={alt} class="max-w-full max-h-full object-contain" />
                  </div>
                </div>
            ))}
          </div>

          {/* Identical cloned group for infinite animation tracking */}
          <div class="logo-group" aria-hidden="true">
            {images.map(({ image: img }: any) => (
                <div class="logo-item flex items-center justify-center">
                  <div class="flex items-center justify-center p-3 w-full h-full">
                    <Image src={img.default} alt="" class="max-w-full max-h-full object-contain" />
                  </div>
                </div>
            ))}
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function restartLogoTicker() {
    const track = document.querySelector<HTMLElement>('.logo-ticker .logo-track');
    if (!track) return;

    // iOS Safari can leave composited CSS animations paused after a page-cache
    // restore or after the browser returns from the background.
    track.style.setProperty('-webkit-animation', 'none');
    track.style.animation = 'none';
    void track.offsetWidth;
    track.style.removeProperty('-webkit-animation');
    track.style.removeProperty('animation');
  }

  requestAnimationFrame(restartLogoTicker);
  window.addEventListener('pageshow', restartLogoTicker);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') restartLogoTicker();
  });
</script>

<style is:global>
  .logo-ticker {
    --logo-gap: 1rem;
    --logo-width: 12.5rem;
    --logo-height: 6.25rem;
    --ticker-duration: 72s;
    overflow: hidden;
    width: 100%;
  }

  .logo-ticker .logo-track {
    display: flex;
    width: max-content;
    -webkit-animation: ticker-scroll var(--ticker-duration) linear infinite;
    animation: ticker-scroll var(--ticker-duration) linear infinite;
    -webkit-animation-play-state: running;
    animation-play-state: running;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-transform: translate3d(0, 0, 0);
    transform: translateZ(0);
    will-change: transform;
  }

  .logo-ticker .logo-group {
    display: flex;
    gap: var(--logo-gap);
    padding-inline-end: var(--logo-gap);
    flex-shrink: 0;
  }

  .logo-ticker .logo-item {
    width: var(--logo-width);
    height: var(--logo-height);
    flex-shrink: 0;
  }

  @keyframes ticker-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @-webkit-keyframes ticker-scroll {
    from {
      -webkit-transform: translate3d(0, 0, 0);
      transform: translate3d(0, 0, 0);
    }
    to {
      -webkit-transform: translate3d(-50%, 0, 0);
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (max-width: 639px) {
    .logo-ticker {
      --logo-gap: 0.75rem;
      --logo-width: 9rem;
      --logo-height: 5rem;
      --ticker-duration: 54s;
    }
  }

</style>
