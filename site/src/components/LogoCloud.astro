---
import { Image } from 'astro:assets';

const portalUrl = import.meta.env.PORTAL_URL || "http://localhost:3000";

const imageModules = import.meta.glob('/src/assets/logos/*.{jpeg,jpg,png,gif,webp}', { eager: true });

// Keep both halves of the marquee deterministic and pixel-identical.
const images = Object.entries(imageModules)
  .sort(([firstPath], [secondPath]) => firstPath.localeCompare(secondPath))
  .map(([, image]) => image);
---

<section class="bg-[#f3f3f3] py-8">
  <div class="section-shell">
    <div class="overflow-hidden">
      <div class="logo-ticker" id="logo-ticker" data-portal-url={portalUrl}>
        <div class="logo-track" aria-label="Trusted brand logos">

          {/* Main group for the loop */}
          <div class="logo-group">
            {images.map((img: any) => (
                <div class="logo-item flex items-center justify-center">
                  <div class="flex items-center justify-center p-3 w-full h-full">
                    <Image src={img.default} alt="Brand logo" class="max-w-full max-h-full object-contain" />
                  </div>
                </div>
            ))}
          </div>

          {/* Identical cloned group for infinite animation tracking */}
          <div class="logo-group" aria-hidden="true">
            {images.map((img: any) => (
                <div class="logo-item flex items-center justify-center">
                  <div class="flex items-center justify-center p-3 w-full h-full">
                    <Image src={img.default} alt="" class="max-w-full max-h-full object-contain" />
                  </div>
                </div>
            ))}
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .logo-ticker {
    --logo-gap: 1rem;
    --logo-width: 12.5rem;
    --logo-height: 6.25rem;
    --ticker-duration: 72s;
    overflow: hidden;
    width: 100%;
  }

  .logo-ticker .logo-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll var(--ticker-duration) linear infinite;
    backface-visibility: hidden;
    transform: translateZ(0);
    will-change: transform;
  }

  .logo-ticker .logo-group {
    display: flex;
    gap: var(--logo-gap);
    padding-inline-end: var(--logo-gap);
    flex-shrink: 0;
  }

  .logo-ticker .logo-item {
    width: var(--logo-width);
    height: var(--logo-height);
    flex-shrink: 0;
  }

  @keyframes ticker-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @media (max-width: 639px) {
    .logo-ticker {
      --logo-gap: 0.75rem;
      --logo-width: 9rem;
      --logo-height: 5rem;
      --ticker-duration: 54s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-ticker .logo-track {
      animation: none;
    }
  }
</style>
