---
/**
 * Custom Portable Text image block component.
 * Registered as `components.types.image` in PortableText.
 * Receives the Sanity image block as `node`.
 */
import { urlFor } from "../utils/sanity.ts";

const { node } = Astro.props as { node: Record<string, unknown> };
let src: string | undefined;
try {
  src = urlFor(node).width(1200).fit("max").auto("format").url();
} catch {
  src = undefined;
}
const alt = (node.alt as string) || "";
const caption = (node.caption as string) || "";

// Sanity asset refs encode the source dimensions: `image-<id>-<W>x<H>-<ext>`.
// Pull them out so the <img> can reserve its space before loading and not
// shift the rest of the article down when it decodes (CLS).
const assetRef =
  (node.asset as { _ref?: string } | undefined)?._ref ??
  ((node as { _ref?: string })._ref);
const dimMatch =
  typeof assetRef === "string" ? assetRef.match(/-(\d+)x(\d+)-/) : null;
const width = dimMatch ? Number(dimMatch[1]) : undefined;
const height = dimMatch ? Number(dimMatch[2]) : undefined;
---

{src && (
  <figure class="my-8">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      class="h-auto w-full rounded-xl"
      loading="lazy"
      decoding="async"
    />
    {caption && (
      <figcaption class="mt-2 text-center text-sm text-[#56586a]">{caption}</figcaption>
    )}
  </figure>
)}
