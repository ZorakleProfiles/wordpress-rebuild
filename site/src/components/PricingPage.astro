---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import {Partners} from "../data/pricing.ts";
import { Image } from "astro:assets";
import {
  accountTypes,
  billingOptions,
  tiers,
  type PartnerKey,
  type PricingAudience,
} from "../data/pricing";

interface Props {
  audience?: PricingAudience;
  partner?: PartnerKey;
}

const { audience = "all", partner } = Astro.props;
const isCombined = audience === "all";
const defaultPageMeta = {
  all: {
    title: "Pricing | Zorakle",
    heading: "Build the plan that fits",
    description: "Start with your role, then choose the account and billing option that work for you.",
  },
  broker: {
    title: "Broker Pricing | Zorakle",
    heading: "Broker plans",
    description: "Choose a subscription or pay only when you run an assessment.",
  },
  franchisor: {
    title: "Franchisor Pricing | Zorakle",
    heading: "Franchisor plans",
    description: "Choose the account designed for your system, then select how you want to pay.",
  },
}[audience];
const partnerMeta = Partners[partner ?? ""];
const pageMeta = partnerMeta ?? defaultPageMeta;
const portalUrl = import.meta.env.PORTAL_URL ?? "https://portal.zorakle.net";
const registrationApiUrl = new URL("/api/website-registration", portalUrl).href;
const couponPreviewUrl = new URL("/api/check-coupon", portalUrl).href;
---

<MainLayout title={pageMeta.title} description={pageMeta.description}>
  <SiteHeader />

  <main
    class="min-h-screen bg-white"
    data-pricing-configurator
    data-audience={audience}
    data-partner={partner}
    data-registration-api-url={registrationApiUrl}
    data-coupon-preview-url={couponPreviewUrl}
  >
    <div class="mx-auto w-[min(1400px,calc(100%-2rem))] py-12">
      <header class="mb-12 border-b border-[#d1d4dd] pb-10">
        <div class="max-w-3xl">
          {partnerMeta?.logo && <Image src={partnerMeta.logo} alt={partnerMeta.logoAlt} class="mb-6 h-14 w-auto object-contain object-left" />}
          <p class="section-eyebrow">{partner ? "Partner offer" : "Pricing"}</p>
          <h1 class="page-title mt-3">{pageMeta.heading}</h1>
          <p class="section-copy max-w-2xl">{pageMeta.description}</p>
        </div>
      </header>

      <div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <form id="pricing-form" class="space-y-12" data-plan-form novalidate>
            <section class:list={{ hidden: !isCombined }} aria-labelledby="account-type-heading">
              <div class="mb-8 flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#22252a] text-sm font-bold text-white">1</div>
                <h2 id="account-type-heading" class="text-2xl font-bold text-[#22252a]">I am a...</h2>
              </div>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                {(["franchisor", "broker"] as const).map((accountType) => {
                  const account = accountTypes[accountType];
                  return (
                    <label class="cursor-pointer">
                      <input type="radio" name="account-type" value={accountType} class="sr-only" data-account-type-input />
                      <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg" data-account-type-option={accountType}>
                        <h3 class="mb-2 text-lg font-bold text-[#22252a]">{account.name}</h3>
                        <p class="text-base leading-relaxed text-[#56586a]">{account.description}</p>
                      </div>
                    </label>
                  );
                })}
              </div>
            </section>

            <section
              data-tier-section="franchisor"
              class:list={{ hidden: audience !== "franchisor" }}
              aria-labelledby="account-tier-heading"
            >
              <div class="mb-8 flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#22252a] text-sm font-bold text-white">{isCombined ? "2" : "1"}</div>
                <h2 id="account-tier-heading" class="text-2xl font-bold text-[#22252a]">My account type</h2>
              </div>
              <p class="mb-6 text-base text-[#56586a]">Each one adds to the one above it.</p>

              <div class="space-y-4">
                {tiers.map((tier) => (
                  <label class="block cursor-pointer">
                    <input type="radio" name="tier" value={tier.key} class="sr-only" data-tier-input />
                    <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg" data-tier-option={tier.key}>
                      <div class="mb-4 flex items-start justify-between">
                        <div class="flex-1">
                          <div class="mb-2 flex flex-wrap items-center gap-2">
                            <h3 class="text-lg font-bold text-[#22252a]">{tier.name}</h3>
                            <span class="text-xs font-semibold uppercase tracking-wider text-[#56586a]">{tier.segment}</span>
                          </div>
                          <p class="text-base leading-relaxed text-[#56586a]">{tier.description}</p>
                        </div>
                      </div>
                      <div class="space-y-2">
                        {tier.features.map((feature) => (
                          <div class="flex items-start gap-2">
                            <span class="mt-0.5 text-base text-[#087f65]" aria-hidden="true">✓</span>
                            <span class="text-base text-[#22252a]">{feature}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </label>
                ))}
              </div>
            </section>

            <section data-billing-wrapper class:list={{ hidden: isCombined }} aria-labelledby="billing-heading">
              <div class="mb-8 flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#22252a] text-sm font-bold text-white" data-billing-step>
                  {audience === "broker" ? "1" : isCombined ? "3" : "2"}
                </div>
                <h2 id="billing-heading" class="text-2xl font-bold text-[#22252a]">How I want to pay</h2>
              </div>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                {billingOptions.map((billing) => (
                  <label class="cursor-pointer" data-billing-card>
                    <input type="radio" name="billing" value={billing.key} class="sr-only" data-billing-input />
                    <div class="relative flex h-full flex-col rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg" data-billing-option={billing.key}>
                      <div class="absolute -top-3 right-4 hidden w-fit rounded bg-[#09cc9c] px-2 py-1 text-xs font-bold text-[#22252a]" data-billing-badge></div>
                      <h3 class="mb-2 text-lg font-bold text-[#22252a]" data-billing-name={billing.key}>{billing.name}</h3>
                      <div class="mb-2 text-xl font-bold text-[#22252a]" data-billing-price>Select an account</div>
                      <p class="text-base leading-relaxed text-[#56586a]" data-billing-description>Choose an account to see this option.</p>
                    </div>
                  </label>
                ))}
              </div>
            </section>

          </form>

          <section class="hidden" data-account-details aria-labelledby="account-details-heading">
            <button type="button" class="mb-8 font-bold text-[#087f65] hover:underline" data-checkout-back>← Back to plans</button>
            <div class="mb-8 flex items-center gap-3">
              <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#22252a] text-sm font-bold text-white">2</div>
              <h2 id="account-details-heading" class="text-2xl font-bold text-[#22252a]">Create your account</h2>
            </div>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <label class="block text-sm font-bold text-[#22252a]">First name
                <input name="first_name" autocomplete="given-name" required class="mt-2 w-full rounded-xl border border-[#b9bdc7] px-4 py-3 text-base font-normal outline-none focus:border-[#09a982] focus:ring-2 focus:ring-[#09cc9c]/20" data-registration-field />
              </label>
              <label class="block text-sm font-bold text-[#22252a]">Last name
                <input name="last_name" autocomplete="family-name" required class="mt-2 w-full rounded-xl border border-[#b9bdc7] px-4 py-3 text-base font-normal outline-none focus:border-[#09a982] focus:ring-2 focus:ring-[#09cc9c]/20" data-registration-field />
              </label>
              <label class="block text-sm font-bold text-[#22252a] sm:col-span-2">Business name
                <input name="account_name" autocomplete="organization" required class="mt-2 w-full rounded-xl border border-[#b9bdc7] px-4 py-3 text-base font-normal outline-none focus:border-[#09a982] focus:ring-2 focus:ring-[#09cc9c]/20" data-registration-field />
              </label>
              <label class="block text-sm font-bold text-[#22252a] sm:col-span-2">Email address
                <input name="email" type="email" autocomplete="email" required class="mt-2 w-full rounded-xl border border-[#b9bdc7] px-4 py-3 text-base font-normal outline-none focus:border-[#09a982] focus:ring-2 focus:ring-[#09cc9c]/20" data-registration-field />
              </label>
              <label class="block text-sm font-bold text-[#22252a]">Password
                <input name="password" type="password" autocomplete="new-password" minlength="8" required class="mt-2 w-full rounded-xl border border-[#b9bdc7] px-4 py-3 text-base font-normal outline-none focus:border-[#09a982] focus:ring-2 focus:ring-[#09cc9c]/20" data-registration-field />
              </label>
              <label class="block text-sm font-bold text-[#22252a]">Confirm password
                <input name="password_confirmation" type="password" autocomplete="new-password" minlength="8" required class="mt-2 w-full rounded-xl border border-[#b9bdc7] px-4 py-3 text-base font-normal outline-none focus:border-[#09a982] focus:ring-2 focus:ring-[#09cc9c]/20" data-registration-field />
              </label>
            </div>
          </section>

          <section class="hidden" data-payment-details aria-labelledby="payment-details-heading">
            <button type="button" class="mb-8 font-bold text-[#087f65] hover:underline" data-payment-back>← Back to account details</button>
            <div class="mb-8 flex items-center gap-3">
              <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#22252a] text-sm font-bold text-white">3</div>
              <h2 id="payment-details-heading" class="text-2xl font-bold text-[#22252a]">Payment details</h2>
            </div>
            <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6" data-payment-element></div>
            <p class="mt-4 text-sm text-[#56586a]">Your payment details are securely collected by Stripe and never pass through Zorakle’s servers.</p>
          </section>
        </div>

        <aside class="lg:col-span-1">
          <div class="rounded-3xl border-2 border-[#d1d4dd] bg-[#f0fffe] p-8 text-[#22252a] lg:sticky lg:top-32">
            <div class="mb-2 text-xs uppercase tracking-widest text-[#56586a]">Your plan</div>
            <h2 class="mb-4 text-3xl font-bold" data-summary-title>Build your plan</h2>

            <div class="space-y-4 border-b border-[#d1d4dd] pb-4">
              <div>
                <div class="mb-1 text-xs uppercase tracking-widest text-[#56586a]" data-summary-rate-label>Subscription</div>
                <div class="hidden text-xs font-semibold text-[#56586a] line-through" data-summary-rate-original></div>
                <div class="text-base font-semibold" data-summary-rate>Not selected</div>
              </div>
              <div class="hidden" data-summary-partner-row>
                <div class="mb-1 text-xs uppercase tracking-widest text-[#56586a]">Membership benefit</div>
                <div class="text-base font-semibold text-[#087f65]" data-summary-partner></div>
              </div>
              <div class="hidden" data-summary-setup-row>
                <div class="mb-1 text-xs uppercase tracking-widest text-[#56586a]">One-time setup</div>
                <div class="text-base font-semibold" data-summary-setup></div>
              </div>
            </div>

            <div class="my-8">
              <div class="mb-3 text-xs uppercase tracking-widest text-[#56586a]">Due today</div>
              <div class="text-2xl font-bold" data-summary-price>—</div>
              <p class="mt-3 text-sm text-[#56586a]" data-summary-note>Make your selections to continue.</p>
            </div>

            <div class="mb-6 border-t border-[#d1d4dd] pt-6" data-coupon-section>
              <label for="pricing-coupon" class="mb-2 block text-base font-bold">
                Coupon code <span class="font-normal text-[#56586a]">(optional)</span>
              </label>
              <div class="flex gap-2">
                <input
                  id="pricing-coupon"
                  type="text"
                  name="coupon"
                  maxlength="64"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  placeholder="Enter coupon code"
                  class="min-w-0 flex-1 rounded-xl border border-[#b9bdc7] bg-white px-4 py-3 text-base font-semibold uppercase outline-none transition placeholder:font-normal placeholder:normal-case placeholder:text-[#56586a] focus:border-[#09a982] focus:ring-2 focus:ring-[#09cc9c]/20 disabled:cursor-not-allowed disabled:bg-[#f4f5f7] disabled:text-[#56586a]"
                  data-coupon-input
                />
                <button
                  type="button"
                  class="rounded-xl border border-[#22252a] bg-white px-4 py-3 text-sm font-bold transition hover:bg-[#22252a] hover:text-white disabled:cursor-not-allowed disabled:border-[#d1d4dd] disabled:bg-[#f4f5f7] disabled:text-[#8b8f99]"
                  data-coupon-apply
                  disabled
                >
                  Apply
                </button>
              </div>
              <p class="mt-2 text-sm text-[#56586a]" data-coupon-status aria-live="polite">Choose a plan, then apply your code.</p>
            </div>

            <div class="mb-4 hidden rounded-xl border border-[#f3b4ad] bg-[#fff4f2] p-4 text-sm text-[#8a1c13]" data-checkout-error role="alert"></div>

            <button
              type="button"
              class="mb-4 w-full rounded-2xl bg-[#fd7730] py-4 font-bold text-[#22252a] transition hover:bg-[#e56620] disabled:cursor-not-allowed disabled:bg-[#d1d4dd] disabled:text-[#56586a]"
              data-continue-btn
              disabled
            >
              Continue to your details →
            </button>

            <p class="text-center text-sm leading-relaxed text-[#56586a]" data-summary-footnote>
              Your final plan and billing details will be confirmed before checkout.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <SiteFooter />
</MainLayout>

<script>
  import "../scripts/pricing-configurator";
</script>
