---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import {
  accountTypes,
  billingOptions,
  partnerOrganizations,
  tiers,
  type PricingAudience,
} from "../data/pricing";

interface Props {
  audience?: PricingAudience;
}

const { audience = "all" } = Astro.props;
const isCombined = audience === "all";
const pageMeta = {
  all: {
    title: "Pricing | Zorakle",
    heading: "Build the plan that fits",
    description: "Start with your role, then choose the account and billing option that work for you.",
  },
  broker: {
    title: "Broker Pricing | Zorakle",
    heading: "Broker plans",
    description: "Choose a subscription or pay only when you run an assessment.",
  },
  franchisor: {
    title: "Franchisor Pricing | Zorakle",
    heading: "Franchisor plans",
    description: "Choose the account designed for your system, then select how you want to pay.",
  },
}[audience];
const portalUrl = import.meta.env.PORTAL_URL ?? "https://portal.zorakle.net";
const portalRegistrationUrl = new URL("/register", portalUrl).href;
const couponPreviewUrl = new URL("/api/check-coupon", portalUrl).href;
---

<MainLayout title={pageMeta.title} description={pageMeta.description}>
  <SiteHeader />

  <main
    class="min-h-screen bg-white"
    data-pricing-configurator
    data-audience={audience}
    data-portal-registration-url={portalRegistrationUrl}
    data-coupon-preview-url={couponPreviewUrl}
  >
    <div class="mx-auto w-[min(1400px,calc(100%-2rem))] py-12">
      <header class="mb-12 border-b border-[#d1d4dd] pb-10">
        <div class="max-w-3xl">
          <p class="section-eyebrow">Pricing</p>
          <h1 class="section-title">{pageMeta.heading}</h1>
          <p class="section-copy max-w-2xl">{pageMeta.description}</p>
        </div>
      </header>

      <div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <form id="pricing-form" class="space-y-12">
            <section class:list={{ hidden: !isCombined }} aria-labelledby="account-type-heading">
              <div class="mb-8 flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#22252a] text-sm font-bold text-white">1</div>
                <h2 id="account-type-heading" class="text-2xl font-bold text-[#22252a]">I am a...</h2>
              </div>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                {(["franchisor", "broker"] as const).map((accountType) => {
                  const account = accountTypes[accountType];
                  return (
                    <label class="cursor-pointer">
                      <input type="radio" name="account-type" value={accountType} class="sr-only" data-account-type-input />
                      <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg" data-account-type-option={accountType}>
                        <h3 class="mb-2 text-lg font-bold text-[#22252a]">{account.name}</h3>
                        <p class="text-sm text-[#72767e]">{account.description}</p>
                      </div>
                    </label>
                  );
                })}
              </div>
            </section>

            <section
              data-tier-section="franchisor"
              class:list={{ hidden: audience !== "franchisor" }}
              aria-labelledby="account-tier-heading"
            >
              <div class="mb-8 flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#22252a] text-sm font-bold text-white">{isCombined ? "2" : "1"}</div>
                <h2 id="account-tier-heading" class="text-2xl font-bold text-[#22252a]">My account type</h2>
              </div>
              <p class="mb-6 text-sm text-[#72767e]">Each one adds to the one above it.</p>

              <div class="space-y-4">
                {tiers.map((tier) => (
                  <label class="block cursor-pointer">
                    <input type="radio" name="tier" value={tier.key} class="sr-only" data-tier-input />
                    <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg" data-tier-option={tier.key}>
                      <div class="mb-4 flex items-start justify-between">
                        <div class="flex-1">
                          <div class="mb-2 flex flex-wrap items-center gap-2">
                            <h3 class="text-lg font-bold text-[#22252a]">{tier.name}</h3>
                            <span class="text-xs font-semibold uppercase tracking-wider text-[#72767e]">{tier.segment}</span>
                          </div>
                          <p class="text-sm text-[#72767e]">{tier.description}</p>
                        </div>
                      </div>
                      <div class="space-y-2">
                        {tier.features.map((feature) => (
                          <div class="flex items-start gap-2">
                            <span class="mt-0.5 text-sm text-[#09cc9c]" aria-hidden="true">✓</span>
                            <span class="text-sm text-[#22252a]">{feature}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </label>
                ))}
              </div>
            </section>

            <section data-billing-wrapper class:list={{ hidden: isCombined }} aria-labelledby="billing-heading">
              <div class="mb-8 flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#22252a] text-sm font-bold text-white" data-billing-step>
                  {audience === "broker" ? "1" : isCombined ? "3" : "2"}
                </div>
                <h2 id="billing-heading" class="text-2xl font-bold text-[#22252a]">How I want to pay</h2>
              </div>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                {billingOptions.map((billing) => (
                  <label class="cursor-pointer" data-billing-card>
                    <input type="radio" name="billing" value={billing.key} class="sr-only" data-billing-input />
                    <div class="relative flex h-full flex-col rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg" data-billing-option={billing.key}>
                      <div class="absolute -top-3 right-4 hidden w-fit rounded bg-[#09cc9c] px-2 py-1 text-xs font-bold text-white" data-billing-badge></div>
                      <h3 class="mb-2 text-lg font-bold text-[#22252a]" data-billing-name={billing.key}>{billing.name}</h3>
                      <div class="mb-2 text-xl font-bold text-[#22252a]" data-billing-price>Select an account</div>
                      <p class="text-sm text-[#72767e]" data-billing-description>Choose an account to see this option.</p>
                    </div>
                  </label>
                ))}
              </div>
            </section>

            <section class="hidden" data-organization-section aria-labelledby="organization-heading">
              <div class="mb-5 flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#22252a] text-sm font-bold text-white" data-organization-step>
                  {audience === "franchisor" ? "4" : "3"}
                </div>
                <h2 id="organization-heading" class="text-2xl font-bold text-[#22252a]">Organization membership</h2>
              </div>
              <p class="mb-5 text-sm text-[#72767e]">Are you a member of any of these organizations? Select all that apply.</p>

              <details class="relative" data-organization-picker>
                <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl border-2 border-[#d1d4dd] bg-white px-5 py-4 font-semibold text-[#22252a] transition hover:border-[#09cc9c]">
                  <span data-organization-summary>No organizations selected</span>
                  <span class="ml-4 text-[#72767e]" aria-hidden="true">⌄</span>
                </summary>
                <div class="absolute z-20 mt-2 w-full rounded-xl border border-[#d1d4dd] bg-white p-2 shadow-xl">
                  {partnerOrganizations.map((organization) => (
                    <label class="flex cursor-pointer items-start gap-3 rounded-lg px-3 py-3 transition hover:bg-[#f0fffe]">
                      <input
                        type="checkbox"
                        name="organization"
                        value={organization.key}
                        class="mt-0.5 h-4 w-4 accent-[#09cc9c]"
                        data-organization-input
                      />
                      <span class="min-w-0 flex-1">
                        <span class="block text-sm font-bold text-[#22252a]">{organization.name}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </details>
            </section>
          </form>
        </div>

        <aside class="lg:col-span-1">
          <div class="rounded-3xl border-2 border-[#d1d4dd] bg-[#f0fffe] p-8 text-[#22252a] lg:sticky lg:top-32">
            <div class="mb-2 text-xs uppercase tracking-widest text-[#72767e]">Your plan</div>
            <h2 class="mb-4 text-3xl font-bold" data-summary-title>Build your plan</h2>

            <div class="space-y-4 border-b border-[#d1d4dd] pb-4">
              <div>
                <div class="mb-1 text-xs uppercase tracking-widest text-[#72767e]" data-summary-rate-label>Subscription</div>
                <div class="hidden text-xs font-semibold text-[#72767e] line-through" data-summary-rate-original></div>
                <div class="text-sm font-semibold" data-summary-rate>Not selected</div>
              </div>
              <div class="hidden" data-summary-partner-row>
                <div class="mb-1 text-xs uppercase tracking-widest text-[#72767e]">Membership benefit</div>
                <div class="text-sm font-semibold text-[#087f65]" data-summary-partner></div>
              </div>
              <div class="hidden" data-summary-setup-row>
                <div class="mb-1 text-xs uppercase tracking-widest text-[#72767e]">One-time setup</div>
                <div class="text-sm font-semibold" data-summary-setup></div>
              </div>
            </div>

            <div class="my-8">
              <div class="mb-3 text-xs uppercase tracking-widest text-[#72767e]">Due today</div>
              <div class="text-2xl font-bold" data-summary-price>—</div>
              <p class="mt-3 text-xs text-[#72767e]" data-summary-note>Make your selections to continue.</p>
            </div>

            <div class="mb-6 border-t border-[#d1d4dd] pt-6">
              <label for="pricing-coupon" class="mb-2 block text-sm font-bold">
                Coupon code <span class="font-normal text-[#72767e]">(optional)</span>
              </label>
              <div class="flex gap-2">
                <input
                  id="pricing-coupon"
                  type="text"
                  name="coupon"
                  maxlength="64"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  placeholder="Enter coupon code"
                  class="min-w-0 flex-1 rounded-xl border border-[#b9bdc7] bg-white px-4 py-3 text-sm font-semibold uppercase outline-none transition placeholder:font-normal placeholder:normal-case placeholder:text-[#8b8f99] focus:border-[#09a982] focus:ring-2 focus:ring-[#09cc9c]/20 disabled:cursor-not-allowed disabled:bg-[#f4f5f7] disabled:text-[#8b8f99]"
                  data-coupon-input
                />
                <button
                  type="button"
                  class="rounded-xl border border-[#22252a] bg-white px-4 py-3 text-sm font-bold transition hover:bg-[#22252a] hover:text-white disabled:cursor-not-allowed disabled:border-[#d1d4dd] disabled:bg-[#f4f5f7] disabled:text-[#8b8f99]"
                  data-coupon-apply
                  disabled
                >
                  Apply
                </button>
              </div>
              <p class="mt-2 text-xs text-[#72767e]" data-coupon-status aria-live="polite">Choose a plan, then apply your code.</p>
            </div>

            <button
              type="button"
              class="mb-4 w-full rounded-2xl bg-[#fd7730] py-4 font-bold transition hover:bg-[#e56620] disabled:cursor-not-allowed disabled:bg-[#d1d4dd] disabled:text-[#72767e]"
              data-continue-btn
              disabled
            >
              Continue to your details →
            </button>

            <p class="text-center text-xs leading-relaxed text-[#72767e]" data-summary-footnote>
              Your final plan and billing details will be confirmed before checkout.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <SiteFooter />
</MainLayout>

<script>
  import "../scripts/pricing-configurator";
</script>
