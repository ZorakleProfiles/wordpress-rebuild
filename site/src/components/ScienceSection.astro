---
import Video from "./Video.astro";
import sciencePoster from "../assets/sciences-poster.png";
---

<section class="bg-white relative overflow-hidden py-20 md:py-24">

  <div class="section-shell">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <!-- Left content -->
      <div class="space-y-6 ">
         <p class="eyebrow-accent font-display text-lg md:text-2xl font-medium">The Science</p>
        <h2 class="section-title">
          Backed by seven sciences.<br />Validated by decades of research.
        </h2>
        <p class="text-lg leading-relaxed">
          Stanford. Harvard Business School. Gallup. University of Michigan. The frameworks behind Zorakle don't come from a single proprietary algorithm — they come from the most validated work in psychology, organizational behavior, and performance science. We integrate seven of them. That's why Zorakle predicts what others can't.
        </p>
      </div>

      <!-- Right: Science overview video -->
      <Video
        poster={sciencePoster}
        posterAlt="Zorakle Science: The Science Behind Franchise Success"
        videoId="1037075151"
        playLabel="Play the Zorakle science overview"
        modalTitle="Zorakle science overview"
        frameClass="rounded-3xl border border-white/20 bg-[#111419] shadow-2xl"
      />
    </div>
    <div class="mt-8">
      <a class="btn-primary" href="/science">Learn More</a>
    </div>
  </div>
</section>
