---
/**
 * Shared testimonial card used by the carousel and the testimonials page.
 * Base card styles live here; consumers may layer layout/animation overrides
 * via the `class` prop (e.g. carousel state classes).
 */
interface Props {
  name: string;
  company: string;
  type: string;
  quote: string;
  class?: string;
  dataIndex?: number;
}

const { name, company, type, quote, class: className = "", dataIndex } = Astro.props;
const typeModifier = type.trim().toLowerCase() === "broker" ? "is-broker" : "is-franchisor";
---

<article class:list={["testimonial-card", typeModifier, className]} data-index={dataIndex}>

  <div class="testimonial-card-head">
    <div class="min-w-0">
      <p class="truncate text-base font-bold text-[#22252a]">{name}</p>
      <p class="truncate text-sm text-[#3b3e47]">{company}</p>
    </div>
    <p class:list={["testimonial-type", typeModifier]}>{type}</p>
  </div>

  <p class="testimonial-quote mt-4 text-sm leading-6 text-[#22252a] md:text-[0.95rem] md:leading-7">{quote}</p>
</article>

<style>
  .testimonial-card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    background-color: white;
    /* background: linear-gradient(160deg, #ffffff 0%, #f3f3f3 65%); */
    padding: 1.1rem;
    min-height: 13.5rem;
    box-shadow: 0 10px 28px -12px rgba(34, 37, 42, 0.28);
    transition: border-color 220ms ease, box-shadow 220ms ease;
  }

  /* Type-colored top border: green for brokers, orange for franchisors. */
  .testimonial-card.is-broker {
    border-top: 3px solid #09cc9c;
  }

  .testimonial-card.is-franchisor {
    border-top: 3px solid #fd7730;
  }



  .testimonial-card-head {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  /* Color-coded audience badge. */
  .testimonial-type {
    margin: 0;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    padding: 0.22rem 0.6rem;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .testimonial-type.is-broker {
    color: #0b7a61;
    background: #ecfdf8;
    border: 1px solid #a8ecd9;
  }

  .testimonial-type.is-franchisor {
    color: #b34e12;
    background: #fff4ee;
    border: 1px solid #fbd3ba;
  }

  .testimonial-quote {
    position: relative;
  }

  @media (min-width: 1024px) {
    .testimonial-card {
      min-height: 14.5rem;
      padding: 1.3rem;
    }
  }
</style>
