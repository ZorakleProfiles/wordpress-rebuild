---
/**
 * Shared testimonial card used by the carousel and the testimonials page.
 * Base card styles live here; consumers may layer layout/animation overrides
 * via the `class` prop (e.g. carousel state classes).
 */
interface Props {
  name: string;
  company: string;
  type: string;
  quote: string;
  variant?: "default" | "showcase";
  expanded?: boolean;
  class?: string;
  dataIndex?: number;
}

const { name, company, type, quote, variant = "showcase", expanded = false, class: className = "", dataIndex } = Astro.props;
const typeModifier = type.trim().toLowerCase() === "broker" ? "is-broker" : "is-franchisor";
const variantModifier = variant === "showcase" ? "is-showcase" : "";
const expandedModifier = expanded ? "is-expanded" : "";
---

<article class:list={["testimonial-card", typeModifier, variantModifier, expandedModifier, className]} data-index={dataIndex}>

  {variant === "showcase" && <span class="testimonial-quote-mark" aria-hidden="true">“</span>}

  <div class="testimonial-card-head">
    <div class="min-w-0">
      <p class="truncate text-base font-bold text-[#22252a]">{name}</p>
      <p class="truncate text-sm text-[#56586a]">{company}</p>
    </div>
    <p class:list={["testimonial-type", typeModifier]}>{type}</p>
  </div>

  <p class="testimonial-quote mt-4 text-base leading-relaxed text-[#22252a]">{quote}</p>
</article>

<style is:global>
  .testimonial-card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    background-color: white;
    /* background: linear-gradient(160deg, #ffffff 0%, #f3f3f3 65%); */
    padding: 1.1rem;
    min-height: 13.5rem;
    box-shadow: 0 10px 28px -12px rgba(34, 37, 42, 0.28);
    transition: border-color 220ms ease, box-shadow 220ms ease;
  }

  /* Type-colored top border: green for brokers, orange for franchisors. */
  .testimonial-card.is-broker {
    border-top: 3px solid #09cc9c;
  }

  .testimonial-card.is-franchisor {
    border-top: 3px solid #fd7730;
  }



  .testimonial-card-head {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  /* Color-coded audience badge. */
  .testimonial-type {
    margin: 0;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    padding: 0.22rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .testimonial-type.is-broker {
    color: #0b7a61;
    background: #ecfdf8;
    border: 1px solid #a8ecd9;
  }

  .testimonial-type.is-franchisor {
    color: #b34e12;
    background: #fff4ee;
    border: 1px solid #fbd3ba;
  }

  .testimonial-quote {
    position: relative;
  }

  .testimonial-card.is-showcase {
    display: flex;
    min-height: 16.5rem;
    flex-direction: column;
    border-right: 1px solid #dde7e4;
    border-bottom: 1px solid #dde7e4;
    border-left: 1px solid #dde7e4;
    border-radius: 0.75rem;
    padding: 1.65rem 1.65rem 1.45rem 3.85rem;
    box-shadow: 0 12px 30px rgba(43, 75, 67, 0.07);
  }

  .is-showcase .testimonial-quote-mark {
    position: absolute;
    left: 1.25rem;
    top: 0.9rem;
    color: #bcebe2;
    font-family: Georgia, serif;
    font-size: 4.4rem;
    font-weight: 700;
    line-height: 1;
  }

  .is-showcase .testimonial-quote {
    order: 1;
    display: -webkit-box;
    margin-top: 0;
    overflow: hidden;
    color: #4d587d;
    font-size: 1rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
  }

  .is-showcase.is-expanded .testimonial-quote {
    display: block;
    overflow: visible;
    -webkit-line-clamp: unset;
  }

  .is-showcase .testimonial-card-head {
    order: 2;
    display: flex;
    margin-top: auto;
    padding-top: 1.2rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .is-showcase .testimonial-card-head > div p:first-child {
    color: #171b2c;
    font-size: 1rem;
  }

  .is-showcase .testimonial-card-head > div p:last-child {
    color: #59617c;
  }

  .is-showcase .testimonial-type {
    border: 0;
    padding: 0.32rem 1.15rem;
    font-size: 0.7rem;
    letter-spacing: 0.13em;
  }

  .is-showcase .testimonial-type.is-broker {
    background: #d5f4ed;
    color: #078d73;
  }

  .is-showcase .testimonial-type.is-franchisor {
    background: #fff0e8;
    color: #e85d1a;
  }

  @media (min-width: 1024px) {
    .testimonial-card {
      min-height: 14.5rem;
      padding: 1.3rem;
    }
  }
</style>
