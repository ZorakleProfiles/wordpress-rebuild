---
import TestimonialCarousel from "./TestimonialCarousel.astro";

type TestimonialFilterType = "brokers" | "franchisors" | null;

interface Props {
  type?: TestimonialFilterType;
  limit?: number;
}

const { type = null, limit } = Astro.props;
---

<section id="testimonials" class="home-section bg-[#f7fbfa]">
  <div class="section-shell">
    <div class="text-left">
      <p class="section-eyebrow">Real Systems. Real Results.</p>
      <h2 class="section-title">
        Franchise Leaders Use Zorakle to Make Their Biggest Decisions.
      </h2>
      <p class="section-copy max-w-147.5">
        See what greater clarity and stronger alignment look like in practice.
      </p>
    </div>

    <TestimonialCarousel type={type} limit={limit} variant="showcase" />
  </div>
</section>
