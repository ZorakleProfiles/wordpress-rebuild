---
import type { ImageMetadata } from "astro";
import Video from "./Video.astro";

interface Props {
  titlePrefix: string;
  titleHighlight?: string;
  titleSuffix?: string;
  description: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  poster: ImageMetadata;
  posterAlt: string;
  videoId: string;
  playLabel: string;
  modalTitle: string;
  caption?: string;
}

const {
  titlePrefix,
  titleHighlight,
  titleSuffix,
  description,
  primaryCta,
  secondaryCta,
  poster,
  posterAlt,
  videoId,
  playLabel,
  modalTitle,
  caption
} = Astro.props;

---

<section class="relative overflow-hidden border-b border-[#d1d4dd] bg-[#f3f3f3]">
  <div class="section-shell grid min-h-[calc(100vh-6.5rem)] grid-cols-1 items-center gap-12 py-16 md:py-20 lg:grid-cols-2 lg:gap-16">
    <div class="order-1 space-y-5 md:space-y-6">
      <h1 class="font-display text-4xl font-bold leading-[1.12] sm:text-5xl md:text-6xl md:leading-tight">
        {titlePrefix}
        {titleHighlight && <>{" "}<span class="block text-[#087f65]">{titleHighlight}</span></>}
        {titleSuffix && <span>{` ${titleSuffix}`}</span>}
      </h1>

      <p class="max-w-140 text-base leading-relaxed md:text-lg">
        {description}
      </p>

      {(primaryCta || secondaryCta) && (
        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap">
          {primaryCta && (
            <a href={primaryCta.href} class="btn-primary w-full text-center sm:w-auto">
              {primaryCta.label}
            </a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn-primary w-full text-center sm:w-auto">
              {secondaryCta.label}
            </a>
          )}
        </div>
      )}
    </div>

    <div class="order-2 w-full">
      <Video
        {poster}
        {posterAlt}
        {videoId}
        {playLabel}
        {modalTitle}
        {caption}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
