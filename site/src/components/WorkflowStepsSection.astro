---
interface StepItem {
  title: string;
  body: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  steps: StepItem[];
  ctaHref: string;
  ctaLabel: string;
  ctaId?: string;
  variant: "broker" | "franchisor";
  sectionClass?: string;
}

const {
  eyebrow,
  title,
  description,
  steps,
  ctaHref,
  ctaLabel,
  ctaId,
  variant,
  sectionClass = "bg-[#f3f3f3] py-16 md:py-24"
} = Astro.props;

const stepCount = String(steps.length).padStart(2, "0");
const variantLabel = variant === "broker" ? "Built for advisor speed" : "Built for consistent selection";
---

<section class={sectionClass} data-workflow={variant}>
  <div class="section-shell workflow-layout">
    <div class="workflow-intro">
      <div class="workflow-intro-inner">
        <p class="workflow-eyebrow">{eyebrow}</p>
        <h2 class="workflow-title">{title}</h2>
        <p class="workflow-description">{description}</p>

        <div class="workflow-summary" aria-label={`${steps.length} step process`}>
          <strong>{stepCount}</strong>
          <span>connected<br />steps</span>
        </div>

        <a id={ctaId} class="workflow-cta" href={ctaHref}>
          <span>{ctaLabel}</span>
          <span class="workflow-cta-arrow" aria-hidden="true">&#8594;</span>
        </a>
      </div>
    </div>

    <div class="workflow-process">
      <div class="workflow-process-label">
        <span aria-hidden="true"></span>
        {variantLabel}
      </div>

      <ol class="workflow-steps" aria-label={title}>
        {steps.map((step, idx) => (
          <li class="workflow-step">
            <div class="workflow-marker" aria-hidden="true">
              <span>{String(idx + 1).padStart(2, "0")}</span>
            </div>
            <article class="workflow-card">
              <p class="workflow-step-kicker">Step {idx + 1}</p>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .workflow-layout {
    display: grid;
    gap: 2.75rem;
  }

  .workflow-intro {
    position: relative;
  }

  .workflow-intro-inner {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    background: #22252a;
    padding: 2rem;
    color: #ffffff;
    box-shadow: 0 24px 60px rgba(31, 35, 42, 0.14);
  }

  .workflow-intro-inner::after {
    content: "";
    position: absolute;
    right: -5rem;
    bottom: -6rem;
    width: 15rem;
    height: 15rem;
    border: 3.25rem solid rgba(9, 204, 156, 0.11);
    border-radius: 9999px;
    pointer-events: none;
  }

  .workflow-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-family: "MontereyFLF", "Century Gothic", sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .workflow-eyebrow::before {
    content: "";
    width: 1.8rem;
    height: 0.35rem;
    border-radius: 9999px;
    background: #09cc9c;
  }

  .workflow-title {
    max-width: 34rem;
    margin: 1.4rem 0 0;
    color: #ffffff;
    font-family: "MontereyFLF", "Century Gothic", sans-serif;
    font-size: clamp(2.2rem, 6vw, 3.35rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.04;
  }

  .workflow-description {
    max-width: 34rem;
    margin: 1.35rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1rem;
    line-height: 1.65;
  }

  .workflow-summary {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: fit-content;
    margin-top: 2.2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .workflow-summary strong {
    color: #09cc9c;
    font-family: "MontereyFLF", "Century Gothic", sans-serif;
    font-size: 2.5rem;
    line-height: 1;
  }

  .workflow-summary span {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .workflow-cta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    margin-top: 2rem;
    border-radius: 0.75rem;
    background: #fd7730;
    padding: 0.95rem 1rem 0.95rem 1.2rem;
    color: #22252a;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .workflow-cta:hover {
    background: #ff8a4d;
    transform: translateY(-2px);
  }

  .workflow-cta:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  .workflow-cta-arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 9999px;
    background: rgba(34, 37, 42, 0.12);
    font-size: 1.1rem;
    transition: transform 180ms ease;
  }

  .workflow-cta:hover .workflow-cta-arrow {
    transform: translateX(3px);
  }

  .workflow-process {
    min-width: 0;
  }

  .workflow-process-label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.35rem;
    color: #565b65;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .workflow-process-label span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 9999px;
    background: #09cc9c;
    box-shadow: 0 0 0 0.3rem rgba(9, 204, 156, 0.13);
  }

  .workflow-steps {
    position: relative;
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .workflow-steps::before {
    content: "";
    position: absolute;
    top: 2rem;
    bottom: 2rem;
    left: 1.45rem;
    width: 2px;
    background: linear-gradient(180deg, #09cc9c 0%, rgba(9, 204, 156, 0.15) 100%);
  }

  .workflow-step {
    position: relative;
    display: grid;
    grid-template-columns: 2.9rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
  }

  .workflow-marker {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2.9rem;
    height: 2.9rem;
    place-items: center;
    margin-top: 1.25rem;
    border: 1px solid #ccd1d5;
    border-radius: 9999px;
    background: #f3f3f3;
  }

  .workflow-marker span {
    display: grid;
    width: 2.15rem;
    height: 2.15rem;
    place-items: center;
    border-radius: 9999px;
    background: #22252a;
    color: #ffffff;
    font-family: "MontereyFLF", "Century Gothic", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .workflow-card {
    border: 1px solid #dfe1e4;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.86);
    padding: 1.35rem;
    box-shadow: 0 8px 30px rgba(31, 35, 42, 0.05);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .workflow-card:hover {
    border-color: rgba(9, 204, 156, 0.55);
    box-shadow: 0 15px 38px rgba(31, 35, 42, 0.09);
    transform: translateX(4px);
  }

  .workflow-step-kicker {
    margin: 0 0 0.5rem;
    color: #067c63;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .workflow-card h3 {
    margin: 0;
    color: #22252a;
    font-family: "MontereyFLF", "Century Gothic", sans-serif;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .workflow-card > p:last-child {
    margin: 0.7rem 0 0;
    color: #565b65;
    font-size: 1rem;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .workflow-intro-inner {
      padding: 2.5rem;
    }

    .workflow-cta {
      width: fit-content;
      min-width: 17rem;
    }

    .workflow-step {
      grid-template-columns: 3.4rem minmax(0, 1fr);
      gap: 1.15rem;
    }

    .workflow-steps::before {
      left: 1.7rem;
    }

    .workflow-marker {
      width: 3.4rem;
      height: 3.4rem;
      margin-top: 1.4rem;
    }

    .workflow-marker span {
      width: 2.5rem;
      height: 2.5rem;
    }

    .workflow-card {
      padding: 1.6rem 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .workflow-layout {
      grid-template-columns: minmax(19rem, 0.85fr) minmax(31rem, 1.15fr);
      gap: clamp(3rem, 7vw, 6.5rem);
      align-items: start;
    }

    .workflow-intro {
      position: sticky;
      top: 7rem;
    }

    .workflow-intro-inner {
      min-height: 35rem;
      display: flex;
      flex-direction: column;
      padding: clamp(2.25rem, 3.5vw, 3.25rem);
    }

    .workflow-summary {
      margin-top: auto;
    }

    .workflow-process {
      padding-top: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .workflow-cta,
    .workflow-cta-arrow,
    .workflow-card {
      transition: none;
    }
  }
</style>
