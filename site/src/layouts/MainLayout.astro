---
import "../styles/global.css";
import montereyWoff2 from "../assets/fonts/montereyflf-webfont.woff2";

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative canonical URL override. Defaults to the current page URL. */
  canonicalUrl?: string;
  /** Absolute or root-relative URL of the social sharing image (og:image / twitter:image). Defaults to the branded site image. */
  ogImage?: string;
  /** Alt text for the social sharing image. */
  ogImageAlt?: string;
  /** Open Graph type. Use "article" for blog posts. */
  ogType?: "website" | "article";
  /** ISO date string; rendered as article:published_time when ogType is "article". */
  publishedTime?: string;
  /** Author name; rendered as article:author when ogType is "article". */
  author?: string;
  /** Set true to ask search engines not to index this page (e.g. 404). */
  noindex?: boolean;
}

const {
  title = "Franchisee Assessment Software for Franchisors | Zorakle",
  description = "Zorakle uses seven validated sciences to predict franchisee fit and performance, helping franchisors award stronger owners with confidence.",
  canonicalUrl,
  ogImage,
  ogImageAlt = "Zorakle — franchise alignment and franchisee selection software",
  ogType = "website",
  publishedTime,
  author,
  noindex = false
} = Astro.props;

const faviconHref = `${import.meta.env.BASE_URL}favicon.svg`;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);

function normalizePath(pathname: string): string {
  // Match the build output/sitemap URL format (directory-style, trailing slash).
  if (pathname === "/" || /\.[a-z0-9]+$/i.test(pathname)) {
    return pathname;
  }
  return pathname.endsWith("/") ? pathname : `${pathname}/`;
}

const canonical = canonicalUrl
  ? new URL(canonicalUrl, siteOrigin).href
  : new URL(normalizePath(Astro.url.pathname), siteOrigin).href;

const DEFAULT_OG_IMAGE = "/images/og-default.png";
const usingDefaultOgImage = !ogImage;
const resolvedOgImage = new URL(ogImage ?? DEFAULT_OG_IMAGE, siteOrigin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Preload the display face used by every heading so it arrives before
        first paint and the swap doesn't reflow headings (CLS). */}
    <link rel="preload" href={montereyWoff2} as="font" type="font/woff2" crossorigin />


    <!-- Start of HubSpot Embed Code -->
    {/*
      HubSpot's tracker chain-loads several more scripts and runs a lot of
      main-thread work. Loading it during initial page load is the main driver
      of Total Blocking Time ("page blocked from responding to input"),
      especially on otherwise-light pages like blog posts. Defer it until the
      visitor first interacts, with a timed fallback so analytics still fires
      for people who bounce without interacting.
    */}
    {!noindex && (
      <script is:inline>
        (function () {
          var loaded = false;
          var events = ["scroll", "pointerdown", "keydown", "touchstart", "mousemove"];
          function cleanup() {
            events.forEach(function (e) { window.removeEventListener(e, load); });
            clearTimeout(fallback);
          }
          function load() {
            if (loaded) return;
            loaded = true;
            cleanup();
            var s = document.createElement("script");
            s.type = "text/javascript";
            s.id = "hs-script-loader";
            s.async = true;
            s.defer = true;
            s.src = "https://js.hs-scripts.com/2403148.js";
            document.head.appendChild(s);
          }
          events.forEach(function (e) { window.addEventListener(e, load, { passive: true }); });
          // Fallback: load after 10s even with no interaction.
          var fallback = setTimeout(load, 10000);
        })();
      </script>
    )}
    <!-- End of HubSpot Embed Code -->


    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Zorakle" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {usingDefaultOgImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && author && <meta property="article:author" content={author} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <slot name="head" />
  </head>
  <body class="antialiased">
    <div class="site-page-frame">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  body {
    background: #e8efed;
  }

  .site-page-frame {
    min-height: 100vh;
    margin-inline: auto;
    overflow: clip;
    width: min(1540px, calc(100% - 2rem));
    border: 1px solid #c7d3d0;
    background: white;
    box-shadow: 0 20px 70px rgba(31, 42, 53, 0.12);
  }

  @media (max-width: 767px) {
    .site-page-frame {
      width: 100%;
      border-inline: 0;
    }
  }
</style>
