---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative canonical URL override. Defaults to the current page URL. */
  canonicalUrl?: string;
  /** Absolute URL of the social sharing image (og:image / twitter:image). */
  ogImage?: string;
  /** Open Graph type. Use "article" for blog posts. */
  ogType?: "website" | "article";
  /** ISO date string; rendered as article:published_time when ogType is "article". */
  publishedTime?: string;
  /** Author name; rendered as article:author when ogType is "article". */
  author?: string;
  /** Set true to ask search engines not to index this page (e.g. 404). */
  noindex?: boolean;
}

const {
  title = "Zorakle | Franchise Performance Intelligence",
  description = "Science-backed tools for franchise awarding and broker matching decisions.",
  canonicalUrl,
  ogImage,
  ogType = "website",
  publishedTime,
  author,
  noindex = false
} = Astro.props;

const faviconHref = `${import.meta.env.BASE_URL}favicon.svg`;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);

function normalizePath(pathname: string): string {
  // Match the build output/sitemap URL format (directory-style, trailing slash).
  if (pathname === "/" || /\.[a-z0-9]+$/i.test(pathname)) {
    return pathname;
  }
  return pathname.endsWith("/") ? pathname : `${pathname}/`;
}

const canonical = canonicalUrl
  ? new URL(canonicalUrl, siteOrigin).href
  : new URL(normalizePath(Astro.url.pathname), siteOrigin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Zorakle" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && author && <meta property="article:author" content={author} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <slot name="head" />
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
