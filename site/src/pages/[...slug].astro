---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { PortableText } from "astro-portabletext";
import PortableTextImage from "../components/PortableTextImage.astro";
import PortableTextEmbed from "../components/PortableTextEmbed.astro";
import { getAllPosts, type BlogPost } from "../lib/blog.ts";

export async function getStaticPaths() {
  /**
   * Collapse a slug to a comparison key: decode percent-encoding, fold
   * compatibility characters (e.g. "ⓡ" -> "r"), and drop zero-width /
   * non-breaking spaces left over from the WordPress import. Aliases that
   * share a key with the primary slug differ only by encoding and must not
   * become their own route — they would otherwise clobber the primary
   * page on disk. Defined inside getStaticPaths: Astro isolates its scope.
   */
  const slugKey = (value: string): string => {
    let decoded = value;
    try {
      decoded = decodeURIComponent(value);
    } catch {
      // keep the raw value if it isn't valid percent-encoding
    }
    return decoded
      .normalize("NFKC")
      .replace(/[​-‍⁠  ﻿]/g, "")
      .trim()
      .toLowerCase();
  };

  const posts = await getAllPosts();
  const paths: Array<{
    params: { slug: string };
    props: { post: BlogPost; isLegacyAlias: boolean };
  }> = [];
  const seenSlugs = new Set<string>();

  // Register every post's own primary slug first, in its own pass, so a
  // later post's primary route can never be silently dropped just because
  // an earlier post's legacy alias happens to collide with it below.
  posts.forEach((post) => {
    if (seenSlugs.has(post.slug)) {
      return;
    }
    seenSlugs.add(post.slug);
    paths.push({ params: { slug: post.slug }, props: { post, isLegacyAlias: false } });
  });

  // Legacy aliases (-> 301) are registered afterward and are skipped if they
  // collide with any primary slug or another alias already claimed above.
  posts.forEach((post) => {
    const alias = post.legacySlug;
    if (typeof alias !== "string" || alias.trim().length === 0 || alias === post.slug) {
      return;
    }
    if (seenSlugs.has(alias)) {
      return;
    }
    seenSlugs.add(alias);

    // Treat as a legacy alias (-> 301) only when it is a genuinely different
    // slug. Twins that differ from the primary just by percent-encoding or
    // invisible characters keep rendering the article; their <link rel=
    // "canonical"> already points search engines at the primary URL.
    const isLegacyAlias = slugKey(alias) !== slugKey(post.slug);
    paths.push({
      params: { slug: alias },
      props: { post, isLegacyAlias },
    });
  });

  return paths;
}

interface Props {
  post: BlogPost;
  isLegacyAlias: boolean;
}

const { post, isLegacyAlias } = Astro.props;

const primaryUrl = new URL(`/${post.slug}/`, Astro.site).href;
if (isLegacyAlias) {
  return Astro.redirect(primaryUrl, 301);
}

const publishedDate = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric"
}).format(new Date(post.publishedAt));

const pageDescription = post.excerpt || `Read ${post.title} on Zorakle Blog.`;

const canonicalUrl = primaryUrl;
const orgId = `${Astro.site?.href}#organization`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: post.title,
      description: pageDescription,
      datePublished: post.publishedAt,
      dateModified: post.updatedAt,
      ...(post.featuredImageUrl
        ? { image: { "@type": "ImageObject", url: post.featuredImageUrl, width: 1200 } }
        : {}),
      author: { "@id": orgId },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
      publisher: { "@id": orgId }
    },
    {
      "@type": "Organization",
      "@id": orgId,
      name: "Zorakle",
      url: Astro.site?.href,
      logo: {
        "@type": "ImageObject",
        url: new URL("/zorakle-logo.png", Astro.site).href
      }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: Astro.site?.href },
        {
          "@type": "ListItem",
          position: 2,
          name: "News",
          item: new URL("/news/", Astro.site).href
        },
        { "@type": "ListItem", position: 3, name: post.title, item: canonicalUrl }
      ]
    }
  ]
});

const portableTextComponents = {
  type: {
    // Renders image blocks embedded in the post body
    image: PortableTextImage,
    // Renders imported iframe/video embeds from WordPress content
    embed: PortableTextEmbed,
  },
};


---

<MainLayout
  title={`${post.title} | Zorakle`}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogType="article"
  ogImage={post.featuredImageUrl}
  ogImageAlt={post.featuredImageAlt || post.title}
  publishedTime={post.publishedAt}
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <SiteHeader />

  <main class="bg-[#f7f8fb] py-14 md:py-16">
    <article class="section-shell rounded-xl bg-white px-6 py-8 shadow-sm md:px-10 md:py-10">

      <h1 class="page-title mt-4">{post.title}</h1>

      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-semibold text-[#22252a]">
        <span>Posted on {publishedDate}</span>
      </div>

      {
        post.body.length > 0 && (
          <div class="blog-content mt-8 border-t border-[#d1d4dd] pt-8">
            <PortableText value={post.body as any} components={portableTextComponents as any} />
          </div>
        )
      }
    </article>
  </main>

  <SiteFooter />
</MainLayout>

<style is:global>
  .blog-content {
    color: #3b3e47;
    line-height: 1.8;
    font-size: clamp(1rem, 0.25vw + 0.95rem, 1.125rem);
  }

  .blog-content > * + * {
    margin-top: 1.25rem;
  }

  .blog-content h1,
  .blog-content h2,
  .blog-content h3,
  .blog-content h4 {
    font-family: "MontereyFLF", "Century Gothic", "Avenir Next", sans-serif;
    color: #22252a;
    line-height: 1.25;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .blog-content a {
    color: #a8420c;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-content img {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  .blog-content video {
    width: 100%;
    border-radius: 0.75rem;
  }

  .blog-content iframe {
    width: 100%;
    min-height: 320px;
    border: 0;
    border-radius: 0.75rem;
  }

  @media (min-width: 768px) {
    .blog-content iframe {
      min-height: 420px;
    }
  }
</style>
