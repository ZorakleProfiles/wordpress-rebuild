---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { PortableText } from "astro-portabletext";
import PortableTextImage from "../components/PortableTextImage.astro";
import PortableTextEmbed from "../components/PortableTextEmbed.astro";
import { getAllPosts, type BlogPost } from "../lib/blog.ts";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const paths: Array<{ params: { slug: string }; props: { post: BlogPost } }> = [];
  const seenSlugs = new Set<string>();

  posts.forEach((post) => {
    const aliases = [post.slug, post.legacySlug].filter(
      (value): value is string => typeof value === "string" && value.trim().length > 0
    );

    aliases.forEach((alias) => {
      if (seenSlugs.has(alias)) {
        return;
      }

      seenSlugs.add(alias);
      paths.push({
        params: { slug: alias },
        props: { post }
      });
    });
  });

  return paths;
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const publishedDate = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric"
}).format(new Date(post.publishedAt));

const pageDescription = post.excerpt || `Read ${post.title} on Zorakle Blog.`;
const encodedPostId = encodeURIComponent(post.sanityId);
const studioEditHref = `/studio#/intent/edit/id=${encodedPostId};type=post`;

// Legacy WordPress slug aliases render the same content — canonicalize to the primary slug.
const canonicalUrl = new URL(`/${post.slug}/`, Astro.site).href;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: pageDescription,
  datePublished: post.publishedAt,
  ...(post.featuredImageUrl ? { image: post.featuredImageUrl } : {}),
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  publisher: {
    "@type": "Organization",
    name: "Zorakle",
    url: Astro.site?.href
  }
});

const portableTextComponents = {
  type: {
    // Renders image blocks embedded in the post body
    image: PortableTextImage,
    // Renders imported iframe/video embeds from WordPress content
    embed: PortableTextEmbed,
  },
};
---

<MainLayout
  title={`${post.title} | Zorakle`}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogType="article"
  ogImage={post.featuredImageUrl}
  publishedTime={post.publishedAt}
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <SiteHeader />

  <main class="bg-[#f7f8fb] py-14 md:py-16">
    <article class="section-shell rounded-xl bg-white px-6 py-8 shadow-sm md:px-10 md:py-10">

      <h1 class="mt-4 max-w-5xl font-display text-[42px] leading-tight text-[#22252a] md:text-[56px]">{post.title}</h1>

      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-semibold text-[#22252a]">
        <span>Posted on {publishedDate}</span>
        <a
          href={studioEditHref}
          data-studio-edit-link
          hidden
          class="ml-auto text-xs font-medium text-[#fd7730] underline underline-offset-2 hover:opacity-80"
          target="_blank"
          rel="noopener noreferrer"
        >
          Edit in Studio ↗
        </a>
      </div>

      <script>
        // Show the "Edit in Studio" link only when the visitor has an active
        // Sanity session (i.e. they are logged in to the Studio).
        const projectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID || "4kjxjblw";
        const CACHE_KEY = "sanity-studio-session";

        function reveal() {
          document
            .querySelectorAll("[data-studio-edit-link]")
            .forEach((el) => el.removeAttribute("hidden"));
        }

        async function checkSession() {
          const cached = sessionStorage.getItem(CACHE_KEY);
          if (cached === "yes") {
            reveal();
            return;
          }
          if (cached === "no") {
            return;
          }

          try {
            const res = await fetch(`https://${projectId}.api.sanity.io/v1/users/me`, {
              credentials: "include",
            });
            const user = res.ok ? await res.json() : null;
            const loggedIn = Boolean(user && user.id);
            sessionStorage.setItem(CACHE_KEY, loggedIn ? "yes" : "no");
            if (loggedIn) {
              reveal();
            }
          } catch {
            // Network/CORS failure — leave the link hidden.
          }
        }

        checkSession();
      </script>



      {
        post.body.length > 0 ? (
          <div class="blog-content mt-8 border-t border-[#d1d4dd] pt-8">
            <PortableText value={post.body as any} components={portableTextComponents as any} />
          </div>
        ) : (
          <div class="blog-content mt-8 border-t border-[#d1d4dd] pt-8" set:html={post.contentHtml}></div>
        )
      }
    </article>
  </main>

  <SiteFooter />
</MainLayout>

<style is:global>
  .blog-content {
    color: #3b3e47;
    line-height: 1.8;
    font-size: 1rem;
  }

  .blog-content > * + * {
    margin-top: 1.25rem;
  }

  .blog-content h1,
  .blog-content h2,
  .blog-content h3,
  .blog-content h4 {
    font-family: "MontereyFLF", "Century Gothic", "Avenir Next", sans-serif;
    color: #22252a;
    line-height: 1.25;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .blog-content a {
    color: #fd7730;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-content img {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  .blog-content video {
    width: 100%;
    border-radius: 0.75rem;
  }

  .blog-content iframe {
    width: 100%;
    min-height: 320px;
    border: 0;
    border-radius: 0.75rem;
  }

  @media (min-width: 768px) {
    .blog-content iframe {
      min-height: 420px;
    }
  }
</style>

