---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CtaBand from "../components/CtaBand.astro";
import { Image } from "astro:assets";
import TestimonialCard from "../components/TestimonialCard.astro";
import { testimonials } from "../data/site-content";
import rebeccaPhoto from "../assets/about-rebecca-monet.png";

const featuredTestimonialNames = ["Marcos Moura", "Gerry Henley", "Kim Marinoff"];
const featuredTestimonials = featuredTestimonialNames
  .map((name) => testimonials.find((item) => item.name === name))
  .filter((item): item is (typeof testimonials)[number] => Boolean(item));
---

<MainLayout
  title="About Zorakle | Meet the Franchisee Assessment Team"
  description="Meet the psychometricians and franchise development veterans behind Zorakle: founder and chief scientist Rebecca Monet, technology lead Mike Kidushim, and client services director Jamie Patterson."
>
  <SiteHeader />

  <main>

    <!-- INTRO -->
    <section class="bg-white pt-14 pb-6 md:pt-20 md:pb-10">
      <div class="section-shell max-w-3xl">
        <p class="section-eyebrow">About Zorakle</p>
        <h1 class="page-title mt-4">The team behind the franchise alignment stack.</h1>
        <p class="mt-5 text-base leading-relaxed text-[#3b3e47] md:text-lg">
          Zorakle launched in 2012. Twelve years later, if a report looks off or a candidate's
          score doesn't add up, you're an email or a Zoom meeting away from the person who built
          the science, not a ticket queue. They can explain exactly what's behind the result and
          fix it directly. Meet them below.
        </p>
      </div>
    </section>

    <!-- REBECCA -->
    <section class="bg-[#f3f3f3] py-16 md:py-24">
      <div class="section-shell">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-center lg:gap-20">
          <div class="mx-auto w-full max-w-md lg:mx-0">
            <div class="overflow-hidden rounded-3xl shadow-xl">
              <Image
                src={rebeccaPhoto}
                alt="Rebecca Monet, Founder & Chief Scientist of Zorakle"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
          <div>
            <p class="section-eyebrow">Founder &amp; Chief Scientist</p>
            <h2 class="section-title">Rebecca Monet.</h2>
            <p class="mt-7 max-w-2xl text-base leading-relaxed text-[#3b3e47] md:text-lg">
              Rebecca has spent more than 30 years at the intersection of psychometrics, performance science, and franchise development. She founded Zorakle in 2012 because the industry was making million-dollar decisions with tools built for a completely different purpose, and she had the scientific background to fix that. Twelve years later, that same conviction runs the company: awarding decisions deserve better than a gut call. She is also the host of <em>The Franchise Woman Podcast</em> and a frequent voice on franchise development, candidate quality, and what it really takes to build a high-performing system.
            </p>
            <blockquote class="mt-10 border-l-4 border-[#09cc9c] pl-6">
              <p class="font-display text-2xl leading-snug text-[#22252a] md:text-3xl">
                "When teams stop guessing, they award stronger owners and scale with less risk."
              </p>
              <footer class="mt-3 text-sm font-semibold uppercase tracking-widest text-[#087f65]">Rebecca Monet</footer>
            </blockquote>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/podcasts" class="btn-secondary">Podcasts</a>
              <a href="/news" class="btn-secondary">Read Her Insights</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- LEADERSHIP TEAM -->
    <section class="bg-white py-20 md:py-28">
      <div class="section-shell">
        <div class="max-w-2xl">
          <p class="section-eyebrow">Leadership Team</p>
          <h2 class="section-title">The people who bring Zorakle to life.</h2>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:gap-8">
          <article class="rounded-3xl border border-[#dedede] bg-[#f8f8f8] p-8 md:p-10">
            <p class="section-eyebrow">Technology</p>
            <h3 class="font-display text-3xl font-semibold text-[#22252a] md:text-4xl">Mike Kidushim</h3>
            <p class="mt-5 text-base leading-relaxed text-[#3b3e47] md:text-lg">
              Mike leads technology at Zorakle, guiding the platform and the systems that turn complex assessment science into a clear, dependable experience for clients and their candidates.
            </p>
          </article>

          <article class="rounded-3xl border border-[#dedede] bg-[#f8f8f8] p-8 md:p-10">
            <p class="section-eyebrow">Director of Client Services</p>
            <h3 class="font-display text-3xl font-semibold text-[#22252a] md:text-4xl">Jamie Patterson</h3>
            <p class="mt-5 text-base leading-relaxed text-[#3b3e47] md:text-lg">
              Jamie leads client services, helping Zorakle customers get the support, guidance, and practical insight they need to put the platform to work with confidence.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- PROOF -->
    {featuredTestimonials.length > 0 && (
      <section class="bg-[#f3f3f3] py-20 md:py-28">
        <div class="section-shell">
          <div class="max-w-2xl">
            <p class="section-eyebrow">In Their Words</p>
            <h2 class="section-title">Franchisors and brokers who work with us.</h2>
          </div>

          <div class="mt-12 grid gap-6 md:grid-cols-3">
            {featuredTestimonials.map((item) => (
              <TestimonialCard
                name={item.name}
                company={item.company}
                type={item.type}
                quote={item.quote}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <CtaBand
      title="Meet with our team."
      text="Tell us what you are working toward, and we will help you see how Zorakle can support better franchise decisions."
    />

  </main>

  <SiteFooter />
</MainLayout>
