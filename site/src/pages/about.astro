---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CtaBand from "../components/CtaBand.astro";
import { Image } from "astro:assets";
import rebeccaPhoto from "../assets/figma-import/about-rebecca-monet.png";

const stats = [
  { number: "30+", label: "Years in psychometrics & assessment" },
  { number: "7",   label: "Peer-reviewed sciences in one framework" },
  { number: "12",  label: "Years purpose-built for franchising" },
];
---

<MainLayout
  title="About | Zorakle"
  description="Zorakle is the only franchise-specific assessment platform built on seven validated sciences — helping franchisors and brokers award with clarity and confidence."
>
  <SiteHeader />

  <main>

    <!-- INTRO / WHY WE EXIST -->
    <section class="bg-white py-20 md:py-28">
      <div class="section-shell">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-20">
          <div>
            <p class="section-eyebrow">About Zorakle</p>
            <h1 class="section-title">Built to make franchise fit a science.</h1>
            <p class="section-copy max-w-xl">
              For more than a decade, Zorakle has been the only franchise-specific fit platform — predictive, science-backed, and built for the decisions that actually matter.
            </p>
          </div>
          <div class="space-y-5 text-base leading-relaxed text-[#3b3e47] md:text-lg lg:pt-2">
          <p>
            Personality tests tell you who someone is. Zorakle tells you whether they will succeed as a franchisee. That is a fundamentally different question — and it requires a fundamentally different tool.
          </p>
          <p>
            Franchisees own the business. They manage P&L, hire and retain teams, navigate a relationship with a franchisor, and execute a proven system under real market pressure. No off-the-shelf assessment was ever built to predict that. So we built one from the ground up.
          </p>
          <p>
            Over twelve years, we integrated seven peer-reviewed sciences from leading research institutions into a single, franchise-specific framework — one designed to predict performance and fit before the agreement is ever signed.
          </p>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="bg-[#09cc9c] py-16 md:py-20">
      <div class="section-shell">
        <div class="grid gap-10 sm:grid-cols-3 sm:divide-x sm:divide-white/25">
          {stats.map((s) => (
            <div class="sm:px-8 sm:first:pl-0 sm:last:pr-0">
              <p class="font-display text-6xl font-bold text-white md:text-7xl">{s.number}</p>
              <p class="mt-2 text-base font-medium text-white/85 md:text-lg">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- REBECCA -->
    <section class="bg-[#f3f3f3] py-20 md:py-28">
      <div class="section-shell">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-center lg:gap-20">
          <div class="mx-auto w-full max-w-md lg:mx-0">
            <div class="overflow-hidden rounded-3xl shadow-xl">
              <Image
                src={rebeccaPhoto}
                alt="Rebecca Monet, Founder & Chief Scientist of Zorakle"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
          <div>
            <p class="section-eyebrow">Founder &amp; Chief Scientist</p>
            <h2 class="section-title">Rebecca Monet.</h2>
            <p class="mt-7 max-w-2xl text-base leading-relaxed text-[#3b3e47] md:text-lg">
              Rebecca has spent more than 30 years at the intersection of psychometrics, performance science, and franchise development. She built Zorakle because she recognized that the industry was making million-dollar decisions with tools designed for a completely different purpose — and she had the scientific background to do something about it. She is also the host of <em>The Franchise Woman Podcast</em> and a frequent voice on franchise development, candidate quality, and what it really takes to build a high-performing system.
            </p>
            <blockquote class="mt-10 border-l-4 border-[#09cc9c] pl-6">
              <p class="font-display text-2xl leading-snug text-[#22252a] md:text-3xl">
                "When teams stop guessing, they award stronger owners and scale with less risk."
              </p>
              <footer class="mt-3 text-sm font-semibold uppercase tracking-widest text-[#09cc9c]">Rebecca Monet</footer>
            </blockquote>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/podcasts" class="btn-secondary">The Franchise Woman Podcast</a>
              <a href="/news" class="btn-secondary">Read Her Insights</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CtaBand
      title="Let's talk."
      text="Whether you are awarding franchises, matching candidates, or evaluating your system — we can show you what Zorakle can do."
    />

  </main>

  <SiteFooter />
</MainLayout>
