---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import HeroSection from "../components/HeroSection.astro";
import LogoCloud from "../components/LogoCloud.astro";
import ProcessInsightSection from "../components/ProcessInsightSection.astro";
import AlignmentPainPoints from "../components/AlignmentPainPoints.astro";
import AlignmentLifecycle from "../components/AlignmentLifecycle.astro";
import AlignmentStack from "../components/AlignmentStack.astro";
import TestimonialGrid from "../components/TestimonialGrid.astro";
import BrokerSolutionsFeature from "../components/BrokerSolutionsFeature.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { Image } from "astro:assets";
import { footer } from "../data/site-content";
import idealAlgorithmReport from "../assets/alignment_report.png";
import blueprintReport from "../assets/blueprint.png";
import spotOnProfileReport from "../assets/spoton.png";
import eclipseReport from "../assets/eclipse.png";
import marketingBlueprintReport from "../assets/marketing_blueprint.png";
import coachingInsightReport from "../assets/business_builder.png";

const whatYouGet = [
  {
    title: "Ideal Franchisee Algorithm",
    subtitle: "Customized to your brand.",
    body:
      "We benchmark your system and your top performers to build a fit model tuned to what actually predicts success in your brand — not a generic personality score.",
    image: idealAlgorithmReport,
    imageAlt: "Overall alignment comparison between a franchisor's benchmark and its high performers"
  },
  {
    title: "The SpotOn! Blueprint",
    subtitle: "Your algorithm, explained.",
    body:
      "A plain-language document showing exactly how your fit model was built from benchmark data, top performers, and brand requirements — so selection stays consistent over time.",
    image: blueprintReport,
    imageAlt: "SpotOn! Blueprint value-set analysis for high performers"
  },
  {
    title: "Candidate SpotOn! Profiles",
    subtitle: "Every candidate, decoded.",
    body:
      "A franchisor-only readout of each candidate across the seven sciences — values, work style, culture, competencies, and business capacity — on a single page.",
    image: spotOnProfileReport,
    imageAlt: "Candidate SpotOn! Profile report"
  },
  {
    title: "Candidate-to-System Eclipse Reports",
    subtitle: "Fit, scored.",
    body:
      "One fit-compatibility score comparing each candidate to your top performers, broken down by dimension so strengths and risk areas are obvious at a glance.",
    image: eclipseReport,
    imageAlt: "Eclipse report showing overall fit compatibility score by dimension"
  },
  {
    title: "The Marketing Blueprint",
    subtitle: "Attract the right owner.",
    body:
      "A data-driven guide to reaching your ideal franchisee profile — the messaging, tone, colors, and channels that resonate with the candidates you actually want.",
    image: marketingBlueprintReport,
    imageAlt: "Marketing Blueprint profile of an ideal franchisee persona"
  },
  {
    title: "Coaching & Development Insight",
    subtitle: "Onboard and coach with precision.",
    body:
      "Each owner's profile shows how they process information, handle pressure, and respond to accountability — so training and field coaching target the real gaps.",
    image: coachingInsightReport,
    imageAlt: "Business Builder report used for franchisee coaching and development"
  }
];

const siteHref = Astro.site?.href ?? "https://www.zorakleprofiles.com/";
const orgId = `${siteHref}#organization`;

// sameAs: pulled from footer.social. Add YouTube / podcast / X profile URLs there
// as they become available and they will flow into this schema automatically.
const sameAs = footer.social.map((profile) => profile.href).filter(Boolean);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: "Zorakle",
      alternateName: "Zorakle Profiles",
      url: siteHref,
      logo: {
        "@type": "ImageObject",
        url: new URL("/zorakle-logo.png", siteHref).href
      },
      email: footer.email,
      address: {
        "@type": "PostalAddress",
        streetAddress: "8782 S. Park Road",
        addressLocality: "Rogers",
        addressRegion: "AR",
        postalCode: "72756",
        addressCountry: "US"
      },
      ...(sameAs.length ? { sameAs } : {}),
      description:
        "Science-backed tools for franchise awarding and broker matching decisions."
    },
    {
      "@type": "WebSite",
      "@id": `${siteHref}#website`,
      name: "Zorakle",
      url: siteHref,
      publisher: { "@id": orgId }
    }
  ]
});
---

<MainLayout
  title="Zorakle | Franchisee Assessment Software for Franchisors"
  description="Zorakle helps franchisors award better-fitting franchisees. The SpotOn! assessment scores candidate fit and performance potential using seven validated sciences."
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <SiteHeader />
  <main>
      <HeroSection />
      <LogoCloud />
      <ProcessInsightSection />
      <AlignmentPainPoints />

      <AlignmentStack />
      <AlignmentLifecycle />

      <aside class="home-section-band relative overflow-hidden border-y border-[#536373] bg-[radial-gradient(circle_at_50%_25%,#34485b_0%,#243647_54%,#1d2e3e_100%)] px-5 text-white" aria-label="Explore the sciences behind Zorakle">
        <svg class="pointer-events-none absolute inset-y-0 left-0 hidden h-full w-auto min-[950px]:block" viewBox="0 0 180 210" aria-hidden="true">
          <g fill="none" stroke="#28bcae" stroke-width="1.5" opacity="0.9">
            <path d="M-18 41 24 67 62 101 117 138 157 120M62 101 112 52 120 27M117 138 135 181M24 67 1 139" />
          </g>
          <g fill="#2bb9aa">
            <circle cx="-2" cy="40" r="12" /><circle cx="24" cy="67" r="13" /><circle cx="62" cy="101" r="17" />
            <circle cx="117" cy="138" r="15" /><circle cx="157" cy="120" r="7" /><circle cx="112" cy="52" r="9" />
            <circle cx="120" cy="27" r="9" /><circle cx="135" cy="181" r="10" /><circle cx="1" cy="139" r="10" />
          </g>
        </svg>

        <svg class="pointer-events-none absolute inset-y-0 right-0 hidden h-full w-auto min-[950px]:block" viewBox="1020 0 180 210" aria-hidden="true">
          <g fill="none" stroke="#28bcae" stroke-width="1.5" opacity="0.9">
            <path d="M1220 57 1171 75 1134 103 1090 78 1059 61M1171 75 1187 21 1192 -16M1134 103 1100 162M1134 103 1165 184M1090 78 1067 45" />
          </g>
          <g fill="#2bb9aa">
            <circle cx="1220" cy="57" r="12" /><circle cx="1171" cy="75" r="7" /><circle cx="1134" cy="103" r="17" />
            <circle cx="1090" cy="78" r="7" /><circle cx="1059" cy="61" r="6" /><circle cx="1187" cy="21" r="15" />
            <circle cx="1192" cy="-16" r="9" /><circle cx="1100" cy="162" r="12" /><circle cx="1165" cy="184" r="7" /><circle cx="1067" cy="45" r="6" />
          </g>
        </svg>

        <div class="relative z-10 mx-auto flex max-w-5xl flex-col items-center text-center">
          <h2 class="font-display text-[clamp(1.65rem,2.5vw,2.15rem)] leading-tight text-white">
            What Seven Behavioral Sciences Reveal About Franchisee Fit
          </h2>
          <a class="btn-primary mt-6" href="/sciences">
            Explore The Sciences <span class="text-lg leading-none" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </aside>

      <TestimonialGrid type={null} limit={3} />

      <BrokerSolutionsFeature />

      <section class="home-section-cta overflow-hidden border-t border-[#dce7e4] bg-white">
        <div class="section-shell grid items-center gap-8 lg:grid-cols-[3fr_2fr] lg:gap-12">
          <div class="max-w-3xl">
            <p class="section-eyebrow">From insight to impact</p>
            <h2 class="font-display text-[2rem] leading-[1.08] tracking-[-0.02em] text-[#1e2f43] sm:text-4xl lg:text-[2.9rem]">
              Make your next franchisee decision
              <span class="text-[#09a985]"> with greater confidence.</span>
            </h2>
            <p class="section-copy mt-4 max-w-xl text-[#475569]">
              See how Zorakle can help you identify candidates who fit your culture, system, and expectations - and give your team the insight to help them succeed.
            </p>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a class="btn-primary" href="/schedule">Book a Consultation</a>
              <a class="inline-flex items-center gap-2 text-base font-semibold text-[#1e2f43] transition-colors hover:text-[#23bfa8]" href="/pricing">
                View Plans &amp; Pricing <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          <div class="mx-auto w-full max-w-[620px] lg:max-w-none" aria-label="Sample Zorakle franchisee reports">
            {/* Small screens: clean side-by-side, no overlap or rotation */}
            <div class="grid grid-cols-2 items-start gap-4 sm:hidden">
              <div class="rounded-2xl border border-[#e6eeec] bg-white p-2.5 shadow-[0_16px_32px_rgba(23,35,62,0.14)]">
                <Image src={blueprintReport} alt="SpotOn Blueprint sample report" class="h-auto w-full rounded-xl" />
              </div>
              <div class="mt-6 rounded-2xl border border-[#e6eeec] bg-white p-2.5 shadow-[0_16px_32px_rgba(23,35,62,0.14)]">
                <Image src={eclipseReport} alt="Eclipse candidate fit sample report" class="h-auto w-full rounded-xl" />
              </div>
            </div>

            {/* sm and up: fanned, overlapping cluster with decorative rings */}
            <div class="relative mx-auto hidden h-[420px] w-full sm:block lg:h-[400px]">
              <div class="pointer-events-none absolute left-[52%] top-1/2 h-[330px] w-[330px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#c9f0e8]/65 lg:h-[300px] lg:w-[300px]"></div>
              <div class="pointer-events-none absolute left-[52%] top-1/2 h-[385px] w-[385px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#cfe8e3] lg:h-[370px] lg:w-[370px]"></div>

              <div class="absolute left-[1%] top-[5%] w-[52%] rotate-[-5deg] rounded-2xl border border-[#e6eeec] bg-white p-3 shadow-[0_22px_45px_rgba(23,35,62,0.16)] lg:w-[62%]">
                <Image src={blueprintReport} alt="SpotOn Blueprint sample report" class="h-auto w-full rounded-xl" />
              </div>
              <div class="absolute bottom-[1%] right-0 w-[58%] rotate-[5deg] rounded-2xl border border-[#e6eeec] bg-white p-3 shadow-[0_24px_45px_rgba(23,35,62,0.2)] lg:w-[68%]">
                <Image src={eclipseReport} alt="Eclipse candidate fit sample report" class="h-auto w-full rounded-xl" />
              </div>
            </div>
          </div>
        </div>
      </section>
  </main>
  <SiteFooter />
</MainLayout>
