---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import HeroSection from "../components/HeroSection.astro";
import ScienceSection from "../components/ScienceSection.astro";
import LogoCloud from "../components/LogoCloud.astro";
import PathCards from "../components/PathCards.astro";
import DifferenceGrid from "../components/DifferenceGrid.astro";
import AlignmentExplanation from "../components/AlignmentExplanation.astro";
import AlignmentPainPoints from "../components/AlignmentPainPoints.astro";
import AlignmentLifecycle from "../components/AlignmentLifecycle.astro";
import AlignmentStack from "../components/AlignmentStack.astro";
import TestimonialGrid from "../components/TestimonialGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { footer } from "../data/site-content";

const siteHref = Astro.site?.href ?? "https://www.zorakleprofiles.com/";
const orgId = `${siteHref}#organization`;

// sameAs: pulled from footer.social. Add YouTube / podcast / X profile URLs there
// as they become available and they will flow into this schema automatically.
const sameAs = footer.social.map((profile) => profile.href).filter(Boolean);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: "Zorakle",
      alternateName: "Zorakle Profiles",
      url: siteHref,
      logo: {
        "@type": "ImageObject",
        url: new URL("/zorakle-logo.png", siteHref).href
      },
      email: footer.email,
      address: {
        "@type": "PostalAddress",
        streetAddress: "8782 S. Park Road",
        addressLocality: "Rogers",
        addressRegion: "AR",
        postalCode: "72756",
        addressCountry: "US"
      },
      ...(sameAs.length ? { sameAs } : {}),
      description:
        "Science-backed tools for franchise awarding and broker matching decisions."
    },
    {
      "@type": "WebSite",
      "@id": `${siteHref}#website`,
      name: "Zorakle",
      url: siteHref,
      publisher: { "@id": orgId }
    }
  ]
});
---

<MainLayout
  title="Zorakle | Franchisee Assessment Software for Franchisors"
  description="Zorakle helps franchisors award better-fitting franchisees. The SpotOn! assessment scores candidate fit and performance potential using seven validated sciences."
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <SiteHeader />
  <main>
    <HeroSection />
    <LogoCloud />
    <AlignmentExplanation />
    <AlignmentPainPoints />
    <AlignmentLifecycle />
    <AlignmentStack />
    <ScienceSection />
    <TestimonialGrid type={null} bg="f3f3f3" />
    <CtaBand
      title="Put the Alignment Stack to work on your next candidate."
      text="You've seen the five layers that predict who will actually execute. See them applied to your system in a live walkthrough, or start building your plan now."
    />
  </main>
  <SiteFooter />
</MainLayout>
