---
import BlogList from "../../components/BlogList.astro";
import { getPaginatedPostsByCategory } from "../../lib/blog.ts";

const NEWS_ARCHIVE_PAGE_SIZE = 10;
const pageData = await getPaginatedPostsByCategory("news", 1, NEWS_ARCHIVE_PAGE_SIZE);
---

<BlogList
        title="News | Zorakle"
        description="Company news, product updates, and franchise industry announcements from the Zorakle team."
        heading="News"
        emptyStateMessage="No news posts were found."
        basePath="/news"
        postBasePath=""
        posts={pageData.posts}
        currentPage={pageData.page}
        totalPages={pageData.totalPages}
        ctaTitle="Turn franchise insight into stronger decisions."
        ctaText="Stay ahead of what is shaping franchising, then use Zorakle's predictive science to make your next decision with confidence."
/>
