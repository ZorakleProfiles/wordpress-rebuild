---
import BlogList from "../../components/BlogList.astro";
import { getPaginatedPostsByTag } from "../../lib/blog.ts";

const NEWS_ARCHIVE_PAGE_SIZE = 10;
const pageData = await getPaginatedPostsByTag("news", 1, NEWS_ARCHIVE_PAGE_SIZE);
---

<BlogList
        title="News | Zorakle"
        description="News from the Zorakle network."
        heading="News"
        emptyStateMessage="No news posts were found."
        basePath="/news"
        postBasePath=""
        posts={pageData.posts}
        currentPage={pageData.page}
        totalPages={pageData.totalPages}
/>

