---
import BlogList from "../../../components/BlogList.astro";
import {
  getArchivePaginationPaths,
  type PaginatedPosts
} from "../../../lib/blog.ts";

export async function getStaticPaths() {
  // Astro isolates getStaticPaths into its own module scope during
  // prerendering, so the page size must be defined inside it, not above.
  const newsArchivePageSize = 10;
  return getArchivePaginationPaths("news", newsArchivePageSize);
}

interface Props {
  pageData: PaginatedPosts;
}

const { pageData } = Astro.props;
const pageTitle = `Franchise News & Insights - Page ${pageData.page} | Zorakle`;
---

<BlogList
  title={pageTitle}
  description="Franchise news and updates from the Zorakle team and network."
  heading="News"
  emptyStateMessage="No news posts were found."
  basePath="/news"
  postBasePath=""
  posts={pageData.posts}
  currentPage={pageData.page}
  totalPages={pageData.totalPages}
  ctaTitle="Turn franchise insight into stronger decisions."
  ctaText="Stay ahead of what is shaping franchising, then use Zorakle's predictive science to make your next decision with confidence."
/>
