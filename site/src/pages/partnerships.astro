---
import { Image } from "astro:assets";
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { partnerships } from "../data/site-content";
import logoFba from "../assets/fba.webp";
import logoFbr from "../assets/fbr-logo.webp";
import logoBai from "../assets/bai-logo.webp";
import logoIfa from "../assets/logo-ifa-grey.png";
import logoIfpg from "../assets/ifpg.png";
import logoFranserve from "../assets/franserve-logo.png";
import logoClienttether from "../assets/clienttether-logo.png";
import logoEauth from "../assets/eauth.png";
import logoMaverick from "../assets/maverick.png";
import logoOyr from "../assets/oyr-logo.png";
const partnerLogos = {
  FBA: logoFba,
  FBR: logoFbr,
  BAI: logoBai,
  IFA: logoIfa,
  IFPG: logoIfpg,
  FRANSERVE: logoFranserve,
  CLIENTTETHER: logoClienttether,
  EAUTH: logoEauth,
  MAVERICK: logoMaverick,
  OYR: logoOyr,
};

const partnershipsWithLogos = [...partnerships]
  .sort((a, b) => a.name.localeCompare(b.name, "en", { sensitivity: "base" }))
  .map((partner) => ({
    ...partner,
    logo: partnerLogos[partner.shortName as keyof typeof partnerLogos]
  }));
---

<MainLayout
  title="Franchise Industry Partnerships | Zorakle"
  description="The franchise broker networks, associations, and technology partners Zorakle works with to bring science-backed candidate assessment to franchising."
>
  <SiteHeader />

  <main>
    <section class="border-b border-[#dce8e5] bg-[#f3faf8] py-12 md:py-16" aria-labelledby="partnerships-heading">
      <div class="section-shell grid gap-7 lg:grid-cols-[1.15fr_.85fr] lg:items-end lg:gap-16">
        <div>
          <p class="section-eyebrow">Our Ecosystem</p>
          <h1 id="partnerships-heading" class="page-title mt-3 max-w-3xl">
            Better Franchise Decisions Are Built Together.
          </h1>
        </div>
        <p class="max-w-xl text-lg leading-relaxed text-[#4d5964] lg:pb-1">
          We partner with the organizations shaping a smarter, stronger franchise industry—bringing better insight to every decision.
        </p>
      </div>
    </section>

    <section class="bg-white py-12 md:py-20" aria-labelledby="partner-network-heading">
      <div class="section-shell">

        <ul class="grid list-none grid-cols-2 gap-x-8 gap-y-12 p-0 md:grid-cols-3 md:gap-y-16 lg:grid-cols-5 lg:gap-x-10">
          {partnershipsWithLogos.map((partner) => (
            <li class="group min-w-0">
              <a
                href={partner.linkUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${partner.name}`}
                class="flex h-full min-h-[150px] flex-col items-center justify-center gap-6 px-2 text-center focus-visible:rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#09a985] md:min-h-[170px]"
              >
                <span class="flex min-h-[82px] w-full items-center justify-center">
                  {partner.logo ? (
                    <Image
                      src={partner.logo}
                      alt={`${partner.name} logo`}
                      class="h-auto max-h-[72px] w-auto max-w-full object-contain object-center transition duration-200 group-hover:-translate-y-1 group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                  ) : (
                    <span class="font-display text-2xl font-semibold tracking-tight text-[#213a5a]">
                      {partner.shortName}
                    </span>
                  )}
                </span>

                <span class="inline-flex max-w-[15rem] items-center justify-center gap-1.5 text-xs font-semibold leading-snug text-[#4d5964] transition-colors group-hover:text-[#087f65]">
                  <span>{partner.name}</span>
                  <span class="-translate-x-1 text-sm opacity-0 transition duration-200 group-hover:translate-x-0 group-hover:opacity-100" aria-hidden="true">&#8599;</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="mx-auto mt-9 max-w-2xl text-center text-base leading-relaxed text-[#657078]">
          One shared goal: helping franchise brands, advisors, and candidates make decisions with greater clarity and confidence.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>
