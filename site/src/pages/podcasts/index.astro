---
import BlogList from "../../components/BlogList.astro";
import { getPaginatedPostsByCategory } from "../../lib/blog.ts";

const PODCAST_ARCHIVE_PAGE_SIZE = 10;
const pageData = await getPaginatedPostsByCategory("podcasts", 1, PODCAST_ARCHIVE_PAGE_SIZE);
---

<BlogList
  title="Podcasts | Zorakle"
  description="Podcast episodes and franchise conversations from the Zorakle network."
  heading="Podcasts"
  emptyStateMessage="No podcast posts were found."
  basePath="/podcasts"
  postBasePath=""
  posts={pageData.posts}
  currentPage={pageData.page}
  totalPages={pageData.totalPages}
/>

