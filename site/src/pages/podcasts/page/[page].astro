---
import BlogList from "../../../components/BlogList.astro";
import {
  getArchivePaginationPaths,
  type PaginatedPosts
} from "../../../lib/blog.ts";

export async function getStaticPaths() {
  // Astro isolates getStaticPaths into its own module scope during
  // prerendering, so the page size must be defined inside it, not above.
  const podcastArchivePageSize = 10;
  return getArchivePaginationPaths("podcasts", podcastArchivePageSize);
}

interface Props {
  pageData: PaginatedPosts;
}

const { pageData } = Astro.props;
const pageTitle = `Franchise Development Podcasts - Page ${pageData.page} | Zorakle`;
---

<BlogList
  title={pageTitle}
  description="Podcast episodes and franchise conversations on franchisee selection, alignment, and what it takes to build a high-performing system, from the Zorakle network."
  heading="Podcasts"
  emptyStateMessage="No podcast posts were found."
  basePath="/podcasts"
  postBasePath=""
  posts={pageData.posts}
  currentPage={pageData.page}
  totalPages={pageData.totalPages}
  ctaTitle="Ready to put the conversation into practice?"
  ctaText="Take the ideas from our latest franchise conversations and turn them into smarter matches, stronger teams, and better outcomes with Zorakle."
/>
