---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<MainLayout title="Draft Preview | Zorakle" description="Preview a draft blog post." noindex={true}>
  <SiteHeader />
  <main class="bg-[#f7f8fb] py-14 md:py-16">
    <article class="section-shell rounded-xl bg-white px-6 py-8 shadow-sm md:px-10 md:py-10">
      <div id="preview-dashboard" class="hidden text-center px-6 max-w-md mx-auto">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[#fff4ee] text-[#a8420c] mb-5 shadow-sm">
          <svg xmlns="http://w3.org" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>

        <h2 class="font-display text-xl font-bold text-[#22252a] mb-3">Zorakle Blog Live Previewer</h2>
        <p class="text-base text-[#56586a] mb-6 leading-relaxed">
          To view or live-edit a post, please open your documents from the standard Content layout.
        </p>

        <div class="text-left bg-white border border-[#d1d4dd] rounded-xl p-5 space-y-3.5 shadow-sm text-base text-[#3b3e47]">
          <div class="flex gap-3">
            <span class="flex items-center justify-center w-5 h-5 rounded-full bg-[#22252a] text-white text-xs font-bold shrink-0">1</span>
            <span>Click the <strong class="text-[#22252a]">Structure</strong> tab at the very top of Sanity.</span>
          </div>
          <div class="flex gap-3">
            <span class="flex items-center justify-center w-5 h-5 rounded-full bg-[#22252a] text-white text-xs font-bold shrink-0">2</span>
            <span>Navigate to <strong class="text-[#22252a]">Posts</strong> and pick the blog post you want to edit.</span>
          </div>
          <div class="flex gap-3">
            <span class="flex items-center justify-center w-5 h-5 rounded-full bg-[#22252a] text-white text-xs font-bold shrink-0">3</span>
            <span>Click the <strong class="text-[#a8420c]">Preview</strong> icon button in the top right of the editor.</span>
          </div>
        </div>
      </div>
      <div id="preview-status" class="py-16 text-center text-[#56586a]">Loading draft…</div>
      <div id="preview-post" class="hidden">
        {/* Visual Editing targets the text wrapping nodes automatically */}
        <h1 id="preview-title" class="page-title mt-4"></h1>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-semibold text-[#22252a]">
          <span id="preview-date"></span>
        </div>
        <div id="preview-body" class="blog-content mt-8 border-t border-[#d1d4dd] pt-8"></div>
      </div>
    </article>
  </main>
  <SiteFooter />
</MainLayout>

<script>
  import { createClient } from "@sanity/client";
  import { toHTML, uriLooksSafe } from "@portabletext/to-html";
  import { createImageUrlBuilder } from "@sanity/image-url";
  import { enableVisualEditing } from "@sanity/visual-editing";

  const projectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID || "4kjxjblw";
  const dataset = import.meta.env.PUBLIC_SANITY_DATASET || "production";

  // FIX 1: Configure Stega directly inside your preview client
  const client = createClient({
    projectId,
    dataset,
    apiVersion: "2026-08-01",
    useCdn: false,
    perspective: "drafts",
    withCredentials: true,
    stega: {
      enabled: true,
      studioUrl: "http://localhost:3333" // Matches your standalone Studio port
    }
  });

  const imageBuilder = createImageUrlBuilder({ projectId, dataset });
  const statusEl = document.getElementById("preview-status")!;
  const postEl = document.getElementById("preview-post")!;

  function showStatus(html: string) {
    statusEl.innerHTML = html;
    statusEl.classList.remove("hidden");
    postEl.classList.add("hidden");
  }

  function escapeHtml(value: string): string {
    return value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
  }

  function toEmbeddableUrl(rawUrl: string): string {
    try {
      const parsed = new URL(rawUrl);
      const host = parsed.hostname.replace(/^www\./, "").toLowerCase();

      if (host === "youtube.com" || host === "m.youtube.com") {
        const id = parsed.searchParams.get("v");
        if (id) return `https://youtube.com{id}`;
      }

      if (host === "youtu.be") {
        const id = parsed.pathname.replace("/", "").trim();
        if (id) return `https://youtube.com{id}`;
      }

      if (host === "vimeo.com") {
        // Splitting path name segments cleanly to isolate the specific video ID token
        const id = parsed.pathname.split("/").filter(Boolean)[0];
        if (id) return `https://vimeo.com{id}`;
      }

      return rawUrl;
    } catch {
      return rawUrl;
    }
  }

  const components = {
    types: {
      image: ({ value }: { value: Record<string, unknown> }) => {
        let src = "";
        try {
          src = imageBuilder.image(value as never).width(1200).fit("max").auto("format").url();
        } catch {
          return "";
        }
        const alt = escapeHtml((value.alt as string) || "");
        const caption = (value.caption as string) || "";
        return `<figure class="my-8">
          <img src="${src}" alt="${alt}" class="w-full rounded-xl object-cover" loading="lazy" decoding="async" />
          ${caption ? `<figcaption class="mt-2 text-center text-sm text-[#56586a]">${escapeHtml(caption)}</figcaption>` : ""}
        </figure>`;
      },
      embed: ({ value }: { value: { url?: string; title?: string; provider?: string } }) => {
        const sourceUrl = typeof value?.url === "string" ? value.url.trim() : "";
        if (!sourceUrl || !uriLooksSafe(sourceUrl)) return "";
        const title = typeof value?.title === "string" ? value.title.trim() : "";
        let provider = typeof value?.provider === "string"
            ? value.provider.replace(/[\u0000-\u001F\u007F-\u009F\u200B-\u200D\uFEFF]/g, "").trim().toLowerCase()
            : "";
        const isFileVideo = /\.(mp4|webm|ogg|m4v)(\?.*)?$/i.test(sourceUrl);
        const canUseIframe = ["youtube", "vimeo", "loom", "wistia"].includes(provider);
        const caption = title ? `<figcaption class="mt-2 text-center text-sm text-[#56586a]">${escapeHtml(title)}</figcaption>` : "";
console.log(provider);
        if (isFileVideo) {
          return `<figure class="my-8"><video class="w-full rounded-xl" controls preload="metadata"><source src="${escapeHtml(sourceUrl)}" /></video>${caption}</figure>`;
        }
        if (canUseIframe) {
          return `<figure class="my-8"><iframe src="${escapeHtml(toEmbeddableUrl(sourceUrl))}" title="${escapeHtml(title || "Embedded media")}" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen style="width:100%;min-height:320px;border:0;border-radius:0.75rem;"></iframe>${caption}</figure>`;
        }
        return `<figure class="my-8"><a href="${escapeHtml(sourceUrl)}" target="_blank" rel="noopener noreferrer" class="text-[#a8420c] underline underline-offset-2">${escapeHtml(title || "Open embedded media")}</a>${caption}</figure>`;
      },
    },
  };

  const PREVIEW_QUERY = `*[_type == "post" && ( slug.current == $slug || _id == $id || _id == "drafts." + $id )] | order(_updatedAt desc){ _id, title, slug, publishedAt, _createdAt, excerpt, body }`;

  async function loadDraft() {
    const params = new URLSearchParams(window.location.search);
    const slug = params.get("slug")?.trim() || "";
    const id = (params.get("id")?.trim() || "").replace(/^drafts\./, "");

    if (!slug && !id) {
      showStatus(``);
      document.getElementById('preview-dashboard').classList.remove('hidden');
      return;
    }

    let post;
    try {
      const results = await client.fetch(PREVIEW_QUERY, { slug: slug || "__none__", id: id || "__none__" });
      post = Array.isArray(results) ? results[0] : results;
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      if (/401|403|unauthorized|permission/i.test(message)) {
        showStatus("You must be signed in to Sanity to preview drafts. Sign in through the standalone Studio, then reload this page.");
      } else {
        showStatus(`Failed to load draft: ${escapeHtml(message)}`);
      }
      return;
    }

    if (!post) {
      showStatus("No post found for this preview link. It may have been deleted.");
      return;
    }

    document.title = `${post.title || "Untitled"} (Draft Preview) | Zorakle`;

    // FIX 2: Use .innerHTML instead of .textContent.
    // This allows the hidden metadata strings (Stega comments) to attach cleanly to the document tree.
    document.getElementById("preview-title")!.innerHTML = post.title || "Untitled";

    const dateSource = post.publishedAt || post._createdAt;
    document.getElementById("preview-date")!.innerHTML = dateSource
        ? `Posted on ${new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric" }).format(new Date(dateSource))}`
        : "";

    const bodyEl = document.getElementById("preview-body")!;
    bodyEl.innerHTML = Array.isArray(post.body) && post.body.length > 0 ? toHTML(post.body, { components }) : "<p><em>This draft has no body content yet.</em></p>";

    statusEl.classList.add("hidden");
    postEl.classList.remove("hidden");
  }

  loadDraft();

  enableVisualEditing({
    refresh: async (payload) => {
      if (payload.source === "mutation") {
        await loadDraft();
        return true;
      }
      return false;
    }
  });
</script>

<style is:global>
  /* FIX 3: Global Interactive Edit Box Styles */
  /* This automatically styles the overlay targets generated by enableVisualEditing */
  [data-sanity] {
    outline: 1px dashed rgba(59, 130, 246, 0.3);
    outline-offset: 4px;
    transition: all 0.15s ease-in-out;
  }
  [data-sanity]:hover {
    outline: 2px solid rgb(59, 130, 246);
    background-color: rgba(59, 130, 246, 0.03);
    cursor: pointer;
  }

  .blog-content { color: #3b3e47; line-height: 1.8; font-size: clamp(1rem, 0.25vw + 0.95rem, 1.125rem); }
  .blog-content > * + * { margin-top: 1.25rem; }
  .blog-content h1, .blog-content h2, .blog-content h3, .blog-content h4 { font-family: "MontereyFLF", "Century Gothic", "Avenir Next", sans-serif; color: #22252a; line-height: 1.25; margin-top: 2rem; margin-bottom: 0.75rem; }
  .blog-content a { color: #a8420c; text-decoration: underline; text-underline-offset: 2px; }
  .blog-content img { max-width: 100%; height: auto; border-radius: 0.75rem; }
  .blog-content video { width: 100%; border-radius: 0.75rem; }
</style>
