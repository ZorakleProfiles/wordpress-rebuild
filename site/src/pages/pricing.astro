---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<MainLayout
  title="Pricing | Zorakle"
  description="Build your Zorakle subscription - choose your account type and billing method."
>
  <SiteHeader />

  <main class="bg-white min-h-screen">

    <!-- Main Content -->
    <div class="mx-auto w-[min(1400px,calc(100%-2rem))] py-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Left Column: Form -->
        <div class="lg:col-span-2">
          <form id="pricing-form" class="space-y-12">
            <!-- Section 1: Account Type Selection -->
            <div>
              <div class="flex items-center gap-3 mb-8">
                <div class="w-8 h-8 rounded-full bg-[#22252a] text-white text-sm font-bold flex items-center justify-center">1</div>
                <h2 class="text-2xl font-bold text-[#22252a]">I am a...</h2>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Franchisor Option -->
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="account-type"
                    value="franchisor"
                    class="sr-only"
                    data-account-type-input
                  />
                  <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg" data-account-type-option="franchisor">
                    <h3 class="text-lg font-bold text-[#22252a] mb-2">A Franchisor</h3>
                    <p class="text-sm text-[#72767e]">You award franchises. We model your system.</p>
                  </div>
                </label>

                <!-- Broker Option -->
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="account-type"
                    value="broker"
                    class="sr-only"
                    data-account-type-input
                  />
                  <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg" data-account-type-option="broker">
                    <h3 class="text-lg font-bold text-[#22252a] mb-2">A Broker</h3>
                    <p class="text-sm text-[#72767e]">You place candidates. We match them to brands.</p>
                  </div>
                </label>
              </div>
            </div>

            <!-- Section 2: Account Tier Selection (Franchisor) -->
            <div data-tier-section="franchisor" class="hidden">
              <div class="flex items-center gap-3 mb-8">
                <div class="w-8 h-8 rounded-full bg-[#22252a] text-white text-sm font-bold flex items-center justify-center">2</div>
                <h2 class="text-2xl font-bold text-[#22252a]">My account type</h2>
              </div>
              <p class="text-[#72767e] mb-6 text-sm">Each one adds to the one above it.</p>

              <div class="space-y-4">
                <!-- Match Only -->
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="tier"
                    value="match-only"
                    class="sr-only"
                    data-tier-input
                  />
                  <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg" data-tier-option="match-only">
                    <div class="flex items-start justify-between mb-4">
                      <div>
                        <div class="flex items-center gap-2 mb-2">
                          <h3 class="text-lg font-bold text-[#22252a]">SpotOn! Match Only</h3>
                          <span class="text-xs uppercase tracking-wider text-[#72767e] font-semibold">ANY SYSTEM SIZE</span>
                        </div>
                        <p class="text-sm text-[#72767e] ml-5">Work only the candidates your brokers refer to you.</p>
                      </div>
                    </div>
                    <div class="ml-5 space-y-2">
                      <div class="flex items-center gap-2">
                        <span class="text-[#09cc9c] text-sm">✓</span>
                        <span class="text-sm text-[#22252a]">No setup fee, no commitment</span>
                      </div>
                    </div>
                  </div>
                </label>

                <!-- Emerging Franchisor -->
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="tier"
                    value="emerging"
                    class="sr-only"
                    data-tier-input
                  />
                  <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg" data-tier-option="emerging">
                    <div class="flex items-start justify-between mb-4">
                      <div class="flex-1">
                        <div class="flex items-center gap-2 mb-2">
                          <h3 class="text-lg font-bold text-[#22252a]">Emerging Franchisor</h3>
                          <span class="text-xs uppercase tracking-wider text-[#72767e] font-semibold">UNDER 30 FRANCHISEES</span>
                        </div>
                        <p class="text-sm text-[#72767e] ml-5">Your own leads, scored by an algorithm built from your system.</p>
                      </div>
                      <div class="text-right whitespace-nowrap ml-4">
                        <div class="text-2xl font-bold text-[#22252a]">$55</div>
                        <div class="text-xs text-[#72767e]">per SpotOn! Profile</div>
                      </div>
                    </div>
                    <div class="ml-5 space-y-2">
                      <div class="flex items-center gap-2">
                        <span class="text-[#09cc9c] text-sm">✓</span>
                        <span class="text-sm text-[#22252a]">Adds unlimited profiles on your own leads</span>
                      </div>
                    </div>
                  </div>
                </label>

                <!-- Established Franchisor -->
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="tier"
                    value="established"
                    class="sr-only"
                    data-tier-input
                  />
                  <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg" data-tier-option="established">
                    <div class="flex items-start justify-between mb-4">
                      <div class="flex-1">
                        <div class="flex items-center gap-2 mb-2">
                          <h3 class="text-lg font-bold text-[#22252a]">Established Franchisor</h3>
                          <span class="text-xs uppercase tracking-wider text-[#72767e] font-semibold">30+ FRANCHISEES</span>
                        </div>
                        <p class="text-sm text-[#72767e] ml-5">Benchmark the franchisees you already have, then predict against them.</p>
                      </div>
                      <div class="text-right whitespace-nowrap ml-4">
                        <div class="text-2xl font-bold text-[#22252a]">$55</div>
                        <div class="text-xs text-[#72767e]">per SpotOn! Profile</div>
                      </div>
                    </div>
                    <div class="ml-5 space-y-2">
                      <div class="flex items-center gap-2">
                        <span class="text-[#09cc9c] text-sm">✓</span>
                        <span class="text-sm text-[#22252a]">Adds current-franchisee benchmarking</span>
                      </div>
                    </div>
                  </div>
                </label>
              </div>
            </div>

            <!-- Section 2: Account Tier Selection (Broker) -->
            <div data-tier-section="broker" class="hidden">
              <div class="flex items-center gap-3 mb-8">
                <div class="w-8 h-8 rounded-full bg-[#22252a] text-white text-sm font-bold flex items-center justify-center">2</div>
                <h2 class="text-2xl font-bold text-[#22252a]">My account type</h2>
              </div>

              <div class="rounded-2xl border-2 border-[#09cc9c] bg-[#f0fffe] p-6">
                <div class="flex items-center gap-2 mb-4">
                  <h3 class="text-lg font-bold text-[#22252a]">The Broker Account</h3>
                </div>
                <p class="text-sm text-[#72767e] mb-6">Match every candidate against every franchisor in the network.</p>
                <ul class="space-y-3 ml-5">
                  <li class="flex items-start gap-2">
                    <span class="text-[#09cc9c] text-sm mt-0.5">✓</span>
                    <span class="text-sm text-[#22252a]">Candidates matched to the Zorakle franchisor database</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-[#09cc9c] text-sm mt-0.5">✓</span>
                    <span class="text-sm text-[#22252a]">Unlimited SpotOn! Profiles for your clients</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-[#09cc9c] text-sm mt-0.5">✓</span>
                    <span class="text-sm text-[#22252a]">Eclipse Candidate Reports</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-[#09cc9c] text-sm mt-0.5">✓</span>
                    <span class="text-sm text-[#22252a]">Your company branding</span>
                  </li>
                </ul>
                <div class="flex flex-wrap gap-2 mt-6">
                  <span class="inline-block bg-[#e2e5ee] text-[#22252a] text-xs font-semibold px-3 py-1 rounded-full">No setup fee</span>
                  <span class="inline-block bg-[#e2e5ee] text-[#22252a] text-xs font-semibold px-3 py-1 rounded-full">No audit required</span>
                  <span class="inline-block bg-[#e2e5ee] text-[#22252a] text-xs font-semibold px-3 py-1 rounded-full">Cancel anytime</span>
                </div>
              </div>
            </div>

            <!-- Section 3: Billing Method -->
            <div>
              <div class="flex items-center gap-3 mb-8">
                <div class="w-8 h-8 rounded-full bg-[#22252a] text-white text-sm font-bold flex items-center justify-center">3</div>
                <h2 class="text-2xl font-bold text-[#22252a]">How I want to pay</h2>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 hidden" data-billing-section="franchisor">
                <!-- Monthly -->
                <label class="cursor-pointer">
                  <input type="radio" name="billing" value="monthly" class="sr-only" data-billing-input />
                  <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg h-full flex flex-col" data-billing-option="monthly">
                    <h3 class="text-lg font-bold text-[#22252a] mb-2">Monthly</h3>
                    <p class="text-sm text-[#72767e]">Cancel any month. Billed on the same day each month.</p>
                  </div>
                </label>

                <!-- Annual -->
                <label class="cursor-pointer">
                  <input type="radio" name="billing" value="annual" class="sr-only" data-billing-input />
                  <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg h-full flex flex-col" data-billing-option="annual">
                    <h3 class="text-lg font-bold text-[#22252a] mb-2">Annual</h3>
                    <p class="text-sm text-[#72767e]">Billed once. Includes two months free.</p>
                  </div>
                </label>

                <!-- Pay as you go -->
                <label class="cursor-pointer">
                  <input type="radio" name="billing" value="paygo" class="sr-only" data-billing-input />
                  <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg h-full flex flex-col" data-billing-option="paygo">
                    <h3 class="text-lg font-bold text-[#22252a] mb-2">Pay as you go</h3>
                    <p class="text-sm text-[#72767e]">No subscription. Pay only per SpotOn! Profile you run.</p>
                  </div>
                </label>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 hidden" data-billing-section="broker">
                <!-- Monthly -->
                <label class="cursor-pointer">
                  <input type="radio" name="billing" value="monthly" class="sr-only" data-billing-input />
                  <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg h-full flex flex-col" data-billing-option="monthly">
                    <h3 class="text-lg font-bold text-[#22252a] mb-2">Monthly</h3>
                    <div class="text-xl font-bold text-[#22252a] mb-1">$79</div>
                    <div class="text-xs text-[#72767e]">/mo</div>
                    <p class="text-xs text-[#09cc9c] font-semibold mt-2">$20 off</p>
                    <p class="text-xs text-[#72767e] mt-2">Cancel any month. Billed on the same day each month.</p>
                  </div>
                </label>

                <!-- Annual -->
                <label class="cursor-pointer">
                  <input type="radio" name="billing" value="annual" class="sr-only" data-billing-input />
                  <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg h-full flex flex-col" data-billing-option="annual">
                    <div class="inline-block bg-[#09cc9c] text-white text-xs font-bold px-2 py-1 rounded mb-2 w-fit">BEST VALUE</div>
                    <h3 class="text-lg font-bold text-[#22252a] mb-1">Annual</h3>
                    <div class="text-xl font-bold text-[#22252a] mb-1">$790</div>
                    <div class="text-xs text-[#72767e]">/yr</div>
                    <p class="text-xs text-[#09cc9c] font-semibold mt-2">$398 saved</p>
                    <p class="text-xs text-[#72767e] mt-2">Billed once. Includes two months free.</p>
                  </div>
                </label>

                <!-- Pay per profile -->
                <label class="cursor-pointer">
                  <input type="radio" name="billing" value="paygo" class="sr-only" data-billing-input />
                  <div class="rounded-2xl border-2 border-[#d1d4dd] bg-white p-6 transition hover:shadow-lg h-full flex flex-col" data-billing-option="paygo">
                    <h3 class="text-lg font-bold text-[#22252a] mb-1">Pay as you go</h3>
                    <div class="text-xl font-bold text-[#22252a] mb-1">$55</div>
                    <div class="text-xs text-[#72767e]">per profile</div>
                    <p class="text-xs text-[#09cc9c] font-semibold mt-2">$14 off each</p>
                    <p class="text-xs text-[#72767e] mt-2">No subscription. Pay only per SpotOn! Profile you run.</p>
                  </div>
                </label>
              </div>
            </div>
          </form>
        </div>

        <!-- Right Column: Summary Card -->
        <div class="lg:col-span-1">
          <div class="sticky top-6 rounded-3xl border-2 border-[#d1d4dd] bg-[#f0fffe] text-[#22252a] p-8">
            <div class="text-xs uppercase tracking-widest text-[#72767e] mb-4">Your Subscription</div>

            <h2 class="text-3xl font-bold mb-2" data-summary-title>Build your subscription</h2>
            <p class="text-sm text-[#72767e] mb-8" data-summary-subtitle>Select your account type, then choose billing.</p>

            <div class="space-y-4 pb-8 border-b border-[#d1d4dd]">
              <div>
                <div class="text-xs uppercase tracking-widest text-[#72767e] mb-1">Billing</div>
                <div class="text-sm font-semibold text-[#22252a]" data-summary-billing>Not selected</div>
              </div>
              <div>
                <div class="text-xs uppercase tracking-widest text-[#72767e] mb-1">One-time setup</div>
                <div class="text-sm font-semibold text-[#22252a]" data-summary-setup>None</div>
              </div>
            </div>

            <div class="mt-8 mb-8">
              <div class="text-xs uppercase tracking-widest text-[#72767e] mb-3">Due today</div>
              <div class="text-2xl font-bold text-[#22252a]" data-summary-price>—</div>
              <p class="text-xs text-[#72767e] mt-3" data-summary-note>Make your selections to continue.</p>
            </div>

            <button
              class="w-full bg-[#fd7730] hover:bg-[#e56620] text-[#22252a] font-bold py-4 rounded-2xl transition mb-4"
              data-continue-btn
            >
              Continue to your details →
            </button>

            <p class="text-xs text-[#72767e] text-center">
              Match Only is a subscription account: every profile is referred to you by a broker, so there is nothing to meter or schedule a live demo first
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />
</MainLayout>

<script>
  // Account type switching
  const accountTypeInputs = document.querySelectorAll('[data-account-type-input]');
  const accountTypeOptions = document.querySelectorAll('[data-account-type-option]');
  const tierSections = document.querySelectorAll('[data-tier-section]');
  const billingSections = document.querySelectorAll('[data-billing-section]');
  const tierInputs = document.querySelectorAll('[data-tier-input]');
  const tierOptions = document.querySelectorAll('[data-tier-option]');
  const billingInputs = document.querySelectorAll('[data-billing-input]');
  const billingOptions = document.querySelectorAll('[data-billing-option]');

  function setOptionStyles(option: Element, isSelected: boolean) {
    if (isSelected) {
      option.classList.remove('border-[#d1d4dd]', 'bg-white');
      option.classList.add('border-[#09cc9c]', 'bg-[#f0fffe]');
    } else {
      option.classList.remove('border-[#09cc9c]', 'bg-[#f0fffe]');
      option.classList.add('border-[#d1d4dd]', 'bg-white');
    }
  }

  function resetTierAndBillingSelections() {
    tierInputs.forEach((tierInput) => {
      (tierInput as HTMLInputElement).checked = false;
    });
    billingInputs.forEach((billingInput) => {
      (billingInput as HTMLInputElement).checked = false;
    });
    tierOptions.forEach((option) => setOptionStyles(option, false));
    billingOptions.forEach((option) => setOptionStyles(option, false));
  }

  accountTypeInputs.forEach((input) => {
    input.addEventListener('change', () => {
      const accountType = (input as HTMLInputElement).value;

      // Update account type options styling
      accountTypeOptions.forEach((option) => {
        const optionType = option.getAttribute('data-account-type-option');
        setOptionStyles(option, optionType === accountType);
      });

      // Question 1 controls the flow, so switching account type clears downstream answers.
      resetTierAndBillingSelections();

      // Update tier sections visibility
      tierSections.forEach((section) => {
        const sectionType = section.getAttribute('data-tier-section');
        if (sectionType === accountType) {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });

      // Update billing sections visibility
      billingSections.forEach((section) => {
        const sectionType = section.getAttribute('data-billing-section');
        if (sectionType === accountType) {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });

      updateSummary();
    });
  });

  // Tier selection
  tierInputs.forEach((input) => {
    input.addEventListener('change', () => {
      const tier = (input as HTMLInputElement).value;

      tierOptions.forEach((option) => {
        const optionTier = option.getAttribute('data-tier-option');
        setOptionStyles(option, optionTier === tier);
      });

      updateSummary();
    });
  });

  // Billing selection
  billingInputs.forEach((input) => {
    input.addEventListener('change', () => {
      billingOptions.forEach((option) => setOptionStyles(option, false));

      const selectedOption = input.parentElement?.querySelector('[data-billing-option]');
      if (selectedOption) {
        setOptionStyles(selectedOption, true);
      }

      updateSummary();
    });
  });

  // Update summary card
  function updateSummary() {
    const accountType = (document.querySelector('[data-account-type-input]:checked') as HTMLInputElement)?.value;
    const tier = (document.querySelector('[data-tier-input]:checked') as HTMLInputElement)?.value;
    const billing = (document.querySelector('[data-billing-input]:checked') as HTMLInputElement)?.value;

    const titles: { [key: string]: string } = {
      'match-only': 'SpotOn! Match Only',
      'emerging': 'Emerging Franchisor',
      'established': 'Established Franchisor'
    };

    const tierNames: { [key: string]: string } = {
      'match-only': 'SpotOn! Match Only',
      'emerging': 'Emerging Franchisor',
      'established': 'Established Franchisor'
    };

    const billingNames: { [key: string]: string } = {
      'monthly': 'Monthly',
      'annual': 'Annual',
      'paygo': 'Pay as you go'
    };

    const setupFees: { [key: string]: string } = {
      'match-only': 'None',
      'emerging': '$1,500',
      'established': '$2,500'
    };

    const titleEl = document.querySelector('[data-summary-title]');
    const subtitleEl = document.querySelector('[data-summary-subtitle]');
    const tierEl = document.querySelector('[data-summary-tier]');
    const billingEl = document.querySelector('[data-summary-billing]');
    const setupEl = document.querySelector('[data-summary-setup]');
    const priceEl = document.querySelector('[data-summary-price]');
    const noteEl = document.querySelector('[data-summary-note]');

    if (!accountType) {
      if (titleEl) titleEl.textContent = 'Build your subscription';
      if (subtitleEl) subtitleEl.textContent = 'Select your account type, then choose billing.';
      if (tierEl) tierEl.textContent = 'Not selected';
      if (billingEl) billingEl.textContent = 'Not selected';
      if (setupEl) setupEl.textContent = 'None';
      if (priceEl) priceEl.textContent = '—';
      if (noteEl) noteEl.textContent = 'Make your selections to continue.';
      return;
    }

    const isBroker = accountType === 'broker';
    const resolvedTier = isBroker ? 'broker-account' : tier;
    const tierLabel = isBroker ? 'The Broker Account' : (tier ? tierNames[tier] : 'Not selected');
    const billingLabel = billing ? billingNames[billing] : 'Not selected';

    if (titleEl) titleEl.textContent = isBroker ? 'The Broker Account' : (resolvedTier ? titles[resolvedTier] ?? 'Choose your account type' : 'Choose your account type');
    if (subtitleEl) subtitleEl.textContent = `${isBroker ? 'Broker' : 'Franchisor'} account${billing ? ` · ${billingLabel} billing` : ''}`;
    if (tierEl) tierEl.textContent = tierLabel;
    if (billingEl) billingEl.textContent = billingLabel;
    if (setupEl && !isBroker) setupEl.textContent = tier ? setupFees[tier] : 'None';
    if (setupEl && isBroker) setupEl.textContent = 'None';

    // Update price display
    if (priceEl) {
      if (!billing) {
        priceEl.textContent = '—';
        if (noteEl) noteEl.textContent = 'Choose a billing option to continue.';
      } else if (billing === 'paygo' && tier === 'match-only') {
        priceEl.textContent = '—';
        if (noteEl) noteEl.textContent = 'Pick Monthly or Annual to continue with this account.';
      } else if (isBroker) {
        if (billing === 'monthly') {
          priceEl.textContent = '$79/mo';
          if (noteEl) noteEl.textContent = 'First month due today.';
        } else if (billing === 'annual') {
          priceEl.textContent = '$790/yr';
          if (noteEl) noteEl.textContent = 'Due today.';
        } else {
          priceEl.textContent = '$55 per profile';
          if (noteEl) noteEl.textContent = 'Charged as you use SpotOn! Profiles.';
        }
      } else if (!tier) {
        priceEl.textContent = '—';
        if (noteEl) noteEl.textContent = 'Choose an account type before continuing.';
      } else if (tier === 'match-only') {
        priceEl.textContent = '—';
        if (noteEl) noteEl.textContent = 'Pick Monthly or Annual to continue with this account.';
      } else if (billing === 'monthly') {
        priceEl.textContent = 'From $316/mo';
        if (noteEl) noteEl.textContent = 'First month due today.';
      } else if (billing === 'annual') {
        priceEl.textContent = 'From $3,160/yr';
        if (noteEl) noteEl.textContent = 'Due today.';
      } else {
        priceEl.textContent = '$55 per profile';
        if (noteEl) noteEl.textContent = 'Charged as you run SpotOn! Profiles.';
      }
    }
  }

  // Initialize
  updateSummary();
</script>


