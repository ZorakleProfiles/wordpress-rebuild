---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---
<MainLayout
        title="SpotOn! Reports Request | Zorakle"
        description="request demos of our SpotOn! reports"
>
    <SiteHeader />
    <section class="">
        <div class="section-shell">
            <div class="relative flex flex-col justify-between px-7 py-10  md:px-12 md:py-14 lg:px-14 lg:py-16">
                <div class="mb-10">
                    <h1 class="page-title">Unlock Zorakle Sample Reports</h1>
                    <p class="section-copy max-w-3xl">
                    Ready to explore? Let us know where to send your copies.
                    </p>
                </div>
        <script charset="utf-8" type="text/javascript" src="//js.hsforms.net/forms/embed/v2.js"></script>
        <script>
            hbspt.forms.create({
                portalId: "2403148",
                formId: "f07010b8-8664-4d70-860c-2c0e13e5f880",
                region: "na1"
            });
        </script>
            </div>
        </div>
    </section>

</MainLayout>
