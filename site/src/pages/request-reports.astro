---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<MainLayout
        title="Request Sample SpotOn! Reports | Zorakle"
        description="See real Zorakle output before you buy. Request a sample SpotOn! Profile and Eclipse Profile and we'll send copies to your inbox."
>
    <SiteHeader />
    <main>
      <section class="">
          <div class="section-shell">
              <div class="relative flex flex-col justify-between px-7 py-10  md:px-12 md:py-14 lg:px-14 lg:py-16">
                  <div class="mb-10">
                      <h1 class="page-title">Unlock Zorakle sample reports</h1>
                      <p class="section-copy max-w-3xl">
                      Ready to explore? Let us know where to send your copies.
                      </p>
                  </div>
                  {/*
                    Reserve space for the HubSpot form so it doesn't shove the
                    footer down when it finishes rendering (CLS). Kept slightly
                    generous on purpose: a little trailing whitespace causes no
                    layout shift, an under-estimate does.
                  */}
                  <div
                    id="report-request-form"
                    class="min-h-[580px] sm:min-h-[520px]"
                    data-hs-form
                  ></div>
              </div>
          </div>
      </section>
    </main>

    <SiteFooter />
</MainLayout>

<script is:inline>
  (function () {
    var target = "#report-request-form";
    function build() {
      if (!window.hbspt) return;
      var mount = document.querySelector(target);
      if (!mount || mount.dataset.hsInit === "true") return;
      mount.dataset.hsInit = "true";
      window.hbspt.forms.create({
        portalId: "2403148",
        formId: "f07010b8-8664-4d70-860c-2c0e13e5f880",
        region: "na1",
        target: target
      });
    }
    var s = document.createElement("script");
    s.src = "https://js.hsforms.net/forms/embed/v2.js";
    s.async = true;
    s.defer = true;
    s.addEventListener("load", build);
    document.head.appendChild(s);
  })();
</script>
