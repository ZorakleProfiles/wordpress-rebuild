---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<MainLayout
  title="Book a Zorakle Consultation | Franchisee Assessment Software"
  description="See how Zorakle's science-backed franchisee selection and matching tools work. Book a live demo with our team and get answers specific to your franchise system or brokerage."
>
  <SiteHeader />

  <main class="bg-white">
    <section class="border-b border-[#d1d4dd] bg-[#f4f5f7] py-10 md:py-12">
      <div class="section-shell">
        <p class="section-eyebrow">Book a Consultation</p>
        <h1 class="page-title mt-4">Let’s Talk About Better Fit</h1>
        <p class="mt-4 text-base leading-relaxed text-[#3b3e47] md:text-lg">
          Let’s explore how science and technology can bring greater clarity to your decisions and better outcomes for everyone. Choose a time that works for you.
        </p>
      </div>
    </section>

    <section class="py-10 md:py-14">
      <div class="section-shell">
        <!-- Start of Meetings Embed Script -->
        <div
          class="meetings-iframe-container"
          data-src="https://meetings.hubspot.com/rebecca12/website?embed=true"
        ></div>
        <script
          type="text/javascript"
          src="https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js"
        ></script>
        <!-- End of Meetings Embed Script -->
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>
