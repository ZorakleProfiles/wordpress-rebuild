---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CtaBand from "../components/CtaBand.astro";
import Video from "../components/Video.astro";
import sciencePoster from "../assets/sciences-poster.png";
import { scienceTopics } from "../data/sciences";

const totalLessons = scienceTopics.reduce((total, topic) => total + topic.lessons.length, 0);

const siteHref = Astro.site?.href ?? "https://www.zorakleprofiles.com/";
const pageUrl = new URL("/science/", Astro.site ?? siteHref).href;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: siteHref },
        { "@type": "ListItem", position: 2, name: "The Science", item: pageUrl }
      ]
    },
    {
      "@type": "ItemList",
      name: "The SpotOn! science framework",
      itemListElement: scienceTopics.map((topic, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: topic.title,
        url: new URL(`/sciences/${topic.slug}/`, Astro.site ?? siteHref).href
      }))
    }
  ]
});
---

<MainLayout
  title="The Science Behind Zorakle | Franchisee Assessment Framework"
  description="Explore the validated behavioral, psychological, and organizational research behind Zorakle's SpotOn! framework, including values, stage of growth, culture, work style, and competencies."
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <SiteHeader />

  <main>
    <section class="border-b border-[#d1d4dd] bg-[#f4f5f7] py-12 md:py-16">
      <div class="section-shell grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center">
        <div class="max-w-2xl">
          <p class="section-eyebrow">The Science</p>
          <h1 class="page-title mt-4">The science behind franchise fit.</h1>
          <p class="mt-5 text-base leading-relaxed text-[#3b3e47] md:text-lg">
            Zorakle integrates seven validated sciences from institutions like Stanford, Harvard
            Business School, Gallup, and the University of Michigan. The SpotOn! framework brings
            values, stage of growth, culture, work style, and competencies together to create a
            fuller, more predictive view of how a candidate will perform in a specific franchise
            system.
          </p>
          <div class="mt-8 flex flex-wrap gap-3 text-sm font-semibold text-[#56586a]">
            <span class="rounded-full bg-white px-4 py-2">{scienceTopics.length} topics</span>
            <span class="rounded-full bg-white px-4 py-2">{totalLessons} video lessons</span>
            <span class="rounded-full bg-white px-4 py-2">Learn at your own pace</span>
          </div>
        </div>

        <Video
          poster={sciencePoster}
          posterAlt="Zorakle Science: The Science Behind Franchise Success"
          videoId="1037075151"
          playLabel="Play the Zorakle science overview"
          modalTitle="Zorakle science overview"
          frameClass="rounded-3xl border border-white/20 bg-[#111419] shadow-2xl"
        />
      </div>
    </section>

    <section class="bg-white py-14 md:py-20">
      <div class="section-shell">
        <h2 class="section-title max-w-4xl">SpotOn! Basics</h2>
        <p class="mt-4 max-w-3xl text-lg text-[#3b3e47]">
          Start with the overview, then explore how each part of the science works together to
          create a more complete picture of fit.
        </p>

        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {scienceTopics.map((topic, index) => (
            <a
              href={`/sciences/${topic.slug}`}
              class:list={[
                "group flex flex-col rounded-2xl border bg-white p-6 transition hover:-translate-y-0.5 hover:border-[#09cc9c] hover:shadow-lg md:p-8",
                index === 0 ? "border-[#09cc9c] md:col-span-2" : "border-[#d1d4dd]"
              ]}
            >
              <div class="flex items-start justify-between gap-4">
                <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#287867]">
                  {index === 0 ? "Start here" : `Topic ${String(index + 1).padStart(2, "0")}`}
                </p>
                <span class="rounded-full bg-[#f4f6f9] px-3 py-1 text-xs font-semibold text-[#56586a]">
                  {topic.lessons.length} {topic.lessons.length === 1 ? "lesson" : "lessons"}
                </span>
              </div>
              <h3 class="mt-3 font-display text-2xl font-bold text-[#22252a] transition group-hover:text-[#a8420c] md:text-3xl">
                {topic.title}
              </h3>
              <p class="mt-3 line-clamp-3 flex-1 leading-relaxed text-[#3b3e47]">{topic.summary}</p>
              <p class="mt-6 text-sm font-bold text-[#c84f10]">Explore this topic →</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <CtaBand
      title="See the science applied to your candidates."
      text="Book a demo and we'll show you how the SpotOn! framework scores fit for your franchise system or brokerage."
    />
  </main>

  <SiteFooter />
</MainLayout>
