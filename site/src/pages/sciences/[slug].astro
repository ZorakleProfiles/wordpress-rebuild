---
import MainLayout from "../../layouts/MainLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Help from "../../components/Help.astro";
import ScienceVideoCard from "../../components/ScienceVideoCard.astro";
import { scienceTopics, type ScienceTopic } from "../../data/sciences";

interface Props {
  topic: ScienceTopic;
}

export function getStaticPaths() {
  return scienceTopics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic }
  }));
}

const { topic } = Astro.props as Props;
const currentIndex = scienceTopics.findIndex((item) => item.slug === topic.slug);
const previousTopic = currentIndex > 0 ? scienceTopics[currentIndex - 1] : undefined;
const nextTopic = currentIndex < scienceTopics.length - 1 ? scienceTopics[currentIndex + 1] : undefined;
---

<MainLayout title={`${topic.title} | Zorakle`} description={topic.summary}>
  <SiteHeader />

  <main>
    <section class="border-b border-[#d1d4dd] bg-white py-16 md:py-20">
      <div class="section-shell">
        <a href="/support?tab=science" class="inline-flex items-center gap-2 text-sm font-bold text-[#c84f10] hover:underline">
          &larr; Back to all science topics
        </a>

        <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_280px] lg:items-start">
          <div>
            <p class="section-eyebrow">The Science</p>
            <h1 class="mt-4 font-display text-4xl font-bold text-[#22252a] md:text-5xl">{topic.title}</h1>
            <p class="mt-5 max-w-3xl text-lg leading-relaxed text-[#3b3e47]">{topic.summary}</p>
          </div>

          <nav aria-label="Science topics" class="rounded-2xl border border-[#d1d4dd] bg-[#f4f6f9] p-4">
            <p class="px-3 pb-2 text-xs font-bold uppercase tracking-[0.14em] text-[#56586a]">SpotOn! Basics</p>
            <ul class="space-y-1">
              {scienceTopics.map((item) => (
                <li>
                  <a
                    href={`/sciences/${item.slug}`}
                    aria-current={item.slug === topic.slug ? "page" : undefined}
                    class:list={[
                      "block rounded-lg px-3 py-2 text-sm font-semibold transition",
                      item.slug === topic.slug
                        ? "bg-white text-[#22252a] shadow-sm"
                        : "text-[#3b3e47] hover:bg-white hover:text-[#fd7730]"
                    ]}
                  >
                    {item.shortTitle}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>

        {topic.slug === "overview" ? (
          <section class="mt-10 rounded-2xl border border-[#09cc9c]/40 bg-[#eafaf6] p-6 md:p-8">
            <h2 class="font-display text-2xl font-bold text-[#22252a]">Continue through the SpotOn! framework</h2>
            <p class="mt-3 text-[#3b3e47]">After the overview, explore each part of the science in sequence.</p>
            <div class="mt-5 flex flex-wrap gap-3">
              {scienceTopics.slice(1).map((item) => (
                <a
                  href={`/sciences/${item.slug}`}
                  class="rounded-lg border border-[#72cbb7] bg-white px-4 py-2 text-sm font-bold text-[#22252a] transition hover:border-[#fd7730] hover:text-[#c84f10]"
                >
                  {item.shortTitle} →
                </a>
              ))}
            </div>
          </section>
        ) : null}

        <div class="mt-12 space-y-10">
          {topic.lessons.map((lesson) => <ScienceVideoCard lesson={lesson} />)}
        </div>

        <nav aria-label="Previous and next science topics" class="mt-12 grid gap-4 border-t border-[#d1d4dd] pt-8 sm:grid-cols-2">
          {previousTopic ? (
            <a href={`/sciences/${previousTopic.slug}`} class="rounded-xl border border-[#d1d4dd] p-5 transition hover:border-[#09cc9c] hover:shadow-md">
              <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#56586a]">Previous topic</span>
              <span class="mt-2 block font-display text-xl font-bold text-[#22252a]">← {previousTopic.shortTitle}</span>
            </a>
          ) : <span></span>}
          {nextTopic ? (
            <a href={`/sciences/${nextTopic.slug}`} class="rounded-xl border border-[#d1d4dd] p-5 text-right transition hover:border-[#09cc9c] hover:shadow-md">
              <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#56586a]">Next topic</span>
              <span class="mt-2 block font-display text-xl font-bold text-[#22252a]">{nextTopic.shortTitle} →</span>
            </a>
          ) : <span></span>}
        </nav>
      </div>
    </section>

    <Help />
  </main>

  <SiteFooter />
</MainLayout>
