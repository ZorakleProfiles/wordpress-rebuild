---
import MainLayout from "../../layouts/MainLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Help from "../../components/Help.astro";
import { scienceTopics } from "../../data/sciences";

const totalLessons = scienceTopics.reduce((total, topic) => total + topic.lessons.length, 0);
---

<MainLayout
  title="SpotOn! Science Basics | Zorakle"
  description="Learn the foundations of the SpotOn! science framework through 20 lessons on values, stage of growth, culture, work style, and competencies."
>
  <SiteHeader />

  <main>
    <section class="border-b border-[#d1d4dd] bg-white py-16 md:py-20">
      <div class="section-shell">
        <p class="section-eyebrow">The Science</p>
        <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold text-[#22252a] md:text-5xl">
          SpotOn! Basics
        </h1>
        <p class="mt-4 max-w-3xl text-lg text-[#3b3e47]">
          Build a practical understanding of the science behind Zorakle. Start with the overview, then explore how values, stage of growth, culture, work style, and competencies work together to create a more complete picture of fit.
        </p>

        <div class="mt-8 flex flex-wrap gap-3 text-sm font-semibold text-[#56586a]">
          <span class="rounded-full bg-[#f4f6f9] px-4 py-2">6 topics</span>
          <span class="rounded-full bg-[#f4f6f9] px-4 py-2">{totalLessons} video lessons</span>
          <span class="rounded-full bg-[#f4f6f9] px-4 py-2">Learn at your own pace</span>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {scienceTopics.map((topic, index) => (
            <a
              href={`/sciences/${topic.slug}`}
              class:list={[
                "group flex flex-col rounded-2xl border bg-white p-6 transition hover:-translate-y-0.5 hover:border-[#09cc9c] hover:shadow-lg md:p-8",
                index === 0 ? "border-[#09cc9c] md:col-span-2" : "border-[#d1d4dd]"
              ]}
            >
              <div class="flex items-start justify-between gap-4">
                <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#287867]">
                  {index === 0 ? "Start here" : `Topic ${String(index + 1).padStart(2, "0")}`}
                </p>
                <span class="rounded-full bg-[#f4f6f9] px-3 py-1 text-xs font-semibold text-[#56586a]">
                  {topic.lessons.length} {topic.lessons.length === 1 ? "lesson" : "lessons"}
                </span>
              </div>
              <h2 class="mt-3 font-display text-2xl font-bold text-[#22252a] transition group-hover:text-[#fd7730] md:text-3xl">
                {topic.title}
              </h2>
              <p class="mt-3 line-clamp-3 flex-1 leading-relaxed text-[#3b3e47]">{topic.summary}</p>
              <p class="mt-6 text-sm font-bold text-[#c84f10]">Explore this topic →</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <Help />
  </main>

  <SiteFooter />
</MainLayout>
