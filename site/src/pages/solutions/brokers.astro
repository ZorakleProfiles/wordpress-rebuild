---
import MainLayout from "../../layouts/MainLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import TestimonialCarousel from "../../components/TestimonialCarousel.astro";
import WorkflowStepsSection from "../../components/WorkflowStepsSection.astro";
import ToolsShowcaseSection from "../../components/ToolsShowcaseSection.astro";
import MetricsTimelineSection from "../../components/MetricsTimelineSection.astro";
import heroBackground from "../../assets/broker-poster.png";
import spotOnProfileReport from "../../assets/spoton.png";
import spotonMatch from "../../assets/spoton_match.png";
import CtaBand from "../../components/CtaBand.astro";
import brokerMathShiftGraphic from "../../assets/brokers.png";
import {Image} from "astro:assets";
import VideoHero from "../../components/VideoHero.astro";

const steps = [
  {
    title: "Join the Zorakle Platform.",
    body:
      "Sign up now to access the SpotOn! platform, margin benefits, and candidate-brand tools your team can use immediately."
  },
  {
    title: "Your client takes the assessment.",
    body:
      "One simple profile captures fit, temperament, and business-owner indicators so every recommendation starts with objective insight."
  },
  {
    title: "See ranked brand matches. Instantly.",
    body:
      "Within minutes, discover best-fit brands based on validated fit indicators, values alignment, and development readiness."
  },
  {
    title: "Close with conviction.",
    body:
      "Walk clients through evidence-backed recommendations and move from uncertainty to confidence faster in every deal cycle."
  }
];

const tools = [
  {
    title: "SpotOn! Profile",
    subtitle: "Your foundation for fit.",
    body:
      "Build a complete candidate picture across ownership traits, motivation patterns, and behavioral indicators that matter for franchise success.",
    image: spotOnProfileReport,
    imageAlt: "SpotOn! Profile"
  },
  {
    title: "SpotOn! Match",
    subtitle: "How brokers win with speed.",
    body:
      "Match candidates against real franchise requirements in minutes and present ranked recommendations backed by data clients can trust. When matches are strong, send pre-qualified SpotOn! referrals directly to franchisors.",
    image: spotonMatch,
    imageAlt: "SpotOn! Referral screenshot"
  }
];

const metrics = [
  {
    title: "Faster, more confident closes.",
    body:
      "Reduce indecision and deal drift by giving clients clear, explainable recommendations tied to their profile results."
  },
  {
    title: "Stronger client retention and referrals.",
    body:
      "When clients feel guided by evidence, trust increases and your process becomes a differentiator they talk about."
  },
  {
    title: "Differentiation from the competition.",
    body:
      "Lead with a scientific approach that turns your advisory process into a premium experience in crowded markets."
  },
  {
    title: "Pre-qualified leads from franchisors.",
    body:
      "Better candidate-brand fit creates cleaner handoffs and stronger collaboration with development teams."
  }
];
---

<MainLayout
  title="Franchise Matching Software for Brokers & Consultants | Zorakle"
  description="Match every client to the right franchise brand with data-backed fit scoring, ranked brand matches, and broker-ready talking points you can explain with confidence."
>
  <SiteHeader />

  <main>
    <VideoHero
        titlePrefix="Match clients to the right brand."
        titleHighlight="Close more deals doing it."
        titleSuffix=""
        description="Clients trust brokers who can explain fit clearly, not just speak in broad probabilities. SpotOn! gives you science-backed candidate-to-brand recommendations so every intro feels grounded and credible."
        primaryCta={{ href: "/schedule", label: "Book a Demo" }}
        secondaryCta={{ href: "/pricing/brokers", label: "Sign Up Now!" }}
        poster={heroBackground}
        posterAlt="Franchise owners and operators representing a growing franchise system"
        videoId="1137519120"
        playLabel="Play the 5-minute franchisor overview"
        modalTitle="Zorakle 5-minute franchisor overview"
        caption="See how Zorakle helps brokers."
    />
    <section class="border-b border-[#d1d4dd] bg-white py-16 md:py-20">
      <div class="section-shell grid items-center gap-10 md:grid-cols-[440px_minmax(0,1fr)] md:gap-14">
        <div class="rounded-2xl bg-transparent p-0">
          <Image
              src={brokerMathShiftGraphic}
              alt="Model-fit comparison showing cost risk versus confidence outcomes"
              class="h-auto w-full rounded-2xl"
              loading="lazy"
          />
        </div>

        <div>
          <h2 class="section-title max-w-3xl text-[#1f232a]">
            The broker math has changed.
          </h2>
          <p class="mt-6 max-w-4xl text-base leading-relaxed text-[#3b3e47] md:text-lg">
            Instead of relying on opinion or guesswork, modern brokers can match clients with data-backed confidence. The result is stronger conversations, faster decisions, and better-fit brand outcomes that compound over time.
          </p>
        </div>
      </div>
    </section>

    <WorkflowStepsSection
      variant="broker"
      eyebrow="How Zorakle Works"
      title="From client conversation to confident match in four steps."
      description="Simple for clients and powerful for advisors. The workflow is built to help brokers move quickly without sacrificing quality."
      steps={steps}
      ctaHref="/pricing/brokers"
      ctaLabel="Sign Up Now!"
    />

    <ToolsShowcaseSection
      eyebrow="The Broker Toolkit"
      title="The tools that turn candidates into perfect matches."
      description="Two connected tools help you understand each client and then map them to the brands where they are most likely to win."
      cards={tools}
      ctaHref="/request-reports"
      ctaLabel="Get Sample Reports!"
    />

    <MetricsTimelineSection
      eyebrow="What Happens When You Match With Science"
      titlePrefix="Better matches. Faster closes. Stronger client relationships."
      items={metrics}
    />

    <section class=" py-16 md:py-20">
      <div class="section-shell">
        <p class="section-eyebrow">What Brokers Say</p>
        <h2 class="section-title mt-4 max-w-4xl text-[#1f232a]">
          Brokers who match with science. And the deals they are closing because of it.
        </h2>

        <TestimonialCarousel type="brokers" />
      </div>
    </section>


    <CtaBand
    title="Ready to match smarter?"
    primaryHref="/pricing/franchisors"
text=""></CtaBand>
  </main>

  <SiteFooter />
</MainLayout>
