---
import MainLayout from "../../layouts/MainLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BrokerHero from "../../components/BrokerHero.astro";
import BrokerBenefitsSection from "../../components/BrokerBenefitsSection.astro";
import BrokerAlignmentActionSection from "../../components/BrokerAlignmentActionSection.astro";
import BrokerPracticalIntelligenceSection from "../../components/BrokerPracticalIntelligenceSection.astro";
import BrokerClosingCta from "../../components/BrokerClosingCta.astro";
import heroOgImage from "../../assets/broker-hero.png";

const siteHref = Astro.site?.href ?? "https://www.zorakleprofiles.com/";
const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteHref },
    { "@type": "ListItem", position: 2, name: "Solutions for Brokers", item: new URL("/solutions/brokers/", siteHref).href }
  ]
});
---

<MainLayout
  title="Franchise Matching Software for Brokers & Consultants | Zorakle"
  description="Match every client to the right franchise brand with data-backed fit scoring, ranked matches, and talking points that build client trust."
  ogImage={heroOgImage.src}
  ogImageAlt="A franchise broker consulting with a prospective candidate"
>
  <script type="application/ld+json" slot="head" set:html={breadcrumbJsonLd} />
  <SiteHeader />

  <main>
    <BrokerHero />
    <BrokerBenefitsSection />
    <!--<BrokerAlignmentActionSection />-->
    <BrokerPracticalIntelligenceSection />
    <BrokerClosingCta />
  </main>

  <SiteFooter />
</MainLayout>
