---
import MainLayout from "../../layouts/MainLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import TestimonialCarousel from "../../components/TestimonialCarousel.astro";
import WorkflowStepsSection from "../../components/WorkflowStepsSection.astro";
import LogoCloud from "../../components/LogoCloud.astro";
import BrokerHero from "../../components/BrokerHero.astro";
import BrokerOutcomesSection from "../../components/BrokerOutcomesSection.astro";
import spotOnProfileReport from "../../assets/spoton.png";
import spotonMatch from "../../assets/spoton_match.png";
import brokerMathShiftGraphic from "../../assets/brokers.png";
import {Image} from "astro:assets";

const brokerExplainerVideoId = "1137519120";

const steps = [
  {
    title: "Your client takes the assessment.",
    body:
      "One simple SpotOn! Profile captures fit, temperament, and business-owner potential, so every recommendation starts from objective insight."
  },
  {
    title: "See ranked brand matches.",
    body:
      "Within minutes, SpotOn! Match surfaces best-fit brands based on validated fit indicators, values alignment, and development readiness."
  },
  {
    title: "Close with conviction.",
    body:
      "Walk clients through evidence-backed recommendations and move from uncertainty to a confident decision faster in every deal cycle."
  }
];

---

<MainLayout
  title="Franchise Matching Software for Brokers & Consultants | Zorakle"
  description="Match every client to the right franchise brand with data-backed fit scoring, ranked brand matches, and broker-ready talking points you can explain with confidence."
>
  <SiteHeader />

  <main>
    <BrokerHero />

    <LogoCloud
      sectionClass="border-b border-[#e1e8e6] bg-white py-8 md:py-10"
    />

    <section class="border-b border-[#d1d4dd] bg-white py-16 md:py-20">
      <div class="section-shell grid items-center gap-10 md:grid-cols-[440px_minmax(0,1fr)] md:gap-14">
        <div class="rounded-2xl bg-transparent p-0">
          <Image
              src={brokerMathShiftGraphic}
              alt="Model-fit comparison showing cost risk versus confidence outcomes"
              class="h-auto w-full rounded-2xl"
              loading="lazy"
          />
        </div>

        <div>
          <h2 class="section-title max-w-3xl text-[#1f232a]">
            The broker math has changed.
          </h2>
          <p class="mt-6 max-w-4xl text-base leading-relaxed text-[#3b3e47] md:text-lg">
            Instead of relying on opinion or guesswork, modern brokers can match clients with data-backed confidence. The result is stronger conversations, faster decisions, and better-fit brand outcomes that compound over time.
          </p>
        </div>
      </div>
    </section>

    <WorkflowStepsSection
      variant="broker"
      eyebrow="How Zorakle Works"
      title="From client conversation to confident match in three steps."
      description="Simple for clients and powerful for advisors. The workflow is built to help brokers move quickly without sacrificing quality."
      steps={steps}
      videoId={brokerExplainerVideoId}
      videoLabel="Watch the 5-Minute Overview"
      videoModalTitle="Zorakle 5-minute broker overview"
      sectionClass="border-b border-[#dce7e4] bg-[#eef7f4] py-16 md:py-24"
    />

    <BrokerOutcomesSection />

    <aside class="border-y border-[#4b5260] bg-[#30343b] py-10 text-white" aria-label="Explore the sciences behind Zorakle">
      <div class="section-shell flex flex-col items-center gap-6 text-center md:flex-row md:justify-between md:gap-10 md:text-left">
        <p class="max-w-3xl font-display text-2xl leading-snug text-white md:text-[1.75rem]">
          Seven validated sciences, one profile: how a person works and how well they fit a franchise system. Not a personality test.
        </p>
        <a class="btn-primary shrink-0" href="/sciences">
          Explore The Sciences <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </aside>

    <section class="border-t border-[#dce7e4] bg-white py-16 md:py-20">
      <div class="section-shell">
        <p class="section-eyebrow">What Brokers Say</p>
        <h2 class="section-title mt-4 max-w-4xl text-[#1f232a]">
          Brokers who match with science. And the deals they are closing because of it.
        </h2>

        <TestimonialCarousel type="brokers" />
      </div>
    </section>

    <section class="overflow-hidden border-t border-[#dce7e4] bg-[#eef7f4] py-14 md:py-18">
      <div class="section-shell grid items-center gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
        <div class="max-w-2xl">
          <p class="section-eyebrow">From insight to impact</p>
          <h2 class="font-display text-4xl leading-[1.05] tracking-[-0.02em] text-[#1e2f43] sm:text-5xl lg:text-[3.6rem]">
            Match your next client
            <span class="text-[#09a985]"> with greater confidence.</span>
          </h2>
          <p class="section-copy mt-6 max-w-xl text-[#475569]">
            See how SpotOn! turns every client conversation into ranked, evidence-backed brand recommendations you can explain and defend.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a class="btn-primary" href="/schedule">Book a Demo</a>
            <a class="inline-flex items-center gap-2 text-base font-semibold text-[#1e2f43] transition-colors hover:text-[#23bfa8]" href="/pricing/brokers">
              View Broker Pricing <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <div class="mx-auto w-full max-w-[620px] lg:max-w-none" aria-label="Sample Zorakle broker reports">
          {/* Small screens: clean side-by-side, no overlap or rotation */}
          <div class="grid grid-cols-2 items-start gap-4 sm:hidden">
            <div class="rounded-2xl border border-[#e6eeec] bg-white p-2.5 shadow-[0_16px_32px_rgba(23,35,62,0.14)]">
              <Image src={spotOnProfileReport} alt="SpotOn! Profile sample report" class="h-auto w-full rounded-xl" />
            </div>
            <div class="mt-8 rounded-2xl border border-[#e6eeec] bg-white p-2.5 shadow-[0_16px_32px_rgba(23,35,62,0.14)]">
              <Image src={spotonMatch} alt="SpotOn! Match ranked brand results" class="h-auto w-full rounded-xl" />
            </div>
          </div>

          {/* sm and up: fanned, overlapping cluster with decorative rings */}
          <div class="relative mx-auto hidden h-[500px] w-full sm:block lg:h-[600px]">
            <div class="pointer-events-none absolute left-[52%] top-1/2 h-[380px] w-[380px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#c9f0e8]/65 lg:h-[470px] lg:w-[470px]"></div>
            <div class="pointer-events-none absolute left-[52%] top-1/2 h-[440px] w-[440px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#cfe8e3] lg:h-[550px] lg:w-[550px]"></div>

            <div class="absolute left-[1%] top-[5%] w-[58%] rotate-[-5deg] rounded-2xl border border-[#e6eeec] bg-white p-3 shadow-[0_22px_45px_rgba(23,35,62,0.16)]">
              <Image src={spotOnProfileReport} alt="SpotOn! Profile sample report" class="h-auto w-full rounded-xl" />
            </div>
            <div class="absolute bottom-[1%] right-0 w-[63%] rotate-[5deg] rounded-2xl border border-[#e6eeec] bg-white p-3 shadow-[0_24px_45px_rgba(23,35,62,0.2)]">
              <Image src={spotonMatch} alt="SpotOn! Match ranked brand results" class="h-auto w-full rounded-xl" />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>
