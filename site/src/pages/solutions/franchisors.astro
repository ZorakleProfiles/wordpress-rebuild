---
import MainLayout from "../../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FranchisorHero from "../../components/FranchisorHero.astro";
import LogoCloud from "../../components/LogoCloud.astro";
import TestimonialCarousel from "../../components/TestimonialCarousel.astro";
import WorkflowStepsSection from "../../components/WorkflowStepsSection.astro";
import FranchisorOutcomesSection from "../../components/FranchisorOutcomesSection.astro";
import franchisorModelFitComparison from "../../assets/franchisors.png";
import blueprintReport from "../../assets/blueprint.png";
import eclipseReport from "../../assets/eclipse.png";

const franchisorExplainerVideo =
  "https://cdn.sanity.io/files/4kjxjblw/production/676d9e59bc7e318e2e1756be2b170d63faf3d3ca.mp4";

const steps = [
  {
    title: "Build your benchmark.",
    body:
      "Audit your brand and assess top-performing franchisees to identify the values, behaviors, and operating traits connected to success in your system."
  },
  {
    title: "Create your fit standard.",
    body:
      "Turn your benchmark data into a custom fit algorithm and SpotOn! Blueprint your development team can apply consistently."
  },
  {
    title: "Evaluate every candidate.",
    body:
      "Use SpotOn! Profiles and Eclipse reports to see system alignment, compare candidates, and surface potential risk before you award."
  }
];

---

<MainLayout
  title="Franchisee Selection & Assessment Tools for Franchisors | Zorakle"
  description="Predict franchisee fit before you award. Zorakle gives franchisor development teams a validated, repeatable selection framework for stronger owners, better validation, and Item 19 performance."
>
  <SiteHeader ctaLabel="Book a Consultation" />

  <main>
    <FranchisorHero />

    <LogoCloud
      sectionClass="border-b border-[#e1e8e6] bg-white py-8 md:py-10"
    />

    <section class="border-b border-[#d1d4dd] bg-[#f3f3f3] py-16 md:py-24">
      <div class="section-shell">
        <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
          <div class="rounded-3xl bg-white p-4 shadow-[0_18px_45px_rgba(23,35,62,0.08)]">
            <Image
              src={franchisorModelFitComparison}
              alt="Model-fit comparison showing cost risk versus confidence outcomes"
              class="h-auto w-full rounded-2xl"
              loading="lazy"
            />
          </div>

          <div class="">
            <p class="section-eyebrow">When Alignment Is Off</p>
            <h2 class="section-title max-w-3xl text-[#1f232a] lg:ml-auto">
              The wrong franchisee costs more than the right one earns.
            </h2>
            <p class="mt-6 max-w-4xl text-base leading-relaxed text-[#3b3e47] md:text-lg lg:ml-auto">
              Bad-fit awards drag support resources, lower validation confidence, and create avoidable transfer risk. Zorakle helps you screen for business-owner potential, values alignment, and execution traits before you commit.
            </p>
            <ul class="mt-8 space-y-3 text-[#1f232a] md:text-base lg:ml-auto lg:max-w-4xl">
              <li class="flex gap-3 lg:justify-start">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#09cc9c]"></span>
                <span>Know which candidates fit your model, not just your culture.</span>
              </li>
              <li class="flex gap-3 lg:justify-start">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#09cc9c]"></span>
                <span>Move faster and decide with confidence during validation.</span>
              </li>
              <li class="flex gap-3 lg:justify-start">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#09cc9c]"></span>
                <span>Protect your Item 19 outcomes from avoidable operator mismatch.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <aside class="border-y border-[#4b5260] bg-[#30343b] py-9 text-white" aria-label="System-specific franchisee fit">
      <p class="section-shell max-w-5xl text-center font-display text-2xl leading-snug text-white md:text-3xl">
        The question is not whether a candidate can own a business. It is whether they can succeed inside your business.
      </p>
    </aside>

    <WorkflowStepsSection
      variant="franchisor"
      eyebrow="How Zorakle Works"
      title="From brand insight to confident award in three phases."
      description="Build one standard across development, leadership, and validation—then apply it consistently to every candidate."
      steps={steps}
      videoSrc={franchisorExplainerVideo}
      videoLabel="Watch the 5-Minute Overview"
      videoModalTitle="Zorakle 5-minute franchisor overview"
      sectionClass="border-b border-[#dce7e4] bg-[#eef7f4] py-16 md:py-24"
    />

    <FranchisorOutcomesSection />

    <aside class="border-y border-[#4b5260] bg-[#30343b] py-10 text-white" aria-label="Explore the sciences behind Zorakle">
      <div class="section-shell flex flex-col items-center gap-6 text-center md:flex-row md:justify-between md:gap-10 md:text-left">
        <p class="max-w-3xl font-display text-2xl leading-snug text-white md:text-[1.75rem]">
          Seven validated sciences, one profile: how a person works and how well they fit a franchise system. Not a personality test.
        </p>
        <a class="btn-primary shrink-0" href="/sciences">
          Explore The Sciences <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </aside>

    <section class="border-t border-[#dce7e4] bg-white py-16 md:py-20">
      <div class="section-shell">
        <p class="section-eyebrow">What Franchisors Say</p>
        <h2 class="section-title mt-4 max-w-4xl text-[#1f232a]">
          Franchise leaders who already trust the science.
        </h2>

        <TestimonialCarousel type={null} limit={3} />
      </div>
    </section>

    <section class="overflow-hidden border-t border-[#dce7e4] bg-[#eef7f4] py-14 md:py-18">
      <div class="section-shell grid items-center gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
        <div class="max-w-2xl">
          <p class="section-eyebrow">From insight to impact</p>
          <h2 class="font-display text-4xl leading-[1.05] tracking-[-0.02em] text-[#1e2f43] sm:text-5xl lg:text-[3.6rem]">
            Make your next franchisee decision
            <span class="text-[#09a985]"> with greater confidence.</span>
          </h2>
          <p class="section-copy mt-6 max-w-xl text-[#475569]">
            See how Zorakle can help you build a fit standard for your system - and apply it consistently to every candidate before you award.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a class="btn-primary" href="/schedule">Book a Consultation</a>
            <a class="inline-flex items-center gap-2 text-base font-semibold text-[#1e2f43] transition-colors hover:text-[#23bfa8]" href="/pricing/franchisors">
              View Franchisor Pricing <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <div class="mx-auto w-full max-w-[620px] lg:max-w-none" aria-label="Sample Zorakle franchisee reports">
          {/* Small screens: clean side-by-side, no overlap or rotation */}
          <div class="grid grid-cols-2 items-start gap-4 sm:hidden">
            <div class="rounded-2xl border border-[#e6eeec] bg-white p-2.5 shadow-[0_16px_32px_rgba(23,35,62,0.14)]">
              <Image src={blueprintReport} alt="SpotOn Blueprint sample report" class="h-auto w-full rounded-xl" />
            </div>
            <div class="mt-8 rounded-2xl border border-[#e6eeec] bg-white p-2.5 shadow-[0_16px_32px_rgba(23,35,62,0.14)]">
              <Image src={eclipseReport} alt="Eclipse candidate fit sample report" class="h-auto w-full rounded-xl" />
            </div>
          </div>

          {/* sm and up: fanned, overlapping cluster with decorative rings */}
          <div class="relative mx-auto hidden h-[500px] w-full sm:block lg:h-[600px]">
            <div class="pointer-events-none absolute left-[52%] top-1/2 h-[380px] w-[380px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#c9f0e8]/65 lg:h-[470px] lg:w-[470px]"></div>
            <div class="pointer-events-none absolute left-[52%] top-1/2 h-[440px] w-[440px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#cfe8e3] lg:h-[550px] lg:w-[550px]"></div>

            <div class="absolute left-[1%] top-[5%] w-[58%] rotate-[-5deg] rounded-2xl border border-[#e6eeec] bg-white p-3 shadow-[0_22px_45px_rgba(23,35,62,0.16)]">
              <Image src={blueprintReport} alt="SpotOn Blueprint sample report" class="h-auto w-full rounded-xl" />
            </div>
            <div class="absolute bottom-[1%] right-0 w-[63%] rotate-[5deg] rounded-2xl border border-[#e6eeec] bg-white p-3 shadow-[0_24px_45px_rgba(23,35,62,0.2)]">
              <Image src={eclipseReport} alt="Eclipse candidate fit sample report" class="h-auto w-full rounded-xl" />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>
