---
import MainLayout from "../../layouts/MainLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FranchisorHero from "../../components/FranchisorHero.astro";
import FranchisorBenefitsSection from "../../components/FranchisorBenefitsSection.astro";
import AlignmentLifecycle from "../../components/AlignmentLifecycle.astro";
import FranchisorPracticalIntelligenceSection from "../../components/FranchisorPracticalIntelligenceSection.astro";
import FranchisorClosingCta from "../../components/FranchisorClosingCta.astro";
import FranchisorAlignmentActionSection from "../../components/FranchisorAlignmentActionSection.astro";
import heroOgImage from "../../assets/franchisor-hero-alignment-v2.png";

const siteHref = Astro.site?.href ?? "https://www.zorakleprofiles.com/";
const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteHref },
    { "@type": "ListItem", position: 2, name: "Solutions for Franchisors", item: new URL("/solutions/franchisors/", siteHref).href }
  ]
});
---

<MainLayout
  title="Franchisee Selection & Assessment Tools for Franchisors | Zorakle"
  description="Build a stronger franchise system with objective insight into candidate alignment, validation, support needs, and execution fit."
  ogImage={heroOgImage.src}
  ogImageAlt="A franchisor discussing candidate alignment in a meeting"
>
  <script type="application/ld+json" slot="head" set:html={breadcrumbJsonLd} />
  <SiteHeader ctaLabel="Book a Consultation" />

  <main>
    <FranchisorHero />
    <FranchisorBenefitsSection />
    <AlignmentLifecycle variant="franchisors" />
    <!--<FranchisorAlignmentActionSection/>-->

    <FranchisorPracticalIntelligenceSection />
    <FranchisorClosingCta />
  </main>
  <SiteFooter />
</MainLayout>
