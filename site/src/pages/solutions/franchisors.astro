---
import MainLayout from "../../layouts/MainLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FranchisorHero from "../../components/FranchisorHero.astro";
import FranchisorBenefitsSection from "../../components/FranchisorBenefitsSection.astro";
import FranchisorAlignmentActionSection from "../../components/FranchisorAlignmentActionSection.astro";
import FranchisorPracticalIntelligenceSection from "../../components/FranchisorPracticalIntelligenceSection.astro";
import FranchisorClosingCta from "../../components/FranchisorClosingCta.astro";
---

<MainLayout
  title="Franchisee Selection & Assessment Tools for Franchisors | Zorakle"
  description="Build a stronger franchise system with objective insight into candidate alignment, validation, support needs, and execution fit."
>
  <SiteHeader ctaLabel="Book a Consultation" wide={true} />

  <main>
    <FranchisorHero />
    <FranchisorBenefitsSection />
    <FranchisorAlignmentActionSection />
    <FranchisorPracticalIntelligenceSection />
    <FranchisorClosingCta />
  </main>

  <SiteFooter />
</MainLayout>
