---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Help from "../components/Help.astro";
import { supportArticles } from "../data/support";

const supportArticleTypes = [...new Set(supportArticles.map((article) => article.type))];
---

<MainLayout
  title="Zorakle Technical Support | Platform Help & Guides"
  description="Step-by-step help for setting up and using the Zorakle platform: account setup, assessments, reports, and common technical workflows."
>
  <SiteHeader />

  <main>
    <section class="border-b border-[#d1d4dd] bg-[#f4f5f7] py-10 md:py-12">
      <div class="section-shell grid items-start gap-8 lg:grid-cols-[minmax(0,1.25fr)_minmax(320px,0.75fr)] lg:gap-12">
        <div class="flex flex-col h-full items-start">
          <p class="section-eyebrow">Resources</p>
          <h1 class="page-title mt-4">
            Technical support
          </h1>
          <p class="mt-4 max-w-2xl text-lg text-[#3b3e47]">
            Get help setting up and using the Zorakle platform. Looking for the science behind the
            SpotOn! framework? Visit
            <a href="/science" class="font-semibold text-[#a8420c] underline underline-offset-2">
              The Science
            </a>.
          </p>
        </div>

        <Help embedded />
      </div>
    </section>

    <section class="bg-white pt-6 pb-12">
      <div class="section-shell">
        <h2 class="section-title mt-4 max-w-4xl">
          Platform guides
        </h2>
        <p class="mt-4 max-w-2xl text-lg text-[#3b3e47]">
          Find step-by-step guides for account setup, platform features, reports, and common
          technical workflows. Select any article to open the full walkthrough.
        </p>

        {supportArticles.length > 0 ? (
          <>
            <div class="mt-10 mb-8 grid gap-4 md:grid-cols-[2fr_1fr]" data-support-filters>
              <label class="block">
                <span class="mb-2 block text-base font-semibold text-[#22252a]">Search articles</span>
                <input
                  type="search"
                  placeholder="Search by topic, feature, or workflow"
                  class="w-full rounded-xl border border-[#d1d4dd] bg-white px-4 py-3 text-base text-[#22252a] outline-none transition focus:border-[#09cc9c]"
                  data-support-search
                />
              </label>
              <label class="block">
                <span class="mb-2 block text-base font-semibold text-[#22252a]">Audience</span>
                <select
                  class="w-full rounded-xl border border-[#d1d4dd] bg-white px-4 py-3 text-base text-[#22252a] outline-none transition focus:border-[#09cc9c]"
                  data-support-type
                >
                  <option value="all">All audiences</option>
                  {supportArticleTypes.map((type) => <option value={type}>{type}</option>)}
                </select>
              </label>
            </div>

            <div class="grid gap-6 md:grid-cols-2" data-support-results>
              {supportArticles.map((article) => (
                <a
                  href={`/support/${article.slug}`}
                  class="group rounded-2xl border border-[#d1d4dd] bg-white p-6 transition hover:border-[#09cc9c] hover:shadow-lg"
                  data-support-card
                  data-support-type={article.type}
                  data-support-searchable={`${article.title} ${article.summary} ${article.type}`}
                >
                  <p class="text-sm font-semibold text-[#087f65]">{article.type}</p>
                  <h3 class="mt-2 font-display text-2xl font-bold text-[#22252a] group-hover:text-[#a8420c]">
                    {article.title}
                  </h3>
                  <p class="mt-3 text-base leading-relaxed text-[#3b3e47]">{article.summary}</p>
                  <p class="mt-4 text-sm text-[#56586a]">{article.steps.length} steps</p>
                  <p class="mt-4 text-sm font-semibold text-[#a8420c]">Read full article →</p>
                </a>
              ))}
            </div>

            <p
              class="mt-6 hidden rounded-xl border border-dashed border-[#b7bcc9] bg-[#f4f6f9] px-4 py-3 text-sm text-[#3b3e47]"
              data-support-empty
            >
              No articles match your current search. Try a different keyword or choose another audience.
            </p>
          </>
        ) : (
          <p class="mt-8 text-base text-[#3b3e47]">No support articles are available yet.</p>
        )}
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>

<script>
  const supportSearch = document.querySelector<HTMLInputElement>("[data-support-search]");
  const supportType = document.querySelector<HTMLSelectElement>("[data-support-type]");
  const supportCards = Array.from(document.querySelectorAll<HTMLElement>("[data-support-card]"));
  const supportEmpty = document.querySelector<HTMLElement>("[data-support-empty]");

  const applySupportFilters = () => {
    if (!supportCards.length) return;

    const searchValue = (supportSearch?.value ?? "").trim().toLowerCase();
    const selectedType = supportType?.value ?? "all";
    let visibleCount = 0;

    supportCards.forEach((card) => {
      const articleType = card.dataset.supportType ?? "";
      const searchableText = (card.dataset.supportSearchable ?? "").toLowerCase();
      const matchesSearch = !searchValue || searchableText.includes(searchValue);
      const matchesType = selectedType === "all" || articleType === selectedType;
      const isVisible = matchesSearch && matchesType;

      card.classList.toggle("hidden", !isVisible);
      if (isVisible) visibleCount += 1;
    });

    supportEmpty?.classList.toggle("hidden", visibleCount > 0);
  };

  supportSearch?.addEventListener("input", applySupportFilters);
  supportType?.addEventListener("change", applySupportFilters);
</script>
