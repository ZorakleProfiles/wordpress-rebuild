---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Help from "../components/Help.astro";

import { supportArticles } from "../data/support.ts";

const sciences = [
  {
    number: "01",
    title: "Leadership & Decision-Making",
    description: "Based on decades of leadership research from Gallup and Harvard Business School. Measures how candidates approach challenges, make decisions under pressure, and lead teams.",
    keyPoints: ["Strategic thinking", "Decision-making frameworks", "Team leadership"]
  },
  {
    number: "02",
    title: "Emotional Intelligence",
    description: "Grounded in contemporary psychology research. Assesses self-awareness, empathy, relationship management, and emotional resilience—critical for franchisee success.",
    keyPoints: ["Self-awareness", "Empathy", "Relationship skills", "Emotional resilience"]
  },
  {
    number: "03",
    title: "Work Ethic & Drive",
    description: "Validated through organizational behavior studies. Identifies candidates with the grit, determination, and work ethic required to build and sustain a successful franchise.",
    keyPoints: ["Motivation", "Perseverance", "Goal orientation", "Accountability"]
  },
  {
    number: "04",
    title: "Financial & Business Acumen",
    description: "Stanford-backed research on entrepreneurial capability. Evaluates business judgment, financial literacy, and ability to manage P&L.",
    keyPoints: ["Financial literacy", "Business strategy", "Operational thinking", "Risk management"]
  },
  {
    number: "05",
    title: "Resilience & Adaptability",
    description: "Psychology-grounded framework measuring ability to handle setbacks, adapt to change, and maintain performance under stress.",
    keyPoints: ["Stress management", "Adaptability", "Learning agility", "Bounce-back potential"]
  },
  {
    number: "06",
    title: "People & Team Building",
    description: "Based on organizational behavior and team dynamics research. Assesses ability to recruit, develop, and maintain high-performing teams.",
    keyPoints: ["Team development", "Hiring judgment", "Delegation", "Culture building"]
  },
  {
    number: "07",
    title: "Entrepreneurial Mindset",
    description: "Integrated research from Stanford and Gallup on what drives successful business ownership. Captures initiative, innovation, and ownership psychology.",
    keyPoints: ["Initiative", "Innovation", "Ownership mentality", "Market orientation"]
  }
];

---
<MainLayout
  title="Training & Support | Zorakle"
  description="Training resources, science explanations, and support for Zorakle users. Learn the platform and understand the 7 peer-reviewed sciences behind your assessments."
>
  <SiteHeader />

  <main>

    <!-- Training Tabs Section -->
    <section class="border-b border-[#d1d4dd] bg-white py-16 md:py-20">
      <div class="section-shell">
        <!-- Tab Navigation -->
        <div class="flex border-b border-[#d1d4dd] mb-12" data-training-tabs>
          <button
            class="tab-btn px-6 py-4 font-bold text-base text-[#3b3e47] border-b-2 border-transparent transition hover:text-[#fd7730] data-active:border-[#fd7730] data-active:text-[#fd7730]"
            data-tab="platform"
          >
            Support Articles
          </button>
          <button
            class="tab-btn px-6 py-4 font-bold text-base text-[#3b3e47] border-b-2 border-transparent transition hover:text-[#fd7730] data-active:border-[#fd7730] data-active:text-[#fd7730]"
            data-tab="sciences"
          >
            Zorakle Sciences
          </button>
        </div>

        <!-- Support Articles Tab Content -->
        <div class="tab-content" data-tab-content="platform">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-[#22252a] mb-2">Support Articles</h2>
          <p class="text-lg text-[#3b3e47] mb-12 max-w-2xl">
            Follow practical setup guides with screenshots and lightweight visuals. Click an article to open the full walkthrough.
          </p>

          {supportArticles.length > 0 ? (
            <div class="grid gap-6 md:grid-cols-2">
              {supportArticles.map((article) => (
                <a
                  href={`/support/${article.slug}`}
                  class="group rounded-2xl border border-[#d1d4dd] bg-white p-6 transition hover:border-[#09cc9c] hover:shadow-lg"
                >
                  <p class="text-sm font-semibold text-[#09cc9c]">Support Guide</p>
                  <h3 class="mt-2 font-display text-2xl font-bold text-[#22252a] group-hover:text-[#fd7730]">{article.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-[#3b3e47]">{article.summary}</p>
                  <p class="mt-4 text-sm text-[#56586a]">{article.steps.length} steps</p>
                  {article.summaryVideo ? (
                    <p class="mt-1 text-sm text-[#56586a]">Includes a 1-minute summary video</p>
                  ) : null}
                  <p class="mt-4 text-sm font-semibold text-[#fd7730]">Read full article -></p>
                </a>
              ))}
            </div>
          ) : (
            <p class="text-base text-[#3b3e47]">No support articles are available yet.</p>
          )}
        </div>

        <!-- Sciences Tab Content -->
        <div class="tab-content hidden" data-tab-content="sciences">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-[#22252a] mb-2">The 7 Peer-Reviewed Sciences</h2>
          <p class="text-lg text-[#3b3e47] mb-12 max-w-3xl">
            Zorakle integrates seven validated sciences from top research institutions—Stanford, Harvard Business School, Gallup, and the University of Michigan. Each science measures something different. Together, they predict franchise performance like nothing else.
          </p>

          <!-- Sciences Accordion/Cards -->
          <div class="space-y-4">
            {sciences.map((science, index) => (
              <div class="science-card rounded-2xl border border-[#d1d4dd] bg-white transition hover:shadow-lg hover:border-[#09cc9c]" data-science-card>
                <button
                  class="science-header w-full px-6 py-6 flex items-start justify-between gap-4 cursor-pointer group text-left"
                  data-science-toggle={index}
                >
                  <span class="text-4xl font-bold text-[#09cc9c] shrink-0 block">{science.number}</span>
                  <span class="flex-1">
                    <span class="font-display text-xl font-bold text-[#22252a] group-hover:text-[#fd7730] block">{science.title}</span>
                    <span class="mt-2 text-[#3b3e47] leading-relaxed block">{science.description}</span>
                  </span>
                  <span class="text-[#09cc9c] text-2xl shrink-0 transition group-hover:rotate-180 mt-2 block" aria-hidden="true">▾</span>
                </button>
                <div class="science-content hidden px-6 pb-6" data-science-content={index}>
                  <div class="pl-24 space-y-3">
                    <p class="font-semibold text-[#22252a] text-sm uppercase tracking-wider">Key Competencies</p>
                    <ul class="space-y-2">
                      {science.keyPoints.map((point) => (
                        <li class="flex items-center gap-3 text-[#3b3e47]">
                          <span class="h-1.5 w-1.5 rounded-full bg-[#fd7730]"></span>
                          {point}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-12 rounded-2xl bg-linear-to-r from-[#09cc9c]/10 to-[#fd7730]/10 border border-[#09cc9c]/20 p-8">
            <p class="font-display text-2xl font-bold text-[#22252a] mb-3">Why This Matters</p>
            <p class="text-lg text-[#3b3e47] leading-relaxed">
              Off-the-shelf personality tests weren't built for franchisees. They measure traits for employees, not business owners. Zorakle's integrated science framework was purpose-built to predict what actually matters: franchise success. When you understand the science, you understand why fit matters.
            </p>
          </div>
        </div>
      </div>
    </section>
  <Help></Help>

  </main>

  <SiteFooter />
</MainLayout>

<script>
  // Tab Navigation
  const tabContainer = document.querySelector('[data-training-tabs]') as any;
  if (tabContainer) {
    const tabs = tabContainer.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');

    tabs.forEach((tab: any) => {
      tab.addEventListener('click', () => {
        const targetTab = tab.dataset.tab;

        // Remove active state from all tabs and hide all contents
        tabs.forEach((t: any) => t.removeAttribute('data-active'));
        contents.forEach((c: any) => c.classList.add('hidden'));

        // Set active tab and show corresponding content
        tab.setAttribute('data-active', '');
        const content = document.querySelector(`[data-tab-content="${targetTab}"]`);
        if (content) content.classList.remove('hidden');
      });
    });

    // Set first tab as active by default
    if (tabs.length > 0) {
      tabs[0].setAttribute('data-active', '');
    }
  }

  // Science Accordion
  const scienceCards = document.querySelectorAll('[data-science-card]');
  scienceCards.forEach((card: any) => {
    const toggleBtn = card.querySelector('[data-science-toggle]');
    const contentDiv = card.querySelector('[data-science-content]');

    if (toggleBtn && contentDiv) {
      toggleBtn.addEventListener('click', () => {
        contentDiv.classList.toggle('hidden');
      });
    }
  });

 </script>

