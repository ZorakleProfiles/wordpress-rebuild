<style>
  .policy-prose {
    color: #3b3e47;
    font-size: 1rem;
    line-height: 1.75;
  }

  .policy-prose h2 {
    margin-top: 3rem;
    padding-top: 0.5rem;
    scroll-margin-top: 6rem;
    font-family: "MontereyFLF", "Century Gothic", "Avenir Next", sans-serif;
    font-size: clamp(1.4rem, 1.4vw + 1rem, 1.75rem);
    font-weight: 700;
    color: #22252a;
    border-top: 1px solid #e5e5e5;
  }

  .policy-prose h2:first-of-type {
    border-top: none;
    margin-top: 2rem;
  }

  .policy-prose p {
    margin-top: 1rem;
  }

  .policy-prose ul {
    margin-top: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .policy-prose li {
    margin-top: 0.6rem;
  }

  .policy-prose a {
    color: #087f65;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .policy-callout {
    margin-top: 1.5rem;
    border-radius: 0.75rem;
    background: #f8f8f8;
    border-left: 4px solid #09cc9c;
    padding: 1rem 1.25rem;
    font-size: 0.95rem;
    color: #22252a;
  }

  .policy-address {
    margin-top: 1rem;
    font-style: normal;
    line-height: 1.7;
  }
</style>
