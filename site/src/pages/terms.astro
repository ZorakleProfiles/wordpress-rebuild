---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const lastUpdated = "September 4, 2026";

const sections = [
  { id: "site-purpose", title: "About This Site" },
  { id: "privacy", title: "Privacy" },
  { id: "electronic-communications", title: "Electronic Communications" },
  { id: "your-account", title: "Your Account" },
  { id: "third-party-links", title: "Third-Party Links & Services" },
  { id: "intellectual-property", title: "Lawful Use & Intellectual Property" },
  { id: "communication-services", title: "Communication Services" },
  { id: "submissions", title: "Materials You Provide" },
  { id: "third-party-accounts", title: "Third-Party Accounts" },
  { id: "international-users", title: "International Users" },
  { id: "indemnification", title: "Indemnification" },
  { id: "liability-disclaimer", title: "Liability Disclaimer" },
  { id: "termination", title: "Termination & Governing Law" },
  { id: "changes", title: "Changes to These Terms" },
  { id: "contact", title: "Contact Us" }
];
---

<MainLayout
  title="Terms and Conditions | Zorakle"
  description="Read the terms and conditions governing your use of zorakle.net, including account responsibilities, intellectual property, and liability."
>
  <SiteHeader />

  <main>
    <!-- INTRO -->
    <section class="bg-white pt-14 pb-6 md:pt-20 md:pb-10">
      <div class="section-shell max-w-3xl">
        <p class="section-eyebrow">Legal</p>
        <h1 class="page-title mt-4">Terms and Conditions</h1>
        <p class="mt-5 text-base leading-relaxed text-[#3b3e47] md:text-lg">
          These terms govern your use of zorakle.net. Please read them carefully before using the
          Site.
        </p>
        <p class="mt-4 text-sm font-semibold uppercase tracking-widest text-[#56586a]">
          Last updated: {lastUpdated}
        </p>
      </div>
    </section>

    <!-- TERMS BODY -->
    <section class="bg-white pb-20 md:pb-28">
      <div class="section-shell">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,240px)_minmax(0,1fr)] lg:gap-16">
          <!-- TOC -->
          <aside class="hidden lg:block">
            <nav class="sticky top-10 max-h-[calc(100vh-5rem)] overflow-y-auto rounded-2xl border border-[#dedede] bg-[#f8f8f8] p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-[#56586a]">On this page</p>
              <ul class="mt-4 space-y-3 text-sm">
                {sections.map((s) => (
                  <li>
                    <a href={`#${s.id}`} class="text-[#3b3e47] transition hover:text-[#087f65]">{s.title}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>

          <!-- CONTENT -->
          <div class="policy-prose max-w-none">
            <p>
              Welcome to zorakle.net. The zorakle.net website (the "Site") is comprised of various
              web pages operated by Zorakle Profiles LLC ("Zorakle"). Zorakle.net is offered to you
              conditioned on your acceptance without modification of the terms, conditions, and
              notices contained here (the "Terms"). Your use of zorakle.net constitutes your
              agreement to all such Terms.
            </p>
            <p class="policy-callout">
              Please read these Terms carefully, and keep a copy of them for your reference.
            </p>

            <h2 id="site-purpose">About This Site</h2>
            <p>
              The purpose of zorakle.net is to provide information and the opportunity for users to
              take an assessment.
            </p>

            <h2 id="privacy">Privacy</h2>
            <p>
              Your use of zorakle.net is subject to Zorakle's <a href="/privacy-policy">Privacy Policy</a>.
              Please review our Privacy Policy, which also governs the Site and informs users of our
              data collection practices.
            </p>

            <h2 id="electronic-communications">Electronic Communications</h2>
            <p>
              Visiting zorakle.net or sending emails to Zorakle constitutes electronic
              communications. You consent to receive electronic communications, and you agree that
              all agreements, notices, disclosures, and other communications we provide to you
              electronically — via email and on the Site — satisfy any legal requirement that such
              communications be in writing.
            </p>

            <h2 id="your-account">Your Account</h2>
            <p>
              If you use this Site, you are responsible for maintaining the confidentiality of your
              account and password and for restricting access to your computer, and you agree to
              accept responsibility for all activities that occur under your account or password. You
              may not assign or otherwise transfer your account to any other person or entity. You
              acknowledge that Zorakle is not responsible for third-party access to your account that
              results from theft or misappropriation of your account. Zorakle and its associates
              reserve the right to refuse or cancel service, terminate accounts, or remove or edit
              content in our sole discretion.
            </p>
            <p>
              Zorakle does not knowingly collect, either online or offline, personal information from
              persons under the age of thirteen. If you are under 18, you may use zorakle.net only
              with the permission of a parent or guardian.
            </p>

            <h2 id="third-party-links">Links to Third-Party Sites & Services</h2>
            <p>
