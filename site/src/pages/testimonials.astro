---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { testimonials } from "../data/site-content";
---

<MainLayout
  title="Testimonials | Zorakle"
  description="Read all broker and franchisor testimonials about using Zorakle to make better franchise decisions."
>
  <SiteHeader />

  <main class="bg-white py-16 md:py-20">
    <section class="section-shell">
      <p class="section-eyebrow">Testimonials</p>
      <h1 class="page-title max-w-4xl">What brokers and franchisors are saying.</h1>
      <p class="mt-4 text-base text-[#56586a]">All testimonials in one place.</p>

      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {testimonials.map((item) => (
          <TestimonialCard
            name={item.name}
            company={item.company}
            type={item.type}
            quote={item.quote}
          />
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>
