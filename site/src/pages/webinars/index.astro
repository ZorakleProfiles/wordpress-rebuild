---
import BlogList from "../../components/BlogList.astro";
import { getPaginatedPostsByCategory } from "../../lib/blog.ts";

const WEBINARS_ARCHIVE_PAGE_SIZE = 10;
const pageData = await getPaginatedPostsByCategory("webinars & training", 1, WEBINARS_ARCHIVE_PAGE_SIZE);
---

<BlogList
        title="Franchise Webinars & Training | Zorakle"
        description="On-demand webinars on franchisee selection, assessment science, and franchise development from the Zorakle team."
        heading="Webinars"
        emptyStateMessage="No webinar posts were found."
        basePath="/webinars"
        postBasePath=""
        posts={pageData.posts}
        currentPage={pageData.page}
        totalPages={pageData.totalPages}
        ctaTitle="Keep learning. Start predicting."
        ctaText="Bring what you have learned into your franchise strategy with data-driven tools that reveal alignment, potential, and performance."
/>
