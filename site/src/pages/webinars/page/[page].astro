---
import BlogList from "../../../components/BlogList.astro";
import {
  getArchivePaginationPaths,
  type PaginatedPosts
} from "../../../lib/blog.ts";

export async function getStaticPaths() {
  // Astro isolates getStaticPaths into its own module scope during
  // prerendering, so the page size must be defined inside it, not above.
  const webinarsArchivePageSize = 10;
  return getArchivePaginationPaths("webinars & training", webinarsArchivePageSize);
}

interface Props {
  pageData: PaginatedPosts;
}

const { pageData } = Astro.props;
const pageTitle = `Franchise Webinars & Training - Page ${pageData.page} | Zorakle`;
---

<BlogList
  title={pageTitle}
  description="On-demand webinars on franchisee selection, assessment science, and franchise development from the Zorakle team."
  heading="Webinars"
  emptyStateMessage="No webinar posts were found."
  basePath="/webinars"
  postBasePath=""
  posts={pageData.posts}
  currentPage={pageData.page}
  totalPages={pageData.totalPages}
  ctaTitle="Keep learning. Start predicting."
  ctaText="Bring what you have learned into your franchise strategy with data-driven tools that reveal alignment, potential, and performance."
/>
