{
  "name": "zorakle-blog",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "import:wordpress": "node ./scripts/import-wordpress-posts.mjs --write",
    "import:wordpress:dry": "node ./scripts/import-wordpress-posts.mjs",
    "start": "sanity start",
    "schemas:deploy": "sanity schemas deploy",
    "typegen": "sanity schemas extract --force && sanity typegen generate"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@portabletext/block-tools": "^3.0.0",
    "@sanity/client": "^7.11.2",
    "@sanity/schema": "^4.12.0",
    "@sanity/vision": "^6.9.1",
    "jsdom": "^26.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.9.1",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
